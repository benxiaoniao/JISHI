# 基石标准库 · 参数（**用基石自己写的库**）
#
# 约定与判据见 `统计.jsh` 的模块头与 `docs/设计决策.md` D45。本模块特有的四点：
#
#   ① **不要手写外壳函数**：`jishilib` 会自动把整个文件包成 `函数 __基石库_参数__()`。
#      所以这里就是普通的模块顶层 —— 顶层的 `令` 就是外壳函数的局部变量，
#      各函数通过**闭包**访问它。于是 `_解析器表` 天然是「每次 `导入` 一份新状态」
#      （宿主层靠 `__基石新建__` 约定做到同一件事）。
#   ② **导出名可以是关键字**：`参数.新建` 里的 `新建` 是关键字（`新建 类()`），
#      写不成函数名。命名约定：**`__X` 导出为 `X`**，所以这里写 `函数 __新建(...)`。
#   ③ **报错类型是「运行期错误」**：对齐 Python 侧的 `RunError`（**不是**
#      `类型错误`）—— 对拍比类型。
#   ④ 句柄式 `解析(句柄, 参数们)` 与一次式 `解析(参数们, {选项: 默认})` 共用
#      同一套逐项解析，靠「第一个参数是不是整数」分流。

令 _解析器表 = []


函数 _取文本(v)：
    """值 → 文本。对齐 Python 侧的 `jishi_repr(v, top=True)`（也就是内建
    `文本()` 那套：空/真/假 是中文、文本不加引号、列表里元素带引号）。"""
    返回 文本(v)


函数 _取句柄(句柄)：
    如果 类型(句柄) != "整数"：
        抛出 运行期错误("这个值不是参数解析器（要用 参数.新建(...) 造一个）")
    如果 句柄 < 1 或 句柄 > 长度(_解析器表)：
        抛出 运行期错误("参数解析器已失效（是不是跨了脚本？解析器不能保存复用）")
    返回 _解析器表[句柄 - 1]


函数 _报解析错误()：
    抛出 运行期错误("「参数.解析」要一个参数列表，"
        + "通常写 参数.解析(解析器, 系统.参数())")


函数 _取序列(数据)：
    如果 类型(数据) == "文本"：
        _报解析错误()
    令 出 = []
    尝试：
        遍历 项 在 数据：
            出.追加(项)
    捕获 类型错误 为 _e：
        _报解析错误()
    返回 出


函数 _未知选项(选项表, 名)：
    令 已知名 = ""
    遍历 o 在 选项表：
        如果 已知名 != ""：
            已知名 = 已知名 + "、"
        已知名 = 已知名 + "--" + o["名"]
    如果 已知名 == ""：
        已知名 = "（没有）"
    返回 ("不认识选项「--" + 名 + "」。已声明的有：" + 已知名 + "\n"
        + "（敲错了？跑 `--帮助` 看用法）")


函数 _找选项(选项表, 名)：
    """按名字找已声明的选项；没有返回 空。"""
    遍历 o 在 选项表：
        如果 o["名"] == 名：
            返回 o
    返回 空


函数 _逐项解析(选项表, 参数们)：
    令 列表 = _取序列(参数们)
    令 结果 = {}
    遍历 o 在 选项表：
        结果[o["名"]] = o["默认"]
    令 位置 = []
    令 命令 = ""
    令 i = 0
    当 i < 长度(列表)：
        令 项 = 列表[i]
        令 文 = 项
        如果 类型(项) != "文本"：
            文 = _取文本(项)
        如果 文 == "--"：
            # 「之后全是位置参数」—— `中断` 跳出当循环
            令 k = i + 1
            当 k < 长度(列表)：
                位置.追加(列表[k])
                k = k + 1
            中断
        如果 文.开头是("--")：
            令 体 = 文[2:长度(文)]
            令 等号 = _找等号(体)
            如果 等号 >= 0：
                # --名=值
                令 名 = 体[0:等号]
                令 值 = 体[等号 + 1:长度(体)]
                令 o = _找选项(选项表, 名)
                如果 o == 空：
                    抛出 运行期错误(_未知选项(选项表, 名))
                如果 o["是标志"]：
                    抛出 运行期错误("「--" + 名 + "」是个开关，不该给值")
                结果[名] = 值
                i = i + 1
                继续
            令 o2 = _找选项(选项表, 体)
            如果 o2 == 空：
                抛出 运行期错误(_未知选项(选项表, 体))
            如果 o2["是标志"]：
                结果[体] = 真
                i = i + 1
                继续
            如果 i + 1 >= 长度(列表)：
                抛出 运行期错误("「--" + 体 + "」后面要跟一个值")
            结果[体] = 列表[i + 1]
            i = i + 2
            继续
        如果 命令 == "" 与 长度(位置) == 0：
            命令 = 文
        否则：
            位置.追加(项)
        i = i + 1
    结果["命令"] = 命令
    结果["位置"] = 位置
    返回 结果


函数 __新建(名字, 说明 = "")：
    """新建一个参数解析器，返回它的**句柄**（后面所有调用都带着它）。"""
    _解析器表.追加({"名字": 文本(名字), "说明": 文本(说明), "选项表": []})
    返回 长度(_解析器表)


函数 选项(句柄, 名, 默认 = 空, 说明 = "")：
    """给解析器声明一个取值选项：`--名 值`（也接受 `--名=值`）。"""
    令 p = _取句柄(句柄)
    p["选项表"].追加({"名": 文本(名), "默认": 默认,
        "说明": 文本(说明), "是标志": 假})
    返回 句柄


函数 标志(句柄, 名, 说明 = "")：
    """给解析器声明一个开关：写 `--名` 就是真，不写就是假。"""
    令 p = _取句柄(句柄)
    p["选项表"].追加({"名": 文本(名), "默认": 假,
        "说明": 文本(说明), "是标志": 真})
    返回 句柄


函数 _找等号(文):
    """找第一个 `=` 的下标，没有返回 -1。

    ⚠️ **不用 `文本.查找`**：Rust 宿主没实现那个方法
    （`tests/test_m52_jishilib.py` 的 `RUST_GAPS` 记了这条）。库代码要走五个引擎，
    能用最基础的语法就别依赖宿主的方法表 —— 这也顺带让「方法漂移」影响不到这里。
    """
    令 i = 0
    当 i < 长度(文):
        如果 文[i] == "="：
            返回 i
        i = i + 1
    返回 -1


函数 _补到(文, 宽)：
    """左对齐补空格到 `宽`（对齐 Python 的 `f"{x:<10}"`）。"""
    令 出 = 文
    当 长度(出) < 宽：
        出 = 出 + " "
    返回 出


函数 用法(句柄)：
    """生成用法说明（自动包含已声明的选项）。"""
    令 p = _取句柄(句柄)
    令 行 = ["用法：" + p["名字"] + " [命令] [选项]"]
    如果 p["说明"] != ""：
        行.追加("  " + p["说明"])
    如果 长度(p["选项表"]) > 0：
        行.追加("选项：")
        遍历 o 在 p["选项表"]：
            如果 o["是标志"]：
                行.追加("  --" + _补到(o["名"], 10) + " " + o["说明"])
            否则：
                行.追加("  --" + o["名"] + " <值>     " + o["说明"]
                    + "（默认 " + _取文本(o["默认"]) + "）")
    令 出 = ""
    令 首 = 真
    遍历 一 在 行：
        如果 非 首：
            出 = 出 + "\n"
        出 = 出 + 一
        首 = 假
    返回 出


函数 _一次式(参数们, 声明)：
    如果 类型(声明) != "字典"：
        抛出 运行期错误("「参数.解析」的第二个参数要是字典"
            + "（选项名 → 默认值）")
    令 表 = []
    遍历 名 在 声明：
        令 默认 = 声明[名]
        如果 类型(默认) == "布尔"：
            表.追加({"名": 文本(名), "默认": 假, "说明": "", "是标志": 真})
        否则：
            表.追加({"名": 文本(名), "默认": 默认, "说明": "", "是标志": 假})
    返回 _逐项解析(表, 参数们)


函数 解析(句柄, 参数们 = 空)：
    """解析参数列表，返回 `{命令, 位置, 各选项…}`。

    两种用法：`参数.解析(句柄, 系统.参数())`（句柄式）或
    `参数.解析(系统.参数(), {"数据": "默认.json"})`（一次式 —— 第一个参数
    是可迭代、不是句柄）。认不出来就**报错**，不静默忽略。
    """
    如果 参数们 == 空：
        抛出 运行期错误("「参数.解析」还要一个参数列表，"
            + "通常写 参数.解析(解析器, 系统.参数())")
    如果 类型(句柄) != "整数"：
        返回 _一次式(句柄, 参数们)
    令 p = _取句柄(句柄)
    返回 _逐项解析(p["选项表"], 参数们)
