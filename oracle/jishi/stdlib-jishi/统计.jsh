# 基石标准库 · 统计（**用基石自己写的库**）
#
# 为什么有这么一层（M52）：
#   以前标准库要**用三种语言各写一遍**（Python / JS / Rust）——`统计` 这类纯逻辑
#   模块，同一套算法维护三份，改一处得改三处，还容易悄悄漂移。从这里开始，
#   纯逻辑模块**只写一遍**（就是本文件），编译成字节码后**五个引擎共用**
#   （树遍历 / Python VM / C VM / Node / Rust）。
#
# 加载规则：`导入 统计` 时**先查这一层**，这里没有再回落到宿主层
#   （`jishi/stdlib/*.py` 与两个宿主各自的标准库）。所以迁移是渐进的，
#   搬一个模块就少一份重复，宿主层随时还在兜底。
#
# ⚠️ 写这个目录的模块要守三条：
#   ① 引别的模块一律写成 `导入 X 为 _X` —— 导出时会**排除下划线开头的名字**，
#      否则 `统计.数学` 这种内部依赖会漏到用户面前。
#   ② 报错**类型**要与 Python 侧一致（`类型错误` / `值错误`），对拍测试比类型；
#      文案允许略有出入（如实记在文档里）。
#   ③ **热路径别放这里**：走字节码比宿主原语慢（M52 实测见 `docs/设计决策.md`）。

导入 数学 为 _数学


函数 _取数字表(数据, 名字)：
    """把输入统一成数字列表；不是数字就给中文错（与 Python 侧 `_nums` 同口径）。

    `尝试` 只包住「能不能遍历」这一件事——元素检查放在外面，否则自己抛的
    「第 N 个不是数字」会被自己的 `捕获 类型错误` 吃成「要传一组数字（列表）」。
    """
    如果 类型(数据) == "文本"：
        抛出 类型错误("「" + 名字 + "」要传一组数字，不能传文本")
    令 原始 = []
    尝试：
        遍历 项 在 数据：
            原始.追加(项)
    捕获 类型错误 为 _e：
        抛出 类型错误("「" + 名字 + "」要传一组数字（列表）")
    令 序 = []
    令 位次 = 0
    遍历 项 在 原始：
        位次 = 位次 + 1
        令 t = 类型(项)
        如果 t == "整数" 或 t == "小数"：
            序.追加(项)
        否则：
            抛出 类型错误("「" + 名字 + "」里第 " + 文本(位次) + " 个不是数字：" + 文本(项))
    返回 序


函数 _要非空(序, 名字)：
    如果 长度(序) == 0：
        抛出 值错误("「" + 名字 + "」要至少有一个数字，现在是空的")
    返回 序


函数 _升序(数据, 名字)：
    令 序 = _要非空(_取数字表(数据, 名字), 名字)
    序.排序()
    返回 序


函数 求和(数据)：
    """返回所有数字的和（空列表返回 0）。"""
    令 序 = _取数字表(数据, "求和")
    如果 长度(序) == 0：
        返回 0
    令 总 = 0
    遍历 x 在 序：
        总 = 总 + x
    返回 总


函数 平均(数据)：
    """返回算术平均数。"""
    令 序 = _要非空(_取数字表(数据, "平均"), "平均")
    令 总 = 0
    遍历 x 在 序：
        总 = 总 + x
    返回 总 / 长度(序)


函数 中位数(数据)：
    """返回中位数（偶数个时取中间两个的平均）。"""
    令 序 = _升序(数据, "中位数")
    令 n = 长度(序)
    令 中 = n // 2
    如果 n % 2 == 1：
        返回 序[中]
    返回 (序[中 - 1] + 序[中]) / 2


函数 众数(数据)：
    """返回出现次数最多的值；并列最多时取**最先出现**的那个（结果可复现）。"""
    令 序 = _要非空(_取数字表(数据, "众数"), "众数")
    令 计数 = {}
    令 次序 = []
    遍历 v 在 序：
        如果 v 不在 计数：
            计数[v] = 0
            次序.追加(v)
        计数[v] = 计数[v] + 1
    令 最好 = 次序[0]
    令 最好数 = 计数[次序[0]]
    遍历 v 在 次序：
        如果 计数[v] > 最好数：
            最好 = v
            最好数 = 计数[v]
    返回 最好


函数 方差(数据, 样本 = 假)：
    """返回方差（默认**总体方差**；`样本=真` 时除以 n-1）。"""
    令 序 = _要非空(_取数字表(数据, "方差"), "方差")
    令 n = 长度(序)
    如果 样本 与 n < 2：
        抛出 值错误("样本方差至少要 2 个数（要除以 n-1）")
    令 总 = 0
    遍历 x 在 序：
        总 = 总 + x
    令 均 = 总 / n
    令 平方和 = 0
    遍历 x 在 序：
        平方和 = 平方和 + (x - 均) * (x - 均)
    如果 样本：
        返回 平方和 / (n - 1)
    返回 平方和 / n


函数 标准差(数据, 样本 = 假)：
    """返回标准差（方差的开方）。"""
    返回 _数学.开方(方差(数据, 样本))


函数 极差(数据)：
    """返回最大值与最小值的差。"""
    令 序 = _要非空(_取数字表(数据, "极差"), "极差")
    返回 最大(序) - 最小(序)


函数 分位数(数据, p)：
    """返回第 p 分位数（p 取 0–1）；用**线性插值**，与多数统计软件一致。"""
    令 tp = 类型(p)
    如果 tp != "整数" 与 tp != "小数"：
        抛出 类型错误("「分位数」的第二个参数要传 0 到 1 之间的小数")
    如果 p < 0 或 p > 1：
        抛出 值错误("分位数要在 0 到 1 之间，现在是 " + 文本(p))
    令 序 = _升序(数据, "分位数")
    如果 长度(序) == 1：
        返回 序[0]
    令 位置 = p * (长度(序) - 1)
    令 下 = _数学.向下取整(位置)
    令 上 = _数学.向上取整(位置)
    如果 下 == 上：
        返回 序[下]
    返回 序[下] + (序[上] - 序[下]) * (位置 - 下)


函数 去极值平均(数据, 去掉个数 = 1)：
    """去掉最大和最小的各「去掉个数」个之后求平均（比赛评分常用）。"""
    如果 类型(去掉个数) != "整数"：
        抛出 类型错误("「去掉个数」要传整数")
    如果 去掉个数 < 0：
        抛出 值错误("「去掉个数」不能是负数")
    令 序 = _升序(数据, "去极值平均")
    如果 去掉个数 * 2 >= 长度(序)：
        抛出 值错误("去掉 " + 文本(去掉个数) + " 个最高和最低之后就没数据了（一共 "
             + 文本(长度(序)) + " 个）")
    令 保留 = 序[去掉个数:长度(序) - 去掉个数]
    令 总 = 0
    遍历 x 在 保留：
        总 = 总 + x
    返回 总 / 长度(保留)


函数 加权平均(数据, 权重)：
    """返回加权平均数：每个数乘自己的权重再求和，除以权重之和。"""
    令 序 = _要非空(_取数字表(数据, "加权平均"), "加权平均")
    令 重 = _取数字表(权重, "加权平均的权重")
    如果 长度(序) != 长度(重)：
        抛出 值错误("数据和权重的个数不一样：" + 文本(长度(序)) + " 个数据、"
             + 文本(长度(重)) + " 个权重")
    令 重和 = 0
    遍历 w 在 重：
        重和 = 重和 + w
    如果 重和 == 0：
        抛出 值错误("权重之和是 0，没法算加权平均")
    令 积 = 0
    令 i = 0
    当 i < 长度(序)：
        积 = 积 + 序[i] * 重[i]
        i = i + 1
    返回 积 / 重和


# ---------------------------------------------------------------------------
# M192：相关 / 回归 / 标准化 / 移动平均 / 直方图 / 秩 / 百分位 / 协方差
# ---------------------------------------------------------------------------
#
# 与 `jishi/stdlib/统计.py`（宿主兜底那份）逐句对齐：同样的算法、同样的报错类型。
# ⚠️ 运算顺序也要一致 —— 浮点加法不满足结合律，换个顺序末位就会差。

函数 _两列(甲, 乙, 名字)：
    """两个序列必须一样长、且至少 2 组。"""
    令 xs = _取数字表(甲, 名字)
    令 ys = _取数字表(乙, 名字)
    如果 长度(xs) != 长度(ys)：
        抛出 值错误("「" + 名字 + "」两组数据的个数不一样："
            + 文本(长度(xs)) + " 和 " + 文本(长度(ys)))
    如果 长度(xs) < 2：
        抛出 值错误("「" + 名字 + "」至少要 2 组数据")
    返回 [xs, ys]


函数 _均值(序)：
    令 总 = 0
    遍历 x 在 序：
        总 = 总 + x
    返回 总 / 长度(序)


函数 协方差(甲, 乙, 样本 = 假)：
    """返回两组数的协方差（默认总体；`样本=真` 时除以 n-1）。"""
    令 两 = _两列(甲, 乙, "协方差")
    令 xs = 两[0]
    令 ys = 两[1]
    令 n = 长度(xs)
    令 mx = _均值(xs)
    令 my = _均值(ys)
    令 和 = 0.0
    令 i = 0
    当 i < n：
        和 = 和 + (xs[i] - mx) * (ys[i] - my)
        i = i + 1
    如果 样本：
        返回 和 / (n - 1)
    返回 和 / n


函数 秩(数据)：
    """返回每个数的名次（从小到大，1 开始），并列取平均名次。

    例：`[10, 20, 20, 30]` → `[1, 2.5, 2.5, 4]`。
    """
    令 序 = _取数字表(数据, "秩")
    如果 长度(序) == 0：
        抛出 值错误("「秩」要至少有一个数字，现在是空的")
    令 值们 = []
    令 位置 = {}
    令 i = 0
    当 i < 长度(序)：
        令 v = 序[i]
        如果 v 不在 位置：
            位置[v] = []
            值们.追加(v)
        位置[v].追加(i)
        i = i + 1
    值们.排序()
    令 出 = []
    i = 0
    当 i < 长度(序)：
        出.追加(0.0)
        i = i + 1
    令 已用 = 0
    遍历 v 在 值们：
        令 位们 = 位置[v]
        令 平均 = (已用 + 1 + 已用 + 长度(位们)) / 2
        遍历 p 在 位们：
            出[p] = 平均
        已用 = 已用 + 长度(位们)
    返回 出


函数 相关系数(甲, 乙, 方法 = "皮尔逊")：
    """返回相关系数（-1 到 1）。`方法` 认「皮尔逊」/「斯皮尔曼」。"""
    令 名 = 文本(方法)
    如果 名 != "皮尔逊" 与 名 != "斯皮尔曼"：
        抛出 类型错误("「相关系数」不认识的方法「" + 名
            + "」—— 只能是：皮尔逊 / 斯皮尔曼")
    令 两 = _两列(甲, 乙, "相关系数")
    令 xs = 两[0]
    令 ys = 两[1]
    如果 名 == "斯皮尔曼"：
        xs = 秩(xs)
        ys = 秩(ys)
    令 mx = _均值(xs)
    令 my = _均值(ys)
    令 n = 长度(xs)
    令 sxy = 0.0
    令 sxx = 0.0
    令 syy = 0.0
    令 i = 0
    当 i < n：
        令 dx = xs[i] - mx
        令 dy = ys[i] - my
        sxy = sxy + dx * dy
        sxx = sxx + dx * dx
        syy = syy + dy * dy
        i = i + 1
    如果 sxx == 0 或 syy == 0：
        抛出 值错误("「相关系数」算不出来：有一组数据的值全都一样（标准差是 0）")
    返回 sxy / _数学.开方(sxx * syy)


函数 线性回归(甲, 乙)：
    """最小二乘拟合 `乙 ≈ 斜率 × 甲 + 截距`，返回 斜率/截距/R方/残差。"""
    令 两 = _两列(甲, 乙, "线性回归")
    令 xs = 两[0]
    令 ys = 两[1]
    令 n = 长度(xs)
    令 mx = _均值(xs)
    令 my = _均值(ys)
    令 sxy = 0.0
    令 sxx = 0.0
    令 i = 0
    当 i < n：
        令 dx = xs[i] - mx
        sxy = sxy + dx * (ys[i] - my)
        sxx = sxx + dx * dx
        i = i + 1
    如果 sxx == 0：
        抛出 值错误("「线性回归」算不出来：甲那组数据全都一样，拟合不出直线")
    令 斜率 = sxy / sxx
    令 截距 = my - 斜率 * mx
    令 残差 = []
    i = 0
    当 i < n：
        残差.追加(ys[i] - (斜率 * xs[i] + 截距))
        i = i + 1
    令 ss总 = 0.0
    令 ss残 = 0.0
    i = 0
    当 i < n：
        令 d = ys[i] - my
        ss总 = ss总 + d * d
        ss残 = ss残 + 残差[i] * 残差[i]
        i = i + 1
    令 r方 = 1.0
    如果 ss总 != 0：
        r方 = 1 - ss残 / ss总
    返回 {"斜率": 斜率, "截距": 截距, "R方": r方, "残差": 残差}


函数 标准化(数据)：
    """返回 z 分数（减均值、除以总体标准差）。"""
    令 序 = _要非空(_取数字表(数据, "标准化"), "标准化")
    令 n = 长度(序)
    令 m = _均值(序)
    令 平方和 = 0.0
    遍历 x 在 序：
        令 d = x - m
        平方和 = 平方和 + d * d
    令 sd = _数学.开方(平方和 / n)
    如果 sd == 0：
        抛出 值错误("「标准化」算不出来：这组数据的值全都一样（标准差是 0）")
    令 出 = []
    遍历 x 在 序：
        出.追加((x - m) / sd)
    返回 出


函数 移动平均(数据, 窗口 = 3)：
    """返回移动平均；输出长度是 `n - 窗口 + 1`。"""
    如果 类型(窗口) != "整数"：
        抛出 类型错误("「移动平均」的窗口要传整数")
    如果 窗口 < 1：
        抛出 值错误("「移动平均」的窗口至少是 1")
    令 序 = _要非空(_取数字表(数据, "移动平均"), "移动平均")
    如果 窗口 > 长度(序)：
        抛出 值错误("「移动平均」的窗口是 " + 文本(窗口)
            + "，但一共只有 " + 文本(长度(序)) + " 个数")
    令 出 = []
    令 和 = 0.0
    令 i = 0
    当 i < 长度(序)：
        和 = 和 + 序[i]
        如果 i >= 窗口：
            和 = 和 - 序[i - 窗口]
        如果 i >= 窗口 - 1：
            出.追加(和 / 窗口)
        i = i + 1
    返回 出


函数 直方图(数据, 箱数 = 10)：
    """分箱计数，返回 `{"边界": [...], "计数": [...]}`。"""
    如果 类型(箱数) != "整数"：
        抛出 类型错误("「直方图」的箱数要传整数")
    如果 箱数 < 1：
        抛出 值错误("「直方图」的箱数至少是 1")
    令 序 = _要非空(_取数字表(数据, "直方图"), "直方图")
    令 小 = 序[0]
    令 大 = 序[0]
    遍历 x 在 序：
        如果 x < 小：
            小 = x
        如果 x > 大：
            大 = x
    如果 小 == 大：
        返回 {"边界": [小, 大], "计数": [长度(序)]}
    令 宽 = (大 - 小) / 箱数
    令 边界 = []
    令 i = 0
    当 i < 箱数：
        边界.追加(小 + 宽 * i)
        i = i + 1
    边界.追加(大)
    令 计数 = []
    i = 0
    当 i < 箱数：
        计数.追加(0)
        i = i + 1
    遍历 x 在 序：
        令 k = 整数((x - 小) / 宽)
        如果 k >= 箱数：
            k = 箱数 - 1
        如果 k < 0：
            k = 0
        计数[k] = 计数[k] + 1
    返回 {"边界": 边界, "计数": 计数}


函数 百分位排名(数据, 值)：
    """返回「有多少比例的数 ≤ 值」（0–1）。"""
    令 序 = _取数字表(数据, "百分位排名")
    如果 长度(序) == 0：
        抛出 值错误("「百分位排名」要至少有一个数字，现在是空的")
    令 t = 类型(值)
    如果 t != "整数" 与 t != "小数"：
        抛出 类型错误("「百分位排名」的第二个参数要传一个数字")
    令 不高于 = 0
    遍历 x 在 序：
        如果 x <= 值：
            不高于 = 不高于 + 1
    返回 不高于 / 长度(序)
