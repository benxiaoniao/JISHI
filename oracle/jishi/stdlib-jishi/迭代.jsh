# 基石标准库 · 迭代（**用基石自己写的库**）
#
# 约定与判据见 `统计.jsh` 的模块头与 `docs/设计决策.md` D45。本模块特有的三点：
#
#   ① **热路径用内建**：`求和` 直接转发给内建 `总和` —— 这是「性能分层」的
#      第一例。库代码走字节码比宿主慢 25–38 倍（D45 实测），被高频调用的函数
#      尤其经不起。⚠️ 代价：错误文案变成内建那套（类型仍一致，对拍只比类型）。
#   ② `去重` 要处理**不可哈希**的元素（列表/字典）：Python 侧回退到 `repr`，
#      这边回退到 `文本(项)`。结果不依赖键怎么表示，只要同一份元素给出同一个键。
#   ③ 「一段不可迭代就原样留下」这类判断，**别用 `空` 当哨兵**（空列表也是
#      「可迭代」，会误判）；用一个真假标记显式记下来。

导入 数学 为 _数学


函数 _取序列(数据, 名字)：
    """摊平成列表；不能遍历就报中文类型错误（对齐 Python 侧 `_as_iterable`）。"""
    令 出 = []
    尝试：
        遍历 项 在 数据：
            出.追加(项)
    捕获 类型错误 为 _e：
        抛出 类型错误("「" + 文本(数据) + "」不能当「" + 名字 + "」的内容用")
    返回 出


函数 _切片(全部, 起, 止)：
    """`全部[起:止]`（左闭右开、越界收敛、返回**新列表**）。"""
    令 出 = []
    令 i = 起
    如果 i < 0：
        i = 0
    当 i < 止 与 i < 长度(全部)：
        出.追加(全部[i])
        i = i + 1
    返回 出


函数 _非负(值, 名字)：
    令 n = 整数(值)
    如果 n < 0:
        n = 0
    返回 n


函数 分组(可迭代, 每组个数)：
    """按固定大小分组：`迭代.分组(范围(7), 3)` → `[[0,1,2], [3,4,5], [6]]`。"""
    令 n = 整数(每组个数)
    如果 n <= 0：
        抛出 类型错误("「分组」的每组个数要大于 0，得到了 " + 文本(每组个数))
    令 全部 = _取序列(可迭代, "分组")
    令 出 = []
    令 i = 0
    当 i < 长度(全部)：
        止 = i + n
        如果 止 > 长度(全部)：
            止 = 长度(全部)
        出.追加(_切片(全部, i, 止))
        i = i + n
    返回 出


函数 滑窗(可迭代, 窗口大小, 步长 = 1)：
    """滑动窗口；凑不满一个窗口的尾巴丢掉（与 Python 的 itertools 同约定）。"""
    令 n = 整数(窗口大小)
    令 s = 整数(步长)
    如果 n <= 0：
        抛出 类型错误("「滑窗」的窗口大小要大于 0，得到了 " + 文本(窗口大小))
    如果 s <= 0：
        抛出 类型错误("「滑窗」的步长要大于 0，得到了 " + 文本(步长))
    令 全部 = _取序列(可迭代, "滑窗")
    令 出 = []
    令 i = 0
    当 i + n <= 长度(全部)：
        出.追加(_切片(全部, i, i + n))
        i = i + s
    返回 出


函数 去重(可迭代)：
    """按**首次出现的顺序**去重（要集合类型就用内建 `集合()`）。"""
    令 出 = []
    令 见过 = 集合()
    遍历 项 在 _取序列(可迭代, "去重")：
        # 列表/字典这类元素进不了集合 → 退化成用它的显示文本当键。
        令 键 = 项
        如果 类型(项) == "列表" 或 类型(项) == "字典"：
            键 = 文本(项)
        如果 键 在 见过：
            继续
        见过.添加(键)
        出.追加(项)
    返回 出


函数 展开(嵌套)：
    """把「列表的列表」摊平**一层**（多层要自己套几遍，免得摊过头）。"""
    令 出 = []
    遍历 段 在 _取序列(嵌套, "展开")：
        令 子 = []
        令 可摊平 = 假
        尝试：
            遍历 x 在 段：
                子.追加(x)
            可摊平 = 真
        捕获 类型错误 为 _e：
            可摊平 = 假
        如果 可摊平：
            遍历 x 在 子：
                出.追加(x)
        否则：
            出.追加(段)
    返回 出


函数 取前(可迭代, 个数)：
    """取前 `个数` 个元素（不足就给全部）。"""
    令 全部 = _取序列(可迭代, "取前")
    令 n = _非负(个数, "取前")
    如果 n > 长度(全部)：
        n = 长度(全部)
    返回 _切片(全部, 0, n)


函数 取后(可迭代, 个数)：
    """取后 `个数` 个元素（不足就给全部）。"""
    令 全部 = _取序列(可迭代, "取后")
    令 n = _非负(个数, "取后")
    如果 n > 长度(全部)：
        n = 长度(全部)
    返回 _切片(全部, 长度(全部) - n, 长度(全部))


函数 求和(可迭代)：
    """求和。**转发给内建 `总和`** —— 热路径不进字节码层（见模块头 ①）。"""
    返回 总和(可迭代)


函数 计数(可迭代, 条件)：
    """数一数有多少元素满足条件（条件是「元素 → 真/假」的函数）。"""
    令 个数 = 0
    遍历 项 在 _取序列(可迭代, "计数")：
        如果 条件(项)：
            个数 = 个数 + 1
    返回 个数


函数 累积(可迭代, 初值 = 0)：
    """前缀和：`迭代.累积([1,2,3])` → `[1,3,6]`（`初值` 参与第一次累加）。"""
    令 出 = []
    令 累计 = 初值
    遍历 x 在 _取序列(可迭代, "累积")：
        累计 = 累计 + x
        出.追加(累计)
    返回 出


函数 组合(可迭代, 取几个)：
    """挑 `取几个` 个（不计顺序），返回所有组合（顺序同 itertools.combinations）。"""
    令 全部 = _取序列(可迭代, "组合")
    令 n = 整数(取几个)
    如果 n < 0：
        抛出 类型错误("「组合」要取的个数不能是负数，得到了 " + 文本(取几个))
    如果 n > 长度(全部)：
        返回 []
    令 出 = []
    令 当前 = []
    # ⚠️ 函数名别用 `从` —— 它是关键字（`导入 X 从 Y`），解析器会报
    # 「这里需要一个函数名」。同理要避开的关键字还有 `在`/`为`/`与`/`非`…
    函数 挑选(起)：
        如果 长度(当前) == n：
            出.追加(_切片(当前, 0, 长度(当前)))     # 拷一份再收
            返回
        令 k = 起
        当 k < 长度(全部)：
            当前.追加(全部[k])
            挑选(k + 1)
            当前.弹出()
            k = k + 1
    挑选(0)
    返回 出


函数 排列(可迭代, 取几个 = -1)：
    """挑 `取几个` 个并计顺序；不给 `取几个` 就是全排列。"""
    令 全部 = _取序列(可迭代, "排列")
    令 全部数 = 长度(全部)
    令 n = 取几个
    如果 n == -1：
        n = 全部数
    否则：
        n = 整数(取几个)
    如果 n < 0：
        抛出 类型错误("「排列」要取的个数不能是负数，得到了 " + 文本(取几个))
    如果 n > 全部数：
        返回 []
    令 出 = []
    令 用过 = []
    令 i = 0
    当 i < 全部数：
        用过.追加(假)
        i = i + 1
    令 当前 = []
    函数 走():
        如果 长度(当前) == n：
            出.追加(_切片(当前, 0, 长度(当前)))
            返回
        令 k = 0
        当 k < 全部数：
            如果 用过[k] == 假：
                用过[k] = 真
                当前.追加(全部[k])
                走()
                当前.弹出()
                用过[k] = 假
            k = k + 1
    走()
    返回 出


函数 笛卡尔积(*序列)：
    """多个序列的笛卡尔积（每个序列里各取一个，所有搭配）。"""
    如果 长度(序列) == 0：
        返回 []
    令 表 = []
    令 i = 0
    遍历 序 在 序列：
        令 取到 = []
        令 能取 = 假
        尝试：
            遍历 x 在 序：
                取到.追加(x)
            能取 = 真
        捕获 类型错误 为 _e：
            能取 = 假
        如果 能取 == 假：
            抛出 类型错误("「" + 文本(序) + "」不能当「笛卡尔积」第 "
                + 文本(i + 1) + " 个序列用")
        如果 长度(取到) == 0：
            返回 []
        表.追加(取到)
        i = i + 1
    令 行 = [[]]
    遍历 一列 在 表：
        令 下一批 = []
        遍历 前缀 在 行：
            遍历 x 在 一列：
                令 新行 = []
                遍历 y 在 前缀：
                    新行.追加(y)
                新行.追加(x)
                下一批.追加(新行)
        行 = 下一批
    返回 行
