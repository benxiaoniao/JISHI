# 基石标准库 · 数据库（**用基石自己写的库**，M202b）
#
# 以前这个模块是 `rusqlite`（Rust 原生，绑住 C 的 SQLite）。现在换成
# `基石数据库` 那个项目（<https://github.com/benxiaoniao/jishi-db>）的引擎：
# 纯基石实现，**本项目因此不再有第三方依赖**。
#
# ## 与 SQLite 那版的三个不同（都写进 CHANGELOG 与 `docs/设计决策.md` D115）
#
# ① **文件格式变了**：不再是 SQLite 文件，是「快照 + 追加日志」（首行
#    `#基石数据库 快照 格式=1`）。用 sqlite3 / DB Browser 打不开 —— 反过来也一样，
#    拿 SQLite 文件调 `打开` 会当场报「这是 SQLite 库，先用迁移工具转换」。
#    迁移工具：`jishi tools/迁移.jsh <SQLite库> <目标>`（jishi-db 仓库里的那份）。
# ② **性能形状不同**：点查（有索引的等值查询）更快，全表扫描与关闭紧凑慢一两个
#    数量级（字节码对 C）。数字见 CHANGELOG M202b 那张表，别猜。
# ③ **事务是真的有**：`开始` / `提交` / `回滚` / `用事务` 四个函数以前在 SQLite 那版
#    只是「转给 SQLite 的 BEGIN/COMMIT」，现在是引擎自己的日志起点 + 内存快照。
# ④ **M212 起「一个库 = 两个文件」**：`<路径>`（快照）+ `<路径>.log`（还没并进快照的
#    改动）。`关闭` **不再**整份重写快照（2 万行要 126 ms，只是把数据搬一遍家），
#    所以关完之后日志里可能还有东西 —— **删库要两个文件一起删**。
#    （只删 `.db` 也不会出乱子：`打开` 见到「没有快照却有日志」就把它当孤儿清掉。）
#
# ## 内部命名（改动这个文件前先看）
#
# 模块里 `_引擎_*` / `_存储器_*` / `_SQL子集_*` / `_值库_*` / `_索引_*` /
# `_条件_*` / `_排序_*` 全是内部实现：下划线开头 ⇒ **不导出**。对外只有文件末尾
# 那 21 个函数，名字与参数和内置那版逐字一致（用户感觉不到换了实现）。
#
# ## 每个导入都别删
#
# `json`（快照与日志）、`文件`（原子写 / 追加 / 按行读）、`标识`（锁文件属主）、
# `时间`（迁移记录跑的时间）、`文本`（拼接 / 小写）、`路径`（绝对路径 / 连接）、
# `编码`（字节编排）、`正则`（SQL 词法）、`表格`（`查询到表格`）。

导入 编码
导入 json
导入 文件
导入 标识
导入 时间
导入 文本 为 文本库
导入 正则
导入 路径
导入 表格

# ===== 原 值库.jsh =====
# 值库 —— 值的校验、归一化、编码、比较
# 兼容基准（设计.md §5.3/§5.4）：
#   可存类型：整数 / 小数 / 文本 / 字节 / 空 / 布尔（入库转整数）/ 精确小数（入库转小数）
#   列表 / 字典不能存：「X」这个值是「列表」，存不进数据库
#   类型序（SQLite 语义）：空 < 数字 < 文本 < 字节
#   文本比较按码点（基石的 < 不能比文本，这里手写）


# ---- 类型序常量 ----
_值库_空序 = 0
_值库_数序 = 1
_值库_文序 = 2
_值库_字节序 = 3

_值库_可存类型们 = ["整数", "小数", "文本", "字节", "空", "布尔", "精确小数"]

# 可存类型的值（含布尔/精确归一化）；不合法抛「类型错误」
函数 _值库_校验值(字段名, 值)：
    令 类名 = 类型(值)
    如果 类名 == "布尔"：
        返回 1 如果 值 否则 0
    如果 类名 == "精确小数"：
        返回 小数(值)
    如果 (类名 == "datetime") 或 (类名 == "日期时间"):
        # 与 native 同口径：文本形态（`2026-10-01 00:00:00`）
        返回 文本(值)
    如果 类名 == "整数":
        # ⚠️ 上限是 i64：**±9223372036854775807**。这里不写「SQLite 的范围」
        #    （已经不是 SQLite 了），但数字必须一样，否则老脚本的边界行为变了。
        如果 (值 > 9223372036854775807) 或 (值 < (0 - 9223372036854775807) - 1):
            抛出 值错误(`「{字段名}」这个整数超出了数据库的范围（约 ±9.2e18）：{值}（特别大的数存成文本，或者拆成两部分存）`)
        返回 值
    如果 类名 在 _值库_可存类型们：
        返回 值
    # 字典 / 列表这两种最常见，给的说得细一点（与 native 的 hint 同口径）
    如果 类名 == "字典":
        抛出 类型错误(`「{字段名}」这个值是「字典」，存不进数据库（用 json.文本化(值) 先转成文本再存；或者拆成几张表）`)
    抛出 类型错误(`「{字段名}」这个值是「{类名}」，存不进数据库（用 json.文本化(值) 先转成文本再存；多个值就拆成多条记录）`)

# 存盘编码：字节 → {"$字节": base64}（JSON 没有二进制）
函数 _值库_编码(值)：
    如果 类型(值) == "字节"：
        返回 {"$字节": 编码.base64编码(值)}
    返回 值

# 存盘解码：{"$字节": base64} → 字节
函数 _值库_解码(值)：
    如果 类型(值) == "字典"：
        如果 值.包含("$字节") 与 长度(值) == 1：
            返回 编码.base64解码(值["$字节"])
    返回 值

# 类型序：空 < 数字 < 文本 < 字节
函数 _值库_类型序(值)：
    令 类名 = 类型(值)
    如果 类名 == "空"：
        返回 _值库_空序
    如果 类名 == "整数" 或 类名 == "小数"：
        返回 _值库_数序
    如果 类名 == "文本"：
        返回 _值库_文序
    如果 类名 == "字节"：
        返回 _值库_字节序
    返回 4

# 文本比较：逐码点（基石的 < 不能比文本）
函数 _值库_文本比较(甲, 乙)：
    令 甲长 = 长度(甲)
    令 乙长 = 长度(乙)
    令 共同 = 甲长 如果 甲长 < 乙长 否则 乙长
    令 i = 0
    当 i < 共同：
        令 甲码 = 序数(甲[i])
        令 乙码 = 序数(乙[i])
        如果 甲码 < 乙码：
            返回 -1
        如果 甲码 > 乙码：
            返回 1
        i += 1
    如果 甲长 < 乙长：
        返回 -1
    如果 甲长 > 乙长：
        返回 1
    返回 0

# 全类型比较：先比类型序，再比值。返回 -1 / 0 / 1
函数 _值库_比较(甲, 乙)：
    令 甲序 = _值库_类型序(甲)
    令 乙序 = _值库_类型序(乙)
    如果 甲序 < 乙序：
        返回 -1
    如果 甲序 > 乙序：
        返回 1
    如果 甲序 == _值库_空序：
        返回 0
    如果 甲序 == _值库_数序：
        如果 甲 < 乙：
            返回 -1
        如果 甲 > 乙：
            返回 1
        返回 0
    如果 甲序 == _值库_文序：
        返回 _值库_文本比较(甲, 乙)
    # 字节：基石的 < 对字节可用（按字典序）
    如果 甲 < 乙：
        返回 -1
    如果 甲 > 乙：
        返回 1
    返回 0

# 相等（类型序相同且值相等；1 == 1.0 为真）
函数 _值库_相等(甲, 乙)：
    返回 _值库_比较(甲, 乙) == 0

# 索引键用的数字归一：1.0 与 1 同键（SQLite 数值等值语义）
函数 _值库_数键(值)：
    如果 类型(值) == "小数"：
        如果 值 == 整数(值)：
            返回 整数(值)
    返回 值

# 索引复合键：值们 → 稳定的 JSON 文本（先归一化再编码）
函数 _值库_索引键(值们)：
    令 键值们 = []
    遍历 值 在 值们：
        令 归一 = _值库_校验值("索引键", 值)
        键值们.追加(_值库_编码(_值库_数键(归一)))
    返回 json.转文本(键值们)


# ===== 原 存储器.jsh =====
# 存储器 —— 快照 + 追加日志 + 锁文件
# 设计（设计.md §三/§四）：
#   <库路径>       = 快照：首行 `#基石数据库 快照 格式=1`，其余是 JSON
#   <库路径>.log   = 追加日志（JSONL），每次写操作一条；重放恢复最新状态
#   <库路径>.lock  = 锁文件（属主令牌+时间）；进程崩溃留残锁 → 文档让用户手删
#   紧凑：关闭时 / 日志行数 > 4096 时，快照+日志合并写回、清空日志
#   空路径 "" = 私有临时库（无盘），一切文件操作跳过
#   SQLite 文件检测 → 文件错误，提示用迁移工具


_存储器_快照头 = "#基石数据库 快照 格式=1"
_存储器_紧凑阈值 = 4096

函数 _存储器_日志路径(库路径)：
    返回 库路径 + ".log"

函数 _存储器_锁路径(库路径)：
    返回 库路径 + ".lock"

# ---------- 快照 ----------

# 读快照。文件不存在 → 空；空文件 → 空；格式不对 → 文件错误
#
# ⚠️ M212：**只读一遍文件**。原来先 `读文本`（为了判 SQLite / 判空）再 `按行读`
#    读第二遍 —— 2 万行的快照 1.1 MB，白多花约 7 ms。
函数 _存储器_读快照(库路径)：
    如果 非 (文件.文件存在(库路径))：
        返回 空
    令 行们 = []
    尝试：
        行们 = 文件.按行读(库路径)
    捕获 异常 为 读错：
        # ⚠️ 别把「不是 UTF-8 编码」原样抛出去：用户拿一个 SQLite 库来打开时
        #    只会看到那句天书。这里直接告诉他「这是别的格式 + 怎么搬」。
        抛出 文件错误(`这个文件不是基石数据库的格式（不是文本文件）：「{库路径}」。想搬 SQLite 库，先用迁移工具转换`)
    如果 长度(行们) == 0：
        返回 空
    如果 行们[0] != _存储器_快照头：
        令 前 = 行们[0]
        如果 长度(前) > 100：
            前 = 前[0:100]
        如果 前.包含("SQLite format 3")：
            抛出 文件错误(`这个文件是 SQLite 库，基石数据库读不了：「{库路径}」。先用迁移工具把它转成基石格式`)
        抛出 文件错误(`这个文件不是基石数据库的格式：「{库路径}」。想搬 SQLite 库，先用迁移工具转换`)
    如果 长度(行们) == 1：
        返回 空                       # 只有头（新库）—— 与「空文件」同一个意思
    令 数据 = json.解析(文本库.拼接(行们[1:], "\n"))
    # 记录里的字节标签解码回来。
    # 🔴 M212：**没有字节的表整段跳过**。`有字节` 是写快照时算出来的（旧快照没有这个
    #    键 ⇒ 当真，照旧逐值走一遍 —— 不能因为省时间把老库的字节读丢）。
    #    实测 2 万行 × 3 字段：这一遍走 24 ms，跳过就是 0。
    遍历 表名 在 数据["表们"].键()：
        令 表 = 数据["表们"][表名]
        如果 表.获取("有字节", 真) == 假：
            继续
        遍历 记录 在 表["记录们"]：
            遍历 键 在 记录.键()：
                如果 键 != "id"：
                    记录[键] = _值库_解码(记录[键])
    返回 数据

# 写快照（原子替换）
#
# 📌 M212 实测过的两条**没采纳**的改法（都写在 CHANGELOG 里）：
# ① 「行式记录（字段名只出现一次）」：解析确实快（33 → 12 ms），但读回来要**逐行建字典**
#    （26 ms），总账反而更贵；而且每行一次 `json.解析` 是 20k 次 VM 调用。
# ② 「关闭不紧凑、只留着日志」：关闭是快了，可下次打开要把日志整个重放一遍，
#    等于把账搬到另一头。真正的解法是「行按需物化」（0.4.0）。
函数 _存储器_写快照(库路径, 表们)：
    令 数据 = {"格式": 1, "表们": {}}
    遍历 表名 在 表们.键()：
        令 表 = 表们[表名]
        令 记录们 = []
        令 有字节 = 假
        遍历 记录 在 表["记录们"]：
            令 备份 = {}
            遍历 键 在 记录.键()：
                如果 键 == "id"：
                    备份["id"] = 记录["id"]
                否则：
                    令 编 = _值库_编码(记录[键])
                    # 编码后成了字典 ⇒ 这一列有字节（`_值库_校验值` 不接受字典值，
                    # 所以记录里出现的字典只可能是字节标签）
                    如果 类型(编) == "字典"：
                        有字节 = 真
                    备份[键] = 编
            记录们.追加(备份)
        数据["表们"][表名] = {
            "字段们": 表["字段们"],
            "下一个id": 表["下一个id"],
            "索引们": 表["索引们"],
            "有字节": 有字节,
            "记录们": 记录们,
        }
    文件.原子写(库路径, _存储器_快照头 + "\n" + json.转文本(数据))

# ---------- 日志 ----------

# 日志句柄（M212）：**一次打开、逐行写**，不再每行开关文件。
#
# 原来每行都走 `文件.追加文本`（open + write + close）。Windows 上实测
# **1.18 ms/行**：2 万次插入光写日志就 23.6 秒 —— 解释器、索引、校验全加起来
# 都不到它的零头。改成持有追加句柄后同一段 **0.6 秒**。
#
# 🔴 每行写完 `刷新`：Python 宿主是**带缓冲**的（Rust / Node 直接落 OS）。
#    不刷的话「进程崩了日志还在」这条 WAL 承诺在 Python 宿主上就不成立 ——
#    三个宿主必须同一个语义，所以宁可变慢那一点（实测 刷新 在 Rust 上是空操作）。
函数 _存储器_日志句柄(状态)：
    令 现 = 状态.获取("日志句柄", 空)
    如果 现 != 空：
        返回 现
    令 句柄 = 内建.打开(_存储器_日志路径(状态["路径"]), "追加")
    状态["日志句柄"] = 句柄
    返回 句柄

# 关掉日志句柄（**不删文件**）。重写 / 截断日志之前必须先调它 ——
# 否则句柄还指着被换掉的旧文件，后面的写会静默丢。
函数 _存储器_关日志(状态)：
    令 句柄 = 状态.获取("日志句柄", 空)
    如果 句柄 != 空：
        句柄.关闭()
        状态["日志句柄"] = 空

# 追加一条日志（每条写操作一行）
函数 _存储器_追加日志(状态, 条目)：
    令 句柄 = _存储器_日志句柄(状态)
    句柄.写(json.转文本(条目) + "\n")
    句柄.刷新()

# 重放日志到内存状态。尾部残行（崩溃没写完）→ 丢弃并重写日志；
# 中间坏行 → 文件错误（不假装没事）。返回有效行数
#
# ⚠️ M212：**不再先 `json.有效` 再 `json.解析`** —— 那是把每一行解析两遍。
#    实测 3600 行：两遍 22.2 ms，只解析 11.2 ms（打开时白付一倍）。
#    改成「解析失败就进 except」，语义一模一样（坏行还是坏行）。
#    另外记住的是**原始行文本**（不是解析后的字典）：重写日志时直接拼，
#    省一份 3600 个字典的内存。
函数 _存储器_重放(状态)：
    令 日志路径 = _存储器_日志路径(状态["路径"])
    如果 非 (文件.文件存在(日志路径))：
        返回 0
    令 行们 = 文件.按行读(日志路径)
    令 留着 = []
    遍历 i 在 范围(长度(行们))：
        令 行 = 行们[i]
        如果 行 == ""：
            继续
        令 条目 = 空
        尝试：
            条目 = json.解析(行)
        捕获 异常 为 坏：
            如果 i == 长度(行们) - 1：
                # 尾部残行：崩在写一半。丢掉它，重写日志只留有效行
                _存储器_重写日志(日志路径, 留着)
                返回 长度(留着)
            抛出 文件错误(`数据库日志中间有一行坏了：「{日志路径}」第 {i + 1} 行。日志损坏，没法自动修`)
        留着.追加(行)
        # 真正落到内存表上（少了这一句，日志就只是个「记账本」）
        _存储器_应用一条(状态, 条目)
    返回 长度(留着)

# 用**原始行文本**重写日志（`_存储器_重放` 只用这条路径）
函数 _存储器_重写日志(日志路径, 行们)：
    如果 长度(行们) > 0：
        文件.原子写(日志路径, 文本库.拼接(行们, "\n") + "\n")
    否则：
        文件.原子写(日志路径, "")

# 重放一条日志到状态（引擎打开时用；顺序与产生顺序一致）
函数 _存储器_应用一条(状态, 条目)：
    令 操作 = 条目["操作"]
    如果 操作 == "建表"：
        如果 非 (条目["表"] 在 状态["表们"])：
            状态["表们"][条目["表"]] = _存储器_新表状态(条目["字段们"])
    否则如果 操作 == "删表"：
        如果 条目["表"] 在 状态["表们"].键()：
            状态["表们"].弹出(条目["表"])
    否则如果 操作 == "插入"：
        _存储器_落一行(状态, 条目["表"], 条目["id"], 条目["记录"])
    否则如果 操作 == "批量插入"：
        令 表 = 状态["表们"][条目["表"]]
        令 下一个 = 条目["起id"]
        遍历 记录 在 条目["记录们"]：
            _存储器_落一行(状态, 条目["表"], 下一个, 记录)
            下一个 += 1
    否则如果 操作 == "改行"：
        令 表 = 状态["表们"][条目["表"]]
        遍历 改 在 条目["改们"]：
            遍历 记录 在 表["记录们"]：
                如果 记录["id"] == 改["id"]：
                    遍历 键 在 改["新值"].键()：
                        记录[键] = 改["新值"][键]
    否则如果 操作 == "删行"：
        令 表 = 状态["表们"][条目["表"]]
        令 删集 = {}
        遍历 id 在 条目["id们"]：
            删集[id] = 真
        令 留们 = []
        遍历 记录 在 表["记录们"]：
            如果 记录["id"] 不在 删集：
                留们.追加(记录)
        表["记录们"] = 留们
    否则如果 操作 == "加列"：
        令 表 = 状态["表们"][条目["表"]]
        如果 非 (条目["列"] 在 表["字段们"]):
            表["字段们"].追加(条目["列"])
            遍历 记录 在 表["记录们"]：
                记录[条目["列"]] = 空
    否则如果 操作 == "建索引"：
        令 表 = 状态["表们"][条目["表"]]
        令 已有 = 假
        遍历 定义 在 表["索引们"]：
            如果 (定义["字段们"] == 条目["索引"]["字段们"]) 与 (定义["唯一"] == 条目["索引"]["唯一"])：
                已有 = 真
        如果 非 已有：
            表["索引们"].追加(条目["索引"])

函数 _存储器_新表状态(字段们)：
    返回 {"字段们": 字段们, "下一个id": 1, "索引们": [], "映射们": [], "记录们": []}

# 落一行（记录里的字节已是标签编码形态，解码回来）
函数 _存储器_落一行(状态, 表名, id, 记录)：
    令 表 = 状态["表们"][表名]
    令 行 = {"id": id}
    遍历 字段 在 表["字段们"]：
        行[字段] = _值库_解码(记录.获取(字段, 空))
    表["记录们"].追加(行)
    如果 id >= 表["下一个id"]：
        表["下一个id"] = id + 1

# ---------- 紧凑 ----------

# 快照+日志合并写回，清空日志
函数 _存储器_紧凑(状态)：
    如果 状态["无盘"]：
        状态["日志行数"] = 0
        返回
    # ⚠️ 先把日志句柄关掉：下面要用 `原子写` **换掉**日志文件，
    #    句柄还开着就会指着被删的旧文件（写进去的日志静默消失）。
    _存储器_关日志(状态)
    _存储器_写快照(状态["路径"], 状态["表们"])
    文件.原子写(_存储器_日志路径(状态["路径"]), "")
    状态["日志行数"] = 0

# 写操作之后调：超阈值就紧凑
函数 _存储器_写后检查(状态)：
    # 🔴 事务里**绝不紧凑**（M202b）：紧凑会把内存状态写成快照并清空日志，
    #    而回滚靠的就是「日志截回起点 + 内存表换回备份」—— 日志被清掉就没得截了。
    #    代价：一个开了很久、写了很多的事务不会中途落盘（内存涨）。那是事务的语义，
    #    不是缺陷：没提交就该只在内存里。
    如果 状态.获取("事务", 空) != 空：
        返回
    如果 状态["日志行数"] > _存储器_紧凑阈值：
        _存储器_紧凑(状态)


# 日志截回前 N 条（回滚用）。空行不算（`_存储器_重放` 也跳过它们）。
函数 _存储器_截断日志(状态, 保留行数)：
    如果 状态["无盘"]：
        返回
    令 日志路径 = _存储器_日志路径(状态["路径"])
    _存储器_关日志(状态)           # 同紧凑：要换文件，句柄必须先关
    如果 非 (文件.文件存在(日志路径))：
        返回
    令 留 = []
    遍历 行 在 文件.按行读(日志路径)：
        如果 行 == ""：
            继续
        如果 长度(留) < 保留行数：
            留.追加(行)
    如果 长度(留) > 0：
        文件.原子写(日志路径, 文本库.拼接(留, "\n") + "\n")
    否则：
        文件.原子写(日志路径, "")

# ---------- 锁 ----------

函数 _存储器_加锁(状态)：
    如果 状态["无盘"]：
        返回
    令 锁路径 = _存储器_锁路径(状态["路径"])
    如果 文件.文件存在(锁路径)：
        抛出 运行期错误(`库「{状态["路径"]}」已被另一个进程打开（锁文件：{锁路径}）。如果不是别的进程在用，删掉这个锁文件再试`)
    文件.写文本(锁路径, json.转文本({"属主": 标识.唯一标识短(), "打开时间": 时间.现在()}))

函数 _存储器_清锁(状态)：
    如果 状态["无盘"]：
        返回
    令 锁路径 = _存储器_锁路径(状态["路径"])
    如果 文件.文件存在(锁路径)：
        文件.删除文件(锁路径)


# ===== 原 条件.jsh =====
# 条件 —— 条件字典的校验与求值
# 兼容基准（设计.md §5.4）：
#   {"字段": 值} 等值；{"字段": {">": 值}} 嵌套比较（多运算符全部生效，AND）
#   运算符只有 > < >= <= != 包含 非空
#   {"字段": 空} 永不匹配（SQL 语义 NULL=NULL 为假）；
#   {"字段": {"非空": 真}} 取非空行、{"非空": 假} 取空行
#   包含：文本子串；操作数非文本时按其文本形式比（数字 5 → "5"）
#   条件值不能是列表/字典；空值与任何比较（除「非空」）都不命中
#   报错格式：字段名进消息（「名」这个值是「列表」，存不进数据库）


_条件_符号们 = [">", "<", ">=", "<=", "!=", "包含", "非空"]

函数 _条件_排序键(s)：
    返回 s

# 校验条件的字段都在表里；缺失的按码点序排列（复刻内置）
函数 _条件_校验字段(表名, 条件, 字段集合)：
    令 缺的 = []
    遍历 字段 在 条件.键()：
        如果 字段 不在 字段集合：
            缺的.追加(字段)
    如果 长度(缺的) > 0：
        缺的 = 缺的.排序按(_条件_排序键)   # 排序按返回新列表，要接住
        令 有提示 = 假
        遍历 一个字 在 缺的：
            如果 一个字 在 _条件_符号们：
                有提示 = 真
        令 尾巴 = ""
        如果 有提示：
            # ⚠️ 模板串里 `{{` 才是一个字面 `{`（`\{` 会把反斜杠也印出来）
            尾巴 = `。比大小要嵌一层，写成 {{"金额": {{">": 100}}}} 这样`
        抛出 值错误(`表「{表名}」里没有这些字段：{文本库.拼接(缺的, "、")}（表「{表名}」里有：{文本库.拼接(字段集合, "、")}）{尾巴}`)

# 判定一条记录是否满足条件（字段已校验过）
函数 _条件_满足(记录, 条件)：
    遍历 字段 在 条件.键()：
        令 期望 = 条件[字段]
        令 期望类 = 类型(期望)
        如果 期望类 == "字典"：
            # 用户给的嵌套字典：符号必须是 7 个公开运算符之一（内部等值不外泄）
            遍历 符号 在 期望.键()：
                如果 符号 不在 _条件_符号们：
                    抛出 值错误(`不认识的比较符号「{符号}」`)
                如果 非 (_条件_一个符号(记录[字段], 字段, 符号, 期望[符号]))：
                    返回 假
        否则：
            # 等值路径：内部用 "=" 标记，字段名传给报错格式
            如果 非 (_条件_一个符号(记录[字段], 字段, "=", 期望))：
                返回 假
    返回 真

# 一个比较符号的判定（条件名用于报错；"=" 是内部等值标记，不对外暴露）
函数 _条件_一个符号(记录值, 条件名, 符号, 操作数)：
    如果 符号 == "="：
        操作数 = _值库_校验值(条件名, 操作数)
        # {"字段": 空} 永不匹配（SQL：NULL=NULL 为假）；记录值为空同样不命中
        如果 操作数 == 空：
            返回 假
        如果 记录值 == 空：
            返回 假
        返回 _值库_比较(记录值, 操作数) == 0
    操作数 = _值库_校验值(条件名, 操作数)
    如果 符号 == "非空"：
        返回 (记录值 != 空) 如果 操作数 否则 (记录值 == 空)
    # 其余符号：SQL 语义，记录值是空一律不命中
    如果 记录值 == 空：
        返回 假
    如果 符号 == "包含"：
        返回 _条件_包含(记录值, 操作数)
    令 序 = _值库_比较(记录值, 操作数)
    如果 符号 == "!="：
        返回 序 != 0
    如果 符号 == ">"：
        返回 序 > 0
    如果 符号 == "<"：
        返回 序 < 0
    如果 符号 == ">="：
        返回 序 >= 0
    返回 序 <= 0   # "<="

函数 _条件_包含(记录值, 操作数)：
    令 大海 = 记录值 如果 类型(记录值) == "文本" 否则 文本(记录值)
    令 针 = 操作数 如果 类型(操作数) == "文本" 否则 文本(操作数)
    返回 大海.包含(针)


# ===== 原 排序.jsh =====
# 排序 —— 多键稳定排序（归并排序）
# 兼容基准（设计.md §5.4）：
#   键们 = [{"字段": 字段名, "倒": 真/假}, …]；逐键比较，前面的键分出胜负就不再看后面
#   比较全走 _值库_比较（类型序：空 < 数字 < 文本 < 字节）；倒序 = 整键反向
#   稳定：键值相同时保持原顺序（调用方按 id 序传入，天然 id 兜底）

# 比较两条记录（按键们），返回 -1 / 0 / 1
函数 _排序_比记录(甲, 乙, 键们)：
    遍历 键 在 键们：
        令 字段 = 键["字段"]
        令 序 = _值库_比较(甲[字段], 乙[字段])
        如果 序 == 0：
            继续
        返回 (0 - 序) 如果 键["倒"] 否则 序
    返回 0

函数 _排序_归并(左们, 右们, 键们)：
    令 结果 = []
    令 i = 0
    令 j = 0
    令 左长 = 长度(左们)
    令 右长 = 长度(右们)
    当 i < 左长 与 j < 右长：
        如果 _排序_比记录(左们[i], 右们[j], 键们) <= 0：
            结果.追加(左们[i])
            i += 1
        否则：
            结果.追加(右们[j])
            j += 1
    当 i < 左长：
        结果.追加(左们[i])
        i += 1
    当 j < 右长：
        结果.追加(右们[j])
        j += 1
    返回 结果

# 稳定归并排序（不改原列表，返回新列表）
函数 _排序_执行(记录们, 键们)：
    如果 长度(记录们) <= 1：
        返回 记录们
    令 个数 = 长度(记录们)
    如果 个数 == 2：
        如果 _排序_比记录(记录们[0], 记录们[1], 键们) <= 0：
            返回 记录们
        返回 [记录们[1], 记录们[0]]
    令 中 = 个数 // 2
    返回 _排序_归并(_排序_执行(记录们[0:中], 键们), _排序_执行(记录们[中:], 键们), 键们)


# ===== 原 索引.jsh =====
# 索引 —— 索引的内存映射（唯一约束 + 等值查询加速）
# 兼容基准（设计.md §5.7）：
#   撞唯一约束 → 运行期错误 `数据库操作失败：UNIQUE constraint failed: 表.字段`
#   多字段索引的报错是 `表.甲, 表.乙` 形态（全列列出，逗号+空格分隔）
#   空值不参与唯一性（SQL 语义：NULL 不参与 UNIQUE）
#   建索引时字段不存在 → 值错误（引擎负责校验字段，本模块只管映射）
#   唯一索引映射：键 → 行（冲突检查）；非唯一索引映射：键 → 行列表（等值查询 O(命中)）
#   修改的调用约定：**先调 _索引_改行 再改行里的字段**（旧键要从改前状态算）
# 性能注记：字典成员判断「在」对不存在的键走线性扫描（实测 10 万键 0.6ms/次），
#   而字典.获取(键, 默认) 未命中走哈希（1.3μs）——本模块一律用 获取 做存在性检查。


# 从表状态重建全部映射（打开/载入快照后调一次）
函数 _索引_重建(表状态, 表名)：
    令 映射们 = []
    遍历 定义 在 表状态["索引们"]：
        映射们.追加(_索引_建映射(表状态, 表名, 定义["字段们"], 定义["唯一"]))
    表状态["映射们"] = 映射们

# 给一个索引定义建映射。唯一 → 有重复抛冲突；非唯一 → 键 → 行列表
函数 _索引_建映射(表状态, 表名, 字段们, 唯一)：
    令 映射 = {}
    遍历 记录 在 表状态["记录们"]：
        令 键 = _索引_键文本(字段们, 记录)
        如果 键 != 空：
            令 旧 = 映射.获取(键, 空)
            如果 唯一：
                如果 旧 != 空：
                    _索引_抛冲突(表名, 字段们)
                映射[键] = 记录
            否则如果 旧 != 空：
                旧.追加(记录)
            否则：
                映射[键] = [记录]
    返回 {"字段们": 字段们, "唯一": 唯一, "映射": 映射}

# 一条记录在指定字段们上的键文本；含空值 → 空（不参与唯一性）
函数 _索引_键文本(字段们, 记录)：
    令 值们 = []
    遍历 字段 在 字段们：
        令 值 = 记录[字段]
        如果 值 == 空：
            返回 空
        值们.追加(_值库_编码(_值库_数键(值)))
    返回 json.转文本(值们)

函数 _索引_抛冲突(表名, 字段们)：
    令 列们 = []
    遍历 字段 在 字段们：
        列们.追加(`{表名}.{字段}`)
    抛出 运行期错误(`数据库操作失败：UNIQUE constraint failed: {文本库.拼接(列们, ", ")}`)

# 插入一行：查重并登记。冲突抛运行期错误（原状不动——调用方在提交前调用）
函数 _索引_加行(表状态, 表名, 记录)：
    遍历 映射项 在 表状态["映射们"]：
        如果 非 映射项["唯一"]：
            继续
        令 键 = _索引_键文本(映射项["字段们"], 记录)
        如果 键 != 空：
            如果 映射项["映射"].获取(键, 空) != 空：
                _索引_抛冲突(表名, 映射项["字段们"])

# 登记一行（已查过重，直接写入映射）
函数 _索引_登记(表状态, 记录)：
    遍历 映射项 在 表状态["映射们"]：
        令 键 = _索引_键文本(映射项["字段们"], 记录)
        如果 键 != 空：
            令 旧 = 映射项["映射"].获取(键, 空)
            如果 映射项["唯一"]：
                映射项["映射"][键] = 记录
            否则如果 旧 != 空：
                旧.追加(记录)
            否则：
                映射项["映射"][键] = [记录]

# 删除一行：清掉它的键
函数 _索引_删行(表状态, 记录)：
    遍历 映射项 在 表状态["映射们"]：
        令 键 = _索引_键文本(映射项["字段们"], 记录)
        如果 键 != 空：
            令 旧 = 映射项["映射"].获取(键, 空)
            如果 旧 != 空：
                如果 映射项["唯一"]：
                    映射项["映射"].弹出(键)
                否则：
                    _索引_列表去行(映射项, 键, 旧, 记录)

# 从键的行列表里去掉这一行；空了就整个键删掉
函数 _索引_列表去行(映射项, 键, 旧们, 记录)：
    令 留们 = []
    遍历 行 在 旧们：
        如果 行["id"] != 记录["id"]：
            留们.追加(行)
    如果 长度(留们) == 0：
        映射项["映射"].弹出(键)
    否则：
        映射项["映射"][键] = 留们

# 修改一行：检查新键是否撞别人（不撞不动手，返回给引擎判定）
# 行的新键与其它行的旧键冲突 → 抛错；自己占的键不算冲突
函数 _索引_查改行(表状态, 表名, 记录, 新值)：
    遍历 映射项 在 表状态["映射们"]：
        如果 非 映射项["唯一"]：
            继续
        如果 非 _索引_涉及(映射项, 新值)：
            继续
        令 新键 = _索引_键文本(映射项["字段们"], _索引_改后行(记录, 新值))
        如果 新键 != 空：
            令 旧 = 映射项["映射"].获取(新键, 空)
            如果 (旧 != 空) 与 (旧["id"] != 记录["id"])：
                _索引_抛冲突(表名, 映射项["字段们"])

# 语句级预检：一批行全部改成同一个 新值 后，唯一性是否成立。
# 覆盖两种撞法：撞不在改动列表里的行；语句内两行改成同一个值
函数 _索引_预检改们(表状态, 表名, 们, 新值)：
    遍历 映射项 在 表状态["映射们"]：
        如果 非 映射项["唯一"]：
            继续
        如果 非 _索引_涉及(映射项, 新值)：
            继续
        令 占用 = {}
        遍历 行 在 们：
            令 新键 = _索引_键文本(映射项["字段们"], _索引_改后行(行, 新值))
            如果 新键 == 空：
                继续
            如果 占用.获取(新键, 空) != 空：
                _索引_抛冲突(表名, 映射项["字段们"])
            占用[新键] = 行["id"]
            令 旧 = 映射项["映射"].获取(新键, 空)
            如果 (旧 != 空) 与 (旧["id"] != 行["id"])：
                _索引_抛冲突(表名, 映射项["字段们"])

# 修改已通过预检，更新映射（先删旧键再记新键）。
# 注意：要在改行里的字段**之前**调——旧键从当前（改前）状态算
函数 _索引_改行(表状态, 记录, 新值)：
    遍历 映射项 在 表状态["映射们"]：
        如果 非 _索引_涉及(映射项, 新值)：
            继续
        如果 映射项["唯一"]：
            令 旧键 = _索引_键文本(映射项["字段们"], 记录)
            如果 旧键 != 空：
                映射项["映射"].弹出(旧键)
            令 新键 = _索引_键文本(映射项["字段们"], _索引_改后行(记录, 新值))
            如果 新键 != 空：
                映射项["映射"][新键] = 记录
        否则：
            令 旧键 = _索引_键文本(映射项["字段们"], 记录)
            如果 旧键 != 空：
                令 旧们 = 映射项["映射"].获取(旧键, 空)
                如果 旧们 != 空：
                    _索引_列表去行(映射项, 旧键, 旧们, 记录)
            令 新键 = _索引_键文本(映射项["字段们"], _索引_改后行(记录, 新值))
            如果 新键 != 空：
                令 旧2 = 映射项["映射"].获取(新键, 空)
                如果 旧2 != 空：
                    旧2.追加(记录)
                否则：
                    映射项["映射"][新键] = [记录]

函数 _索引_涉及(映射项, 新值)：
    遍历 字段 在 新值.键()：
        如果 字段 在 映射项["字段们"]：
            返回 真
    返回 假

函数 _索引_改后行(记录, 新值)：
    令 改后 = {}
    遍历 字段 在 记录.键()：
        改后[字段] = 记录[字段]
    遍历 字段 在 新值.键()：
        改后[字段] = 新值[字段]
    返回 改后

# ---------- 查询加速 ----------

# 条件里能整体命中某索引的等值组 → 返回候选行们（空列表 = 键不在映射里，必无匹配）；
# 没有适用的索引（或条件有快速路径不支持的形态）→ 返回 空。
# 只做加速不改语义：调用方拿到候选后仍要过 _条件_满足。
# 支持的等值形态：普通值（整数/小数/文本/字节/布尔/精确小数）；
#   字典（比较运算）、「空」（NULL 条件）、列表等 → 不适用，走全表扫（保持惰性报错语义）
函数 _索引_候选行们(表, 条件)：
    如果 条件 == 空：
        返回 空
    遍历 映射项 在 表["映射们"]：
        令 值们 = []
        令 适用 = 真
        遍历 字段 在 映射项["字段们"]：
            如果 字段 不在 条件：
                适用 = 假
                中断
            令 期望 = 条件[字段]
            令 类名 = 类型(期望)
            如果 类名 == "字典"：
                适用 = 假
                中断
            如果 (类名 == "整数") 或 (类名 == "小数") 或 (类名 == "文本") 或 (类名 == "字节") 或 (类名 == "布尔") 或 (类名 == "精确小数")：
                值们.追加(期望)
            否则：
                # 「空」等值永不命中（交给线性扫）、列表等类型保持惰性报错
                适用 = 假
                中断
        如果 适用：
            令 拿 = 映射项["映射"].获取(_值库_索引键(值们), 空)
            如果 拿 == 空：
                返回 []
            如果 映射项["唯一"]：
                返回 [拿]
            返回 拿
    返回 空


# ===== 原 SQL子集.jsh =====
# SQL子集 —— 常用 SQL 的分词 / 解析 / 执行（写路径与查询）
# 规范见 设计.md §七。语义按 SQLite：
#   三值逻辑（空 参与与或非）；整数/整数 除法取整、除 0 → 空；
#   LIKE 大小写不敏感（ASCII）、% 任意串、_ 单字符；
#   标识符（列名/表名）匹配大小写不敏感；关键字大小写不敏感；
#   语法错 → 运行期错误 `数据库操作失败：SQL 语法错：<中文说明>`
#   （有意偏差：SQLite 原文无法逐字复刻，测试只比类型与前缀）
#
# 实现注记：解析器全部**纯参数传递**（记号们+位 进、[结果, 新位] 出），
# 不用模块级可变状态——基石函数内无令赋值是局部变量（实测），传参最稳。


_SQL子集_关键字们 = ["select", "insert", "update", "delete", "create", "drop", "table",
    "into", "values", "where", "and", "or", "not", "is", "null", "like", "in",
    "order", "group", "by", "asc", "desc", "limit", "offset", "set", "exists",
    "if", "from", "as", "count", "distinct", "between",
    "alter", "add", "column"]

# 全角标点不算标识符字符（中文表名列名里可能出现）
_SQL子集_全角标点们 = "，。、；：？！（）「」『』《》【】·…—＋＝％｜＼｛｝［］”“’‘"

_SQL子集_斜杠 = 字符(92)   # 反斜杠（避免字面量转义歧义）

# ---------- 报错 ----------

函数 _SQL子集_语法错(说明)：
    抛出 运行期错误(`数据库操作失败：SQL 语法错：{说明}`)

# 运行期语义错（SQLite 同款消息，无「SQL 语法错」前缀）
函数 _SQL子集_语义错(说明)：
    抛出 运行期错误(`数据库操作失败：{说明}`)

# ---------- 分词 ----------

函数 _SQL子集_是空白(c)：
    返回 (c == " ") 或 (c == "\t") 或 (c == "\n") 或 (c == "\r")

函数 _SQL子集_是数字字符(c)：
    令 n = 序数(c)
    返回 (n >= 48) 与 (n <= 57)

函数 _SQL子集_是标识字符(c, 首字符)：
    令 n = 序数(c)
    如果 n >= 128：
        返回 非 (c 在 _SQL子集_全角标点们)
    如果 (n >= 97) 与 (n <= 122)：
        返回 真
    如果 (n >= 65) 与 (n <= 90)：
        返回 真
    如果 n == 95：
        返回 真
    如果 (n >= 48) 与 (n <= 57)：
        返回 非 首字符
    返回 假

函数 _SQL子集_分词(SQL)：
    令 记号们 = []
    令 i = 0
    令 n = 长度(SQL)
    当 i < n：
        令 c = SQL[i]
        如果 _SQL子集_是空白(c)：
            i += 1
            继续
        # -- 行注释
        如果 (c == "-") 与 (i + 1 < n) 与 (SQL[i + 1] == "-")：
            当 (i < n) 与 (SQL[i] != "\n")：
                i += 1
            继续
        # '字符串'（'' 转义）
        如果 c == "'"：
            令 段们 = []
            i += 1
            令 断 = 真
            当 i < n：
                如果 SQL[i] == "'"：
                    如果 (i + 1 < n) 与 (SQL[i + 1] == "'")：
                        段们.追加("'")
                        i += 2
                        继续
                    i += 1
                    断 = 假
                    中断
                段们.追加(SQL[i])
                i += 1
            如果 断：
                _SQL子集_语法错("字符串没写完：单引号没闭合")
            记号们.追加({"类": "文", "值": 文本库.拼接(段们, "")})
            继续
        # "x" / `x` / [x] 包裹的标识符
        如果 (c == "\"") 或 (c == "`") 或 (c == "[")：
            令 尾 = "\"" 如果 c == "\"" 否则 ("`" 如果 c == "`" 否则 "]")
            i += 1
            令 段们 = []
            当 (i < n) 与 (SQL[i] != 尾)：
                段们.追加(SQL[i])
                i += 1
            如果 i >= n：
                _SQL子集_语法错("标识符没写完：包裹符号没闭合")
            i += 1
            记号们.追加({"类": "字", "值": 文本库.拼接(段们, "")})
            继续
        # ? 参数
        如果 c == "?"：
            记号们.追加({"类": "号", "值": "?"})
            i += 1
            继续
        # 数字
        如果 _SQL子集_是数字字符(c) 或 ((c == ".") 与 (i + 1 < n) 与 (_SQL子集_是数字字符(SQL[i + 1])))：
            令 起 = i
            令 见点 = 假
            当 (i < n) 与 (_SQL子集_是数字字符(SQL[i]) 或 ((SQL[i] == ".") 与 (非 见点)))：
                如果 SQL[i] == "."：
                    见点 = 真
                i += 1
            令 段 = SQL[起:i]
            如果 见点：
                记号们.追加({"类": "数", "值": 小数(段)})
            否则：
                记号们.追加({"类": "数", "值": 整数(段)})
            继续
        # 标识符（中文/英文/数字/下划线）
        如果 _SQL子集_是标识字符(c, 真)：
            令 起 = i
            当 (i < n) 与 (_SQL子集_是标识字符(SQL[i], 假))：
                i += 1
            记号们.追加({"类": "字", "值": SQL[起:i]})
            继续
        # 两字符符号
        如果 i + 1 < n：
            令 双 = SQL[i:i + 2]
            如果 (双 == "==") 或 (双 == "!=") 或 (双 == "<>") 或 (双 == "<=") 或 (双 == ">=")：
                令 符 = "=" 如果 双 == "==" 否则 ("!=" 如果 (双 == "!=") 或 (双 == "<>") 否则 双)
                记号们.追加({"类": "号", "值": 符})
                i += 2
                继续
        # 单字符符号
        如果 (c == "=") 或 (c == "<") 或 (c == ">") 或 (c == "+") 或 (c == "-") 或 (c == "*") 或 (c == "/") 或 (c == "(") 或 (c == ")") 或 (c == ",")：
            记号们.追加({"类": "号", "值": c})
            i += 1
            继续
        _SQL子集_语法错(`不认识的符号「{c}」`)
    记号们.追加({"类": "止", "值": 空})
    返回 记号们

# ---------- 记号辅助（纯传参）----------

函数 _SQL子集_看(记号们, 位)：
    返回 记号们[位]

函数 _SQL子集_吃(记号们, 位)：
    令 t = 记号们[位]
    令 新位 = 位
    如果 t["类"] != "止"：
        新位 = 位 + 1
    返回 [t, 新位]

函数 _SQL子集_关键字(t)：
    如果 t["类"] == "字"：
        令 小 = t["值"].小写()
        如果 小 在 _SQL子集_关键字们：
            返回 小
    返回 空

函数 _SQL子集_吃关键字(记号们, 位, k)：
    如果 _SQL子集_关键字(_SQL子集_看(记号们, 位)) == k：
        返回 [真, 位 + 1]
    返回 [假, 位]

函数 _SQL子集_要关键字(记号们, 位, k)：
    令 有 = _SQL子集_吃关键字(记号们, 位, k)
    如果 有[0]：
        返回 有[1]
    _SQL子集_语法错(`这里要「{k}」`)

函数 _SQL子集_看符号(记号们, 位, s)：
    令 t = 记号们[位]
    返回 (t["类"] == "号") 与 (t["值"] == s)

函数 _SQL子集_吃符号(记号们, 位, s)：
    如果 _SQL子集_看符号(记号们, 位, s)：
        返回 [真, 位 + 1]
    返回 [假, 位]

函数 _SQL子集_要符号(记号们, 位, s)：
    令 有 = _SQL子集_吃符号(记号们, 位, s)
    如果 有[0]：
        返回 有[1]
    _SQL子集_语法错(`这里要「{s}」`)

函数 _SQL子集_要名字(记号们, 位, 说明)：
    令 t = 记号们[位]
    如果 t["类"] == "字"：
        返回 [t["值"], 位 + 1]
    _SQL子集_语法错(说明)

# 名字匹配：先精确，再 ASCII 大小写不敏感；找不到给 空
函数 _SQL子集_找名字(名字们, 想要)：
    如果 想要 在 名字们：
        返回 想要
    令 小 = 想要.小写()
    遍历 名 在 名字们：
        如果 名.小写() == 小：
            返回 名
    返回 空

# ---------- 表达式解析（优先级 OR < AND < NOT < 比较 < 加减 < 乘除 < 一元）----------
# 全部签名 (记号们, 位) → [树, 新位]

函数 _SQL子集_解析表达式(记号们, 位)：
    返回 _SQL子集_解析或(记号们, 位)

函数 _SQL子集_解析或(记号们, 位)：
    令 解析 = _SQL子集_解析与(记号们, 位)
    令 左 = 解析[0]
    令 新位 = 解析[1]
    当 真：
        令 有词 = _SQL子集_吃关键字(记号们, 新位, "or")
        如果 有词[0]：
            令 右解析 = _SQL子集_解析与(记号们, 有词[1])
            左 = {"类": "或", "左": 左, "右": 右解析[0]}
            新位 = 右解析[1]
        否则：
            中断
    返回 [左, 新位]

函数 _SQL子集_解析与(记号们, 位)：
    令 解析 = _SQL子集_解析非(记号们, 位)
    令 左 = 解析[0]
    令 新位 = 解析[1]
    当 真：
        令 有词 = _SQL子集_吃关键字(记号们, 新位, "and")
        如果 有词[0]：
            令 右解析 = _SQL子集_解析非(记号们, 有词[1])
            左 = {"类": "与", "左": 左, "右": 右解析[0]}
            新位 = 右解析[1]
        否则：
            中断
    返回 [左, 新位]

函数 _SQL子集_解析非(记号们, 位)：
    令 有词 = _SQL子集_吃关键字(记号们, 位, "not")
    如果 有词[0]：
        令 子解析 = _SQL子集_解析非(记号们, 有词[1])
        返回 [{"类": "非", "子": 子解析[0]}, 子解析[1]]
    返回 _SQL子集_解析比较(记号们, 位)

函数 _SQL子集_解析比较(记号们, 位)：
    令 解析 = _SQL子集_解析加减(记号们, 位)
    令 左 = 解析[0]
    令 新位 = 解析[1]
    令 t = 记号们[新位]
    如果 t["类"] == "号"：
        令 符 = t["值"]
        如果 (符 == "=") 或 (符 == "!=") 或 (符 == "<") 或 (符 == ">")：
            令 右解析 = _SQL子集_解析加减(记号们, 新位 + 1)
            返回 [{"类": "比较", "符": 符, "左": 左, "右": 右解析[0]}, 右解析[1]]
    令 k = _SQL子集_关键字(t)
    如果 k == "is"：
        令 新位2 = 新位 + 1
        令 非解析 = _SQL子集_吃关键字(记号们, 新位2, "not")
        如果 非解析[0]：
            新位2 = 非解析[1]
        新位2 = _SQL子集_要关键字(记号们, 新位2, "null")
        返回 [{"类": "IS", "左": 左, "取非": 非解析[0]}, 新位2]
    如果 k == "like"：
        令 模式解析 = _SQL子集_解析加减(记号们, 新位 + 1)
        返回 [{"类": "LIKE", "左": 左, "模式": 模式解析[0], "取非": 假}, 模式解析[1]]
    如果 k == "in"：
        令 组解析 = _SQL子集_解析组列表(记号们, 新位 + 1)
        返回 [{"类": "IN", "左": 左, "项们": 组解析[0], "取非": 假}, 组解析[1]]
    如果 k == "not"：
        # 后缀 NOT IN / NOT LIKE（下个记号最多到"止"，位+1 安全）
        令 下个键 = _SQL子集_关键字(记号们[新位 + 1])
        如果 下个键 == "in"：
            令 组解析 = _SQL子集_解析组列表(记号们, 新位 + 2)
            返回 [{"类": "IN", "左": 左, "项们": 组解析[0], "取非": 真}, 组解析[1]]
        如果 下个键 == "like"：
            令 模式解析 = _SQL子集_解析加减(记号们, 新位 + 2)
            返回 [{"类": "LIKE", "左": 左, "模式": 模式解析[0], "取非": 真}, 模式解析[1]]
    返回 [左, 新位]

函数 _SQL子集_解析组列表(记号们, 位)：
    令 新位 = _SQL子集_要符号(记号们, 位, "(")
    令 项们 = []
    如果 非 (_SQL子集_看符号(记号们, 新位, ")"))：
        当 真：
            令 项解析 = _SQL子集_解析表达式(记号们, 新位)
            项们.追加(项解析[0])
            新位 = 项解析[1]
            令 步 = _SQL子集_吃符号(记号们, 新位, ",")
            如果 步[0]：
                新位 = 步[1]
            否则：
                中断
    新位 = _SQL子集_要符号(记号们, 新位, ")")
    返回 [项们, 新位]

函数 _SQL子集_解析加减(记号们, 位)：
    令 解析 = _SQL子集_解析乘除(记号们, 位)
    令 左 = 解析[0]
    令 新位 = 解析[1]
    当 真：
        令 t = 记号们[新位]
        如果 (t["类"] == "号") 与 ((t["值"] == "+") 或 (t["值"] == "-"))：
            令 右解析 = _SQL子集_解析乘除(记号们, 新位 + 1)
            左 = {"类": "算", "符": t["值"], "左": 左, "右": 右解析[0]}
            新位 = 右解析[1]
        否则：
            中断
    返回 [左, 新位]

函数 _SQL子集_解析乘除(记号们, 位)：
    令 解析 = _SQL子集_解析一元(记号们, 位)
    令 左 = 解析[0]
    令 新位 = 解析[1]
    当 真：
        令 t = 记号们[新位]
        如果 (t["类"] == "号") 与 ((t["值"] == "*") 或 (t["值"] == "/"))：
            令 右解析 = _SQL子集_解析一元(记号们, 新位 + 1)
            左 = {"类": "算", "符": t["值"], "左": 左, "右": 右解析[0]}
            新位 = 右解析[1]
        否则：
            中断
    返回 [左, 新位]

函数 _SQL子集_解析一元(记号们, 位)：
    令 t = 记号们[位]
    如果 (t["类"] == "号") 与 ((t["值"] == "-") 或 (t["值"] == "+"))：
        令 子解析 = _SQL子集_解析一元(记号们, 位 + 1)
        如果 t["值"] == "-"：
            返回 [{"类": "负", "子": 子解析[0]}, 子解析[1]]
        返回 子解析
    返回 _SQL子集_解析原子(记号们, 位)

函数 _SQL子集_解析原子(记号们, 位)：
    令 t = 记号们[位]
    如果 t["类"] == "数"：
        返回 [{"类": "字面量", "值": t["值"]}, 位 + 1]
    如果 t["类"] == "文"：
        返回 [{"类": "字面量", "值": t["值"]}, 位 + 1]
    如果 t["类"] == "号"：
        如果 t["值"] == "?"：
            返回 [{"类": "参数", "序": -1}, 位 + 1]   # 序解析后统一编号
        如果 t["值"] == "("：
            令 子解析 = _SQL子集_解析表达式(记号们, 位 + 1)
            令 新位 = _SQL子集_要符号(记号们, 子解析[1], ")")
            返回 [子解析[0], 新位]
    令 k = _SQL子集_关键字(t)
    如果 k == "null"：
        返回 [{"类": "字面量", "值": 空}, 位 + 1]
    如果 t["类"] == "字"：
        返回 [{"类": "列", "名": t["值"]}, 位 + 1]
    令 显示 = t["值"]
    _SQL子集_语法错(`这里要一个值，来的却是「{显示}」`)

# 给树里的 ? 按出现顺序编号（先序遍历）。
# 语句树（SELECT/INSERT/UPDATE/DELETE）就地重编子表达式；
# 表达式树也就地重编（树是解析一条刚建的，安全）。
函数 _SQL子集_编号参数(树, 序)：
    令 种类 = 树["类"]
    如果 种类 == "参数"：
        树["序"] = 序
        返回 [树, 序 + 1]
    如果 种类 == "SELECT"：
        令 新序 = 序
        如果 树["条件"] != 空：
            令 结 = _SQL子集_编号参数(树["条件"], 新序)
            树["条件"] = 结[0]
            新序 = 结[1]
        如果 树["界"] != 空：
            令 结2 = _SQL子集_编号参数(树["界"], 新序)
            树["界"] = 结2[0]
            新序 = 结2[1]
        如果 树["偏"] != 空：
            令 结3 = _SQL子集_编号参数(树["偏"], 新序)
            树["偏"] = 结3[0]
            新序 = 结3[1]
        返回 [树, 新序]
    如果 种类 == "INSERT"：
        令 新序 = 序
        遍历 组 在 树["组们"]：
            令 新项们 = []
            遍历 项 在 组["项们"]：
                令 结 = _SQL子集_编号参数(项, 新序)
                新项们.追加(结[0])
                新序 = 结[1]
            组["项们"] = 新项们
        返回 [树, 新序]
    如果 种类 == "UPDATE"：
        令 新序 = 序
        遍历 对 在 树["赋值们"]：
            令 结 = _SQL子集_编号参数(对["值"], 新序)
            对["值"] = 结[0]
            新序 = 结[1]
        如果 树["条件"] != 空：
            令 结2 = _SQL子集_编号参数(树["条件"], 新序)
            树["条件"] = 结2[0]
            新序 = 结2[1]
        返回 [树, 新序]
    如果 种类 == "DELETE"：
        令 新序 = 序
        如果 树["条件"] != 空：
            令 结 = _SQL子集_编号参数(树["条件"], 新序)
            树["条件"] = 结[0]
            新序 = 结[1]
        返回 [树, 新序]
    # ---- 表达式树 ----
    如果 (种类 == "非") 或 (种类 == "负")：
        令 子结果 = _SQL子集_编号参数(树["子"], 序)
        树["子"] = 子结果[0]
        返回 [树, 子结果[1]]
    如果 (种类 == "与") 或 (种类 == "或") 或 (种类 == "比较") 或 (种类 == "算")：
        令 左结果 = _SQL子集_编号参数(树["左"], 序)
        树["左"] = 左结果[0]
        令 右结果 = _SQL子集_编号参数(树["右"], 左结果[1])
        树["右"] = 右结果[0]
        返回 [树, 右结果[1]]
    如果 种类 == "LIKE"：
        令 左结果 = _SQL子集_编号参数(树["左"], 序)
        树["左"] = 左结果[0]
        令 模式结果 = _SQL子集_编号参数(树["模式"], 左结果[1])
        树["模式"] = 模式结果[0]
        返回 [树, 模式结果[1]]
    如果 种类 == "IS"：
        令 左结果 = _SQL子集_编号参数(树["左"], 序)
        树["左"] = 左结果[0]
        返回 [树, 左结果[1]]
    如果 种类 == "IN"：
        令 左结果 = _SQL子集_编号参数(树["左"], 序)
        树["左"] = 左结果[0]
        令 新序 = 左结果[1]
        遍历 i 在 范围(长度(树["项们"]))：
            令 项结果 = _SQL子集_编号参数(树["项们"][i], 新序)
            树["项们"][i] = 项结果[0]
            新序 = 项结果[1]
        返回 [树, 新序]
    返回 [树, 序]

# ---------- 语句解析（都返回 [树, 新位]）----------

函数 _SQL子集_解析一条(SQL, 参数们)：
    令 记号们 = _SQL子集_分词(SQL)
    令 解析 = _SQL子集_语句(记号们, 0)
    如果 解析[1] != 长度(记号们) - 1：
        _SQL子集_语法错("一条 SQL 后面还有多余的词（一次只支持一条语句）")
    令 编号 = _SQL子集_编号参数(解析[0], 0)
    返回 编号[0]

函数 _SQL子集_语句(记号们, 位)：
    令 t = 记号们[位]
    令 k = _SQL子集_关键字(t)
    如果 k == "select"：
        返回 _SQL子集_解析SELECT(记号们, 位)
    如果 k == "insert"：
        返回 _SQL子集_解析INSERT(记号们, 位)
    如果 k == "update"：
        返回 _SQL子集_解析UPDATE(记号们, 位)
    如果 k == "delete"：
        返回 _SQL子集_解析DELETE(记号们, 位)
    如果 k == "create"：
        返回 _SQL子集_解析CREATE(记号们, 位)
    如果 k == "drop"：
        返回 _SQL子集_解析DROP(记号们, 位)
    如果 k == "alter"：
        返回 _SQL子集_解析ALTER(记号们, 位)
    令 显示 = t["值"]
    _SQL子集_语法错(`SQL 要从 SELECT / INSERT / UPDATE / DELETE / CREATE / DROP / ALTER 开头，来的却是「{显示}」`)

函数 _SQL子集_解析SELECT(记号们, 位)：
    令 新位 = _SQL子集_要关键字(记号们, 位, "select")
    如果 _SQL子集_关键字(记号们[新位]) == "distinct"：
        _SQL子集_语法错("SELECT DISTINCT 不在支持的子集里")
    令 全部 = 假
    令 列们 = []
    令 星 = _SQL子集_吃符号(记号们, 新位, "*")
    如果 星[0]：
        全部 = 真
        新位 = 星[1]
    否则：
        当 真：
            令 列解析 = _SQL子集_解析输出列(记号们, 新位)
            列们.追加(列解析[0])
            新位 = 列解析[1]
            令 步 = _SQL子集_吃符号(记号们, 新位, ",")
            如果 步[0]：
                新位 = 步[1]
            否则：
                中断
    新位 = _SQL子集_要关键字(记号们, 新位, "from")
    令 表解析 = _SQL子集_要名字(记号们, 新位, "FROM 后面要表名")
    令 表名 = 表解析[0]
    新位 = 表解析[1]
    令 条件 = 空
    令 有条件 = _SQL子集_吃关键字(记号们, 新位, "where")
    如果 有条件[0]：
        令 条件解析 = _SQL子集_解析表达式(记号们, 有条件[1])
        条件 = 条件解析[0]
        新位 = 条件解析[1]
    令 分组 = []
    令 有分组 = _SQL子集_吃关键字(记号们, 新位, "group")
    如果 有分组[0]：
        新位 = _SQL子集_要关键字(记号们, 有分组[1], "by")
        当 真：
            令 名解析 = _SQL子集_要名字(记号们, 新位, "GROUP BY 后面要列名")
            分组.追加(名解析[0])
            新位 = 名解析[1]
            令 步 = _SQL子集_吃符号(记号们, 新位, ",")
            如果 步[0]：
                新位 = 步[1]
            否则：
                中断
    令 序们 = []
    令 有序 = _SQL子集_吃关键字(记号们, 新位, "order")
    如果 有序[0]：
        新位 = _SQL子集_要关键字(记号们, 有序[1], "by")
        当 真：
            令 名解析 = _SQL子集_要名字(记号们, 新位, "ORDER BY 后面要列名")
            新位 = 名解析[1]
            # `ORDER BY MIN(rowid)`：等价于「按首现顺序」，也就是默认顺序
            令 是行号 = 假
            如果 _SQL子集_看符号(记号们, 新位, "(") 与 (名解析[0].小写() == "min"):
                新位 = _SQL子集_要符号(记号们, 新位, "(")
                令 内 = _SQL子集_要名字(记号们, 新位, "MIN 里要 rowid")
                新位 = _SQL子集_要符号(记号们, 内[1], ")")
                是行号 = 真
                名解析 = ["rowid", 新位]
            令 倒 = 假
            令 降 = _SQL子集_吃关键字(记号们, 新位, "desc")
            如果 降[0]：
                倒 = 真
                新位 = 降[1]
            否则：
                令 升 = _SQL子集_吃关键字(记号们, 新位, "asc")
                如果 升[0]：
                    新位 = 升[1]
            序们.追加({"名": 名解析[0], "倒": 倒, "行号": 是行号})
            令 步 = _SQL子集_吃符号(记号们, 新位, ",")
            如果 步[0]：
                新位 = 步[1]
            否则：
                中断
    令 界 = 空
    令 偏 = 空
    令 有界 = _SQL子集_吃关键字(记号们, 新位, "limit")
    如果 有界[0]：
        令 界解析 = _SQL子集_解析一元(记号们, 有界[1])
        界 = 界解析[0]
        新位 = 界解析[1]
        令 逗 = _SQL子集_吃符号(记号们, 新位, ",")
        如果 逗[0]：
            # LIMIT 偏, 个 = LIMIT 个 OFFSET 偏（SQLite 语义）
            偏 = 界
            令 新界 = _SQL子集_解析一元(记号们, 逗[1])
            界 = 新界[0]
            新位 = 新界[1]
        否则：
            令 有偏 = _SQL子集_吃关键字(记号们, 新位, "offset")
            如果 有偏[0]：
                令 偏解析 = _SQL子集_解析一元(记号们, 有偏[1])
                偏 = 偏解析[0]
                新位 = 偏解析[1]
    返回 [{"类": "SELECT", "全部": 全部, "列们": 列们, "表": 表名, "条件": 条件,
           "分组": 分组, "序们": 序们, "界": 界, "偏": 偏}, 新位]

函数 _SQL子集_解析输出列(记号们, 位)：
    令 t = 记号们[位]
    令 k = _SQL子集_关键字(t)
    如果 (k == "count") 与 (t["类"] == "字")：
        令 新位 = _SQL子集_要符号(记号们, 位 + 1, "(")
        令 全 = 假
        令 列名 = 空
        令 星 = _SQL子集_吃符号(记号们, 新位, "*")
        如果 星[0]：
            全 = 真
            新位 = 星[1]
        否则：
            令 名解析 = _SQL子集_要名字(记号们, 新位, "COUNT 里要 * 或列名")
            列名 = 名解析[0]
            新位 = 名解析[1]
        新位 = _SQL子集_要符号(记号们, 新位, ")")
        令 键 = "COUNT(*)" 如果 全 否则 `COUNT({列名})`
        令 别名 = _SQL子集_解析别名(记号们, 新位)
        如果 别名[0] != 空：
            键 = 别名[0]
        返回 [{"聚合": 真, "全": 全, "列": 列名, "键": 键}, 别名[1]]
    令 名解析 = _SQL子集_要名字(记号们, 位, "SELECT 后面要列名或 *")
    令 别名 = _SQL子集_解析别名(记号们, 名解析[1])
    返回 [{"聚合": 假, "列": 名解析[0], "键": 名解析[0] 如果 别名[0] == 空 否则 别名[0]}, 别名[1]]

函数 _SQL子集_解析别名(记号们, 位)：
    令 有 = _SQL子集_吃关键字(记号们, 位, "as")
    如果 有[0]：
        返回 _SQL子集_要名字(记号们, 有[1], "AS 后面要别名")
    返回 [空, 位]

函数 _SQL子集_解析INSERT(记号们, 位)：
    令 新位 = _SQL子集_要关键字(记号们, 位, "insert")
    新位 = _SQL子集_要关键字(记号们, 新位, "into")
    令 表解析 = _SQL子集_要名字(记号们, 新位, "INSERT INTO 后面要表名")
    令 表名 = 表解析[0]
    新位 = 表解析[1]
    令 列们 = 空
    令 有列 = _SQL子集_吃符号(记号们, 新位, "(")
    如果 有列[0]：
        新位 = 有列[1]
        列们 = []
        当 真：
            令 名解析 = _SQL子集_要名字(记号们, 新位, "列清单里要列名")
            列们.追加(名解析[0])
            新位 = 名解析[1]
            令 步 = _SQL子集_吃符号(记号们, 新位, ",")
            如果 步[0]：
                新位 = 步[1]
            否则：
                中断
        新位 = _SQL子集_要符号(记号们, 新位, ")")
    新位 = _SQL子集_要关键字(记号们, 新位, "values")
    令 组们 = []
    当 真：
        令 组解析 = _SQL子集_解析值组(记号们, 新位)
        组们.追加(组解析[0])
        新位 = 组解析[1]
        令 步 = _SQL子集_吃符号(记号们, 新位, ",")
        如果 步[0]：
            新位 = 步[1]
        否则：
            中断
    返回 [{"类": "INSERT", "表": 表名, "列们": 列们, "组们": 组们}, 新位]

函数 _SQL子集_解析值组(记号们, 位)：
    令 新位 = _SQL子集_要符号(记号们, 位, "(")
    令 项们 = []
    如果 非 (_SQL子集_看符号(记号们, 新位, ")"))：
        当 真：
            令 项解析 = _SQL子集_解析表达式(记号们, 新位)
            项们.追加(项解析[0])
            新位 = 项解析[1]
            令 步 = _SQL子集_吃符号(记号们, 新位, ",")
            如果 步[0]：
                新位 = 步[1]
            否则：
                中断
    新位 = _SQL子集_要符号(记号们, 新位, ")")
    返回 [{"项们": 项们}, 新位]

函数 _SQL子集_解析UPDATE(记号们, 位)：
    令 新位 = _SQL子集_要关键字(记号们, 位, "update")
    令 表解析 = _SQL子集_要名字(记号们, 新位, "UPDATE 后面要表名")
    令 表名 = 表解析[0]
    新位 = 表解析[1]
    新位 = _SQL子集_要关键字(记号们, 新位, "set")
    令 赋值们 = []
    当 真：
        令 名解析 = _SQL子集_要名字(记号们, 新位, "SET 里要列名")
        新位 = 名解析[1]
        新位 = _SQL子集_要符号(记号们, 新位, "=")
        令 值解析 = _SQL子集_解析表达式(记号们, 新位)
        赋值们.追加({"列": 名解析[0], "值": 值解析[0]})
        新位 = 值解析[1]
        令 步 = _SQL子集_吃符号(记号们, 新位, ",")
        如果 步[0]：
            新位 = 步[1]
        否则：
            中断
    令 条件 = 空
    令 有条件 = _SQL子集_吃关键字(记号们, 新位, "where")
    如果 有条件[0]：
        令 条件解析 = _SQL子集_解析表达式(记号们, 有条件[1])
        条件 = 条件解析[0]
        新位 = 条件解析[1]
    返回 [{"类": "UPDATE", "表": 表名, "赋值们": 赋值们, "条件": 条件}, 新位]

函数 _SQL子集_解析DELETE(记号们, 位)：
    令 新位 = _SQL子集_要关键字(记号们, 位, "delete")
    新位 = _SQL子集_要关键字(记号们, 新位, "from")
    令 表解析 = _SQL子集_要名字(记号们, 新位, "DELETE FROM 后面要表名")
    令 表名 = 表解析[0]
    新位 = 表解析[1]
    令 条件 = 空
    令 有条件 = _SQL子集_吃关键字(记号们, 新位, "where")
    如果 有条件[0]：
        令 条件解析 = _SQL子集_解析表达式(记号们, 有条件[1])
        条件 = 条件解析[0]
        新位 = 条件解析[1]
    返回 [{"类": "DELETE", "表": 表名, "条件": 条件}, 新位]

# CREATE TABLE [IF NOT EXISTS] 表 (列定义们)——类型与约束原样吃掉
函数 _SQL子集_解析CREATE(记号们, 位)：
    令 新位 = _SQL子集_要关键字(记号们, 位, "create")
    令 有如果 = 假
    令 有如果词 = _SQL子集_吃关键字(记号们, 新位, "if")
    如果 有如果词[0]：
        新位 = _SQL子集_要关键字(记号们, 有如果词[1], "not")
        新位 = _SQL子集_要关键字(记号们, 新位, "exists")
        有如果 = 真
    新位 = _SQL子集_要关键字(记号们, 新位, "table")
    令 表解析 = _SQL子集_要名字(记号们, 新位, "CREATE TABLE 后面要表名")
    令 表名 = 表解析[0]
    新位 = 表解析[1]
    新位 = _SQL子集_要符号(记号们, 新位, "(")
    令 列们 = []
    当 真：
        令 名解析 = _SQL子集_要名字(记号们, 新位, "CREATE TABLE 里要列名")
        列们.追加(名解析[0])
        新位 = 名解析[1]
        # 类型名/约束/DEFAULT 值：吃掉直到逗号或右括号（括号组配平）
        当 真：
            令 t = 记号们[新位]
            如果 (t["类"] == "字") 或 (t["类"] == "文") 或 (t["类"] == "数")：
                新位 += 1
                继续
            如果 (t["类"] == "号") 与 ((t["值"] == "(") 或 (t["值"] == "+") 或 (t["值"] == "-"))：
                新位 += 1
                如果 t["值"] == "("：
                    令 深 = 1
                    当 深 > 0：
                        令 吃 = _SQL子集_吃(记号们, 新位)
                        如果 吃[0]["类"] == "止"：
                            _SQL子集_语法错("括号没闭合")
                        如果 (吃[0]["类"] == "号") 与 (吃[0]["值"] == "(")：
                            深 += 1
                        如果 (吃[0]["类"] == "号") 与 (吃[0]["值"] == ")")：
                            深 -= 1
                        新位 = 吃[1]
                继续
            中断
        令 步 = _SQL子集_吃符号(记号们, 新位, ",")
        如果 步[0]：
            新位 = 步[1]
            继续
        中断
    新位 = _SQL子集_要符号(记号们, 新位, ")")
    返回 [{"类": "CREATE", "表": 表名, "列们": 列们, "有如果": 有如果}, 新位]

函数 _SQL子集_解析DROP(记号们, 位)：
    令 新位 = _SQL子集_要关键字(记号们, 位, "drop")
    新位 = _SQL子集_要关键字(记号们, 新位, "table")
    令 有如果 = 假
    令 有如果词 = _SQL子集_吃关键字(记号们, 新位, "if")
    如果 有如果词[0]：
        新位 = _SQL子集_要关键字(记号们, 有如果词[1], "exists")
        有如果 = 真
    令 表解析 = _SQL子集_要名字(记号们, 新位, "DROP TABLE 后面要表名")
    返回 [{"类": "DROP", "表": 表解析[0], "有如果": 有如果}, 表解析[1]]

# ALTER TABLE 表 ADD [COLUMN] 列 类型 —— 只认「加列」，其余形态明确报错。
#
# 类型那一段**整段吃掉**（我们的表没有类型，字段只管名字）。吃掉之后返回
# 「已到末尾」，否则 `解析一条` 会报「后面还有多余的词」。
函数 _SQL子集_解析ALTER(记号们, 位)：
    令 新位 = _SQL子集_要关键字(记号们, 位, "alter")
    新位 = _SQL子集_要关键字(记号们, 新位, "table")
    令 表解析 = _SQL子集_要名字(记号们, 新位, "ALTER TABLE 后面要表名")
    新位 = _SQL子集_要关键字(记号们, 表解析[1], "add")
    令 有列词 = _SQL子集_吃关键字(记号们, 新位, "column")
    如果 有列词[0]：
        新位 = 有列词[1]
    令 名解析 = _SQL子集_要名字(记号们, 新位, "ADD 后面要列名")
    返回 [{"类": "ALTER", "表": 表解析[0], "列": 名解析[0]}, 长度(记号们) - 1]

# ---------- 求值（SQLite 三值逻辑；参数们显式传）----------

# 文本转数字（SQLite 规则：转不动算 0）
函数 _SQL子集_文本数(v)：
    令 s = v.去空白()
    如果 s == ""：
        返回 0
    尝试：
        返回 整数(s)
    捕获 异常 为 e：
        尝试：
            返回 小数(s)
        捕获 异常 为 e：
            返回 0

# 算术/真值判断里的数字化
函数 _SQL子集_数字化(v)：
    令 种类 = 类型(v)
    如果 (种类 == "整数") 或 (种类 == "小数")：
        返回 v
    如果 种类 == "布尔"：
        返回 1 如果 v 否则 0
    如果 种类 == "文本"：
        返回 _SQL子集_文本数(v)
    返回 0

# 三值化：空→空；数字按非 0；文本按转数字；其余非空为真
函数 _SQL子集_真值(v)：
    如果 v == 空：
        返回 空
    令 种类 = 类型(v)
    如果 种类 == "布尔"：
        返回 v
    如果 (种类 == "整数") 或 (种类 == "小数")：
        返回 v != 0
    如果 种类 == "文本"：
        返回 _SQL子集_文本数(v) != 0
    返回 真

函数 _SQL子集_三值非(v)：
    如果 v == 空：
        返回 空
    返回 非 v

函数 _SQL子集_取参数(序, 参数们)：
    如果 (序 < 0) 或 (序 >= 长度(参数们))：
        _SQL子集_语法错(`第 {序 + 1} 个 ? 没有对应的参数（参数们只给了 {长度(参数们)} 个）`)
    返回 参数们[序]

函数 _SQL子集_求值(树, 行, 字段们, 参数们)：
    令 种类 = 树["类"]
    如果 种类 == "字面量"：
        返回 树["值"]
    如果 种类 == "参数"：
        返回 _SQL子集_取参数(树["序"], 参数们)
    如果 种类 == "列"：
        令 名 = _SQL子集_找列名(字段们, 树["名"])
        返回 行[名]
    如果 种类 == "非"：
        返回 _SQL子集_三值非(_SQL子集_真值(_SQL子集_求值(树["子"], 行, 字段们, 参数们)))
    如果 种类 == "与"：
        令 左 = _SQL子集_真值(_SQL子集_求值(树["左"], 行, 字段们, 参数们))
        如果 左 == 假：
            返回 假
        令 右 = _SQL子集_真值(_SQL子集_求值(树["右"], 行, 字段们, 参数们))
        如果 右 == 假：
            返回 假
        如果 (左 == 空) 或 (右 == 空)：
            返回 空
        返回 真
    如果 种类 == "或"：
        令 左 = _SQL子集_真值(_SQL子集_求值(树["左"], 行, 字段们, 参数们))
        如果 左 == 真：
            返回 真
        令 右 = _SQL子集_真值(_SQL子集_求值(树["右"], 行, 字段们, 参数们))
        如果 右 == 真：
            返回 真
        如果 (左 == 空) 或 (右 == 空)：
            返回 空
        返回 假
    如果 种类 == "比较"：
        令 左 = _SQL子集_求值(树["左"], 行, 字段们, 参数们)
        令 右 = _SQL子集_求值(树["右"], 行, 字段们, 参数们)
        如果 (左 == 空) 或 (右 == 空)：
            返回 空
        令 序 = _值库_比较(左, 右)
        令 符 = 树["符"]
        如果 符 == "="：
            返回 序 == 0
        如果 符 == "!="：
            返回 序 != 0
        如果 符 == "<"：
            返回 序 < 0
        返回 序 > 0   # ">"
    如果 种类 == "IS"：
        令 左 = _SQL子集_求值(树["左"], 行, 字段们, 参数们)
        如果 树["取非"]：
            返回 左 != 空
        返回 左 == 空
    如果 种类 == "LIKE"：
        返回 _SQL子集_LIKE值(树, 行, 字段们, 参数们)
    如果 种类 == "IN"：
        返回 _SQL子集_IN值(树, 行, 字段们, 参数们)
    如果 种类 == "算"：
        令 左 = _SQL子集_求值(树["左"], 行, 字段们, 参数们)
        令 右 = _SQL子集_求值(树["右"], 行, 字段们, 参数们)
        如果 (左 == 空) 或 (右 == 空)：
            返回 空
        令 a = _SQL子集_数字化(左)
        令 b = _SQL子集_数字化(右)
        令 符 = 树["符"]
        如果 符 == "+"：
            返回 a + b
        如果 符 == "-"：
            返回 a - b
        如果 符 == "*"：
            返回 a * b
        # "/"：SQLite 整数/整数是整除；除 0 → 空
        如果 b == 0：
            返回 空
        令 a整 = 类型(a) == "整数"
        令 b整 = 类型(b) == "整数"
        如果 a整 与 b整：
            返回 a // b
        返回 a / b
    如果 种类 == "负"：
        令 v = _SQL子集_求值(树["子"], 行, 字段们, 参数们)
        如果 v == 空：
            返回 空
        返回 -(_SQL子集_数字化(v))
    返回 空

# 列名匹配（求值期）：字段们列表里找
函数 _SQL子集_找列名(字段们, 名字)：
    如果 名字.小写() == "id"：
        返回 "id"
    令 名 = _SQL子集_找名字(字段们, 名字)
    如果 名 != 空：
        返回 名
    _SQL子集_语义错(`no such column: {名字}`)

函数 _SQL子集_命中(树, 行, 字段们, 参数们)：
    返回 _SQL子集_真值(_SQL子集_求值(树, 行, 字段们, 参数们)) == 真

# LIKE：% 任意串、_ 单字符、大小写不敏感（ASCII 小写后比）
函数 _SQL子集_LIKE模式(p)：
    令 段们 = []
    遍历 ch 在 p：
        如果 ch == "%"：
            段们.追加(".*")
        否则如果 ch == "_"：
            段们.追加(".")
        否则：
            令 n = 序数(ch)
            如果 (n == 92) 或 (ch 在 ".+*?()[]{}|^$")：
                段们.追加(_SQL子集_斜杠)
            段们.追加(ch)
    返回 文本库.拼接(段们, "") + "$"

函数 _SQL子集_LIKE一次(值, 模式)：
    如果 (值 == 空) 或 (模式 == 空)：
        返回 空
    令 v = 值 如果 类型(值) == "文本" 否则 文本(值)
    令 p = 模式 如果 类型(模式) == "文本" 否则 文本(模式)
    返回 正则.匹配(_SQL子集_LIKE模式(p.小写()), v.小写())

函数 _SQL子集_LIKE值(树, 行, 字段们, 参数们)：
    令 值 = _SQL子集_求值(树["左"], 行, 字段们, 参数们)
    令 模式 = _SQL子集_求值(树["模式"], 行, 字段们, 参数们)
    令 结 = _SQL子集_LIKE一次(值, 模式)
    如果 树["取非"]：
        返回 _SQL子集_三值非(结)
    返回 结

函数 _SQL子集_IN值(树, 行, 字段们, 参数们)：
    令 左 = _SQL子集_求值(树["左"], 行, 字段们, 参数们)
    令 命中 = 假
    令 见空 = 假
    遍历 项 在 树["项们"]：
        令 v = _SQL子集_求值(项, 行, 字段们, 参数们)
        如果 v == 空：
            见空 = 真
        否则如果 左 != 空：
            如果 _值库_比较(左, v) == 0：
                命中 = 真
                中断
    令 结 = 假
    如果 命中：
        结 = 真
    否则如果 (左 == 空) 或 见空：
        结 = 空
    如果 树["取非"]：
        返回 _SQL子集_三值非(结)
    返回 结

# ---------- 执行 ----------

函数 _SQL子集_执行(状态, SQL, 参数们)：
    # 参数们只收 列表/元组/空：给字符串会变成「按字符绑 ?」，静默错
    如果 (参数们 != 空) 与 (类型(参数们) != "列表") 与 (类型(参数们) != "元组"):
        抛出 值错误(`「参数们」要一个**列表**（每个 ? 对应一项），来的是「{类型(参数们)}」`)
    令 参数列表 = 参数们 如果 参数们 != 空 否则 []
    令 树 = _SQL子集_解析一条(SQL, 参数列表)
    如果 树["类"] == "SELECT"：
        抛出 值错误("「执行」只跑写操作的 SQL；你给的是 SELECT")
    返回 _SQL子集_跑写(状态, 树, 参数列表)

函数 _SQL子集_查询(状态, SQL, 参数们)：
    # 参数们只收 列表/元组/空：给字符串会变成「按字符绑 ?」，静默错
    如果 (参数们 != 空) 与 (类型(参数们) != "列表") 与 (类型(参数们) != "元组"):
        抛出 值错误(`「参数们」要一个**列表**（每个 ? 对应一项），来的是「{类型(参数们)}」`)
    令 参数列表 = 参数们 如果 参数们 != 空 否则 []
    令 树 = _SQL子集_解析一条(SQL, 参数列表)
    如果 树["类"] != "SELECT"：
        # 实测内置措辞
        抛出 值错误("「执行查询」只跑 SELECT；你给的不是 SELECT")
    返回 _SQL子集_跑查询(状态, 树, 参数列表)

函数 _SQL子集_跑写(状态, 树, 参数们)：
    如果 树["类"] == "INSERT"：
        返回 _SQL子集_跑INSERT(状态, 树, 参数们)
    如果 树["类"] == "UPDATE"：
        返回 _SQL子集_跑UPDATE(状态, 树, 参数们)
    如果 树["类"] == "DELETE"：
        返回 _SQL子集_跑DELETE(状态, 树, 参数们)
    如果 树["类"] == "CREATE"：
        返回 _SQL子集_跑CREATE(状态, 树)
    如果 树["类"] == "ALTER"：
        返回 _SQL子集_跑ALTER(状态, 树)
    返回 _SQL子集_跑DROP(状态, 树)

# ALTER TABLE ADD COLUMN：加一列（老行补空），并**记日志**（否则重开就没了）。
函数 _SQL子集_跑ALTER(状态, 树)：
    令 找到 = _SQL子集_要表(状态, 树["表"])
    令 表名 = 找到[0]
    令 表 = 找到[1]
    令 列 = 树["列"]
    如果 列.小写() == "id":
        _SQL子集_语法错("id 是自动给的，不用加")
    遍历 名 在 表["字段们"]：
        如果 名.小写() == 列.小写()：
            抛出 运行期错误(`数据库操作失败：duplicate column name: {列}`)
    表["字段们"].追加(列)
    遍历 行 在 表["记录们"]：
        行[列] = 空
    _引擎_记日志(状态, {"操作": "加列", "表": 表名, "列": 列})
    返回 状态["上次数"]

# 表名匹配（大小写不敏感）；不存在报 SQLite 同款
函数 _SQL子集_要表(状态, 表名)：
    令 名 = _SQL子集_找名字(状态["表们"].键(), 表名)
    如果 名 == 空：
        _SQL子集_语义错(`no such table: {表名}`)
    返回 [名, 状态["表们"][名]]

函数 _SQL子集_整数限值(树, 参数们)：
    令 v = _SQL子集_求值(树, {}, [], 参数们)
    如果 v == 空：
        返回 空
    令 种类 = 类型(v)
    如果 种类 == "整数"：
        返回 v
    如果 种类 == "小数"：
        返回 整数(v)
    _SQL子集_语法错("LIMIT/OFFSET 要一个整数")

# INSERT：无列清单时列序 = id + 字段们（SQLite 表定义里 id 是第一列）
# 全部行无显式 id → 走批量插入（一条日志、整批原子）；单行带 id → 插入带id
函数 _SQL子集_跑INSERT(状态, 树, 参数们)：
    令 找到 = _SQL子集_要表(状态, 树["表"])
    令 表名 = 找到[0]
    令 表 = 找到[1]
    # ⚠️ 没有列清单时解析器给的是 `空`（不是空列表）—— 别对它直接取长度
    令 有列清单 = (树["列们"] != 空) 与 (长度(树["列们"]) > 0)
    令 目标列们 = []
    如果 有列清单：
        遍历 c 在 树["列们"]：
            目标列们.追加(_SQL子集_找列(表, c))
    令 n列 = 长度(目标列们)
    令 记录们 = []
    令 id们 = []
    遍历 组 在 树["组们"]：
        令 值们 = []
        遍历 树表 在 组["项们"]：
            值们.追加(_SQL子集_求值(树表, {}, [], 参数们))
        # 没有列清单：按值个数判断（见上面第 ⑮ 条）
        如果 非 有列清单：
            如果 长度(值们) == 长度(表["字段们"]) + 1:
                目标列们 = ["id"] + 表["字段们"]
            否则如果 长度(值们) == 长度(表["字段们"]):
                目标列们 = 表["字段们"]
            否则：
                目标列们 = ["id"] + 表["字段们"]
            n列 = 长度(目标列们)
        如果 长度(值们) != n列：
            _SQL子集_语法错(`表 {表名} 有 {n列} 列，VALUES 给了 {长度(值们)} 个值`)
        令 记录 = {}
        令 显 = 空
        遍历 i 在 范围(n列)：
            令 列 = 目标列们[i]
            令 v = 值们[i]
            如果 列 == "id"：
                如果 v != 空：
                    令 种类 = 类型(v)
                    如果 种类 != "整数"：
                        _SQL子集_语法错("id 要给整数")
                    显 = v
            否则：
                记录[列] = _值库_校验值(列, v)
        记录们.追加(记录)
        id们.追加(显)
    令 n = 长度(记录们)
    令 有id = 假
    遍历 idv 在 id们：
        如果 idv != 空：
            有id = 真
    如果 (n == 1) 与 (id们[0] != 空)：
        _引擎_插入带id(状态, 表名, 记录们[0], id们[0])
        返回 1
    如果 非 有id：
        _引擎_批量插入(状态, 表名, 记录们)
        返回 n
    # 混合显式 id：逐行执行（偏差：不整批原子，文档写明）
    遍历 i 在 范围(n)：
        如果 id们[i] != 空：
            _引擎_插入带id(状态, 表名, 记录们[i], id们[i])
        否则：
            _引擎_插入(状态, 表名, 记录们[i])
    状态["上次数"] = n
    返回 n

# UPDATE：逐个赋值生效（右边看到同行已赋的列）；唯一约束先全查，语句级原子
函数 _SQL子集_跑UPDATE(状态, 树, 参数们)：
    令 找到 = _SQL子集_要表(状态, 树["表"])
    令 表名 = 找到[0]
    令 表 = 找到[1]
    令 字段们 = 表["字段们"]
    令 赋值们 = []
    遍历 对 在 树["赋值们"]：
        令 列 = _SQL子集_找列(表, 对["列"])
        赋值们.追加({"列": 列, "树": 对["值"]})
    令 们 = 表["记录们"]
    如果 树["条件"] != 空：
        令 全字段 = ["id"] + 字段们
        们 = [行 遍历 行 在 们 如果 _SQL子集_命中(树["条件"], 行, 全字段, 参数们)]
    令 改们 = []
    遍历 行 在 们：
        令 试 = {}
        遍历 f 在 行.键()：
            试[f] = 行[f]
        令 新值 = {}
        遍历 赋 在 赋值们：
            令 v = _SQL子集_求值(赋["树"], 试, 字段们, 参数们)
            v = _值库_校验值(赋["列"], v)
            新值[赋["列"]] = v
            试[赋["列"]] = v
        改们.追加({"行": 行, "新值": 新值})
    # 语句级预检（SQLite 同款）：撞不在改动列表里的行、语句内两行改成同值，都报 UNIQUE
    令 预占们 = []
    遍历 映射项 在 表["映射们"]：
        预占们.追加({})
    遍历 对 在 改们：
        遍历 i 在 范围(长度(表["映射们"]))：
            令 映射项 = 表["映射们"][i]
            如果 非 映射项["唯一"]：
                继续
            如果 非 _索引_涉及(映射项, 对["新值"])：
                继续
            令 新键 = _索引_键文本(映射项["字段们"], _索引_改后行(对["行"], 对["新值"]))
            如果 新键 == 空：
                继续
            如果 新键 在 预占们[i]：
                _索引_抛冲突(表名, 映射项["字段们"])
            预占们[i][新键] = 对["行"]["id"]
            令 旧 = 映射项["映射"].获取(新键, 空)
            如果 (旧 != 空) 与 (旧["id"] != 对["行"]["id"])：
                _索引_抛冲突(表名, 映射项["字段们"])
    # 先更新索引映射（旧键要从改前状态算），再改行里的字段
    遍历 对 在 改们：
        _索引_改行(表, 对["行"], 对["新值"])
    遍历 对 在 改们：
        遍历 键 在 对["新值"].键()：
            对["行"][键] = 对["新值"][键]
        # 改 id 的行：自增指针推进到 max
        如果 "id" 在 对["新值"]：
            如果 对["新值"]["id"] >= 表["下一个id"]：
                表["下一个id"] = 对["新值"]["id"] + 1
    如果 长度(改们) > 0：
        令 日改们 = []
        遍历 对 在 改们：
            令 编 = {}
            遍历 键 在 对["新值"].键()：
                如果 键 == "id"：
                    编["id"] = 对["新值"]["id"]
                否则：
                    编[键] = _值库_编码(对["新值"][键])
            日改们.追加({"id": 对["行"]["id"], "新值": 编})
        _引擎_记日志(状态, {"操作": "改行", "表": 表名, "改们": 日改们})
    状态["上次数"] = 长度(改们)
    返回 长度(改们)

函数 _SQL子集_跑DELETE(状态, 树, 参数们)：
    令 找到 = _SQL子集_要表(状态, 树["表"])
    令 表名 = 找到[0]
    令 表 = 找到[1]
    令 们 = 表["记录们"]
    如果 树["条件"] != 空：
        令 全字段 = ["id"] + 表["字段们"]
        们 = [行 遍历 行 在 们 如果 _SQL子集_命中(树["条件"], 行, 全字段, 参数们)]
    令 id们 = []
    令 删集 = {}
    遍历 行 在 们：
        id们.追加(行["id"])
        删集[行["id"]] = 真
        _索引_删行(表, 行)
    表["记录们"] = [行 遍历 行 在 表["记录们"] 如果 非 (行["id"] 在 删集)]
    如果 长度(id们) > 0：
        _引擎_记日志(状态, {"操作": "删行", "表": 表名, "id们": id们})
    状态["上次数"] = 长度(id们)
    返回 长度(id们)

函数 _SQL子集_跑CREATE(状态, 树)：
    令 名单 = []
    令 已见 = {}
    遍历 列名 在 树["列们"]：
        # id 列内置自动给，跳过（与内置模块的隐含 id 一致）
        如果 列名.小写() == "id"：
            继续
        令 小 = 列名.小写()
        如果 小 在 已见：
            抛出 运行期错误(`数据库操作失败：duplicate column name: {列名}`)
        已见[小] = 真
        名单.追加(列名)
    令 找到 = _SQL子集_找名字(状态["表们"].键(), 树["表"])
    如果 找到 != 空：
        如果 树["有如果"]：
            返回 状态["上次数"]
        抛出 运行期错误(`数据库操作失败：table {树["表"]} already exists`)
    如果 长度(名单) == 0：
        _SQL子集_语法错("CREATE TABLE 至少要一个 id 以外的列")
    _引擎_建表(状态, 树["表"], 名单)
    # 实测内置：CREATE 不改 changes()，返回上一条 DML 的行数
    返回 状态["上次数"]

函数 _SQL子集_跑DROP(状态, 树)：
    令 找到 = _SQL子集_找名字(状态["表们"].键(), 树["表"])
    如果 找到 == 空：
        如果 树["有如果"]：
            返回 状态["上次数"]
        抛出 运行期错误(`数据库操作失败：no such table: {树["表"]}`)
    _引擎_删表(状态, 找到)
    # 实测内置：DROP 不改 changes()，返回上一条 DML 的行数
    返回 状态["上次数"]

# SELECT：普通行输出 / 分组聚合输出（COUNT），ORDER BY 多键 + LIMIT/OFFSET
函数 _SQL子集_跑查询(状态, 树, 参数们)：
    令 找到 = _SQL子集_要表(状态, 树["表"])
    令 表 = 找到[1]
    令 字段们 = ["id"] + 表["字段们"]
    令 行们 = 表["记录们"]
    如果 树["条件"] != 空：
        行们 = [行 遍历 行 在 行们 如果 _SQL子集_命中(树["条件"], 行, 字段们, 参数们)]
    令 全 = 树["全部"]
    令 列们 = 树["列们"]
    令 有聚合 = 假
    如果 非 全：
        遍历 列 在 列们：
            如果 列["聚合"]：
                有聚合 = 真
    # 混列检查只管没有 GROUP BY 的情况；有 GROUP BY 时分组列 + 聚合是合法搭配
    如果 (非 全) 与 (长度(树["分组"]) == 0)：
        遍历 列 在 列们：
            如果 列["聚合"] != 有聚合：
                _SQL子集_语法错("COUNT 和普通列不能混在同一个 SELECT 里（子集不支持）")
    令 输出们 = []
    如果 有聚合 或 (长度(树["分组"]) > 0)：
        输出们 = _SQL子集_聚合输出(树, 表, 行们, 有聚合)
        # 实测内置：GROUP BY 的组按组键序输出（无 ORDER BY 时也是；组键序=_值库_比较 序）
        如果 (长度(树["分组"]) > 0) 与 (长度(输出们) > 1)：
            令 组键们 = []
            遍历 g 在 树["分组"]：
                组键们.追加({"字段": g, "倒": 假})
            输出们 = _排序_执行(输出们, 组键们)
        # 聚合输出按输出键排序（别名或原文键；排序键必须出现在输出里）
        如果 (长度(树["序们"]) > 0) 与 (长度(输出们) > 0)：
            令 键们 = []
            遍历 序 在 树["序们"]：
                如果 序.获取("行号", 假)：
                    继续
                令 键 = _SQL子集_找名字(输出们[0].键(), 序["名"])
                如果 键 == 空：
                    _SQL子集_语义错(`no such column: {序["名"]}`)
                键们.追加({"字段": 键, "倒": 序["倒"]})
            如果 长度(键们) > 0：
                输出们 = _排序_执行(输出们, 键们)
    否则：
        # 普通输出：先按整行排序（SQLite 同款，可用输出里没有的列与 id），再投影
        如果 长度(树["序们"]) > 0：
            令 键们 = []
            遍历 序 在 树["序们"]：
                如果 序.获取("行号", 假)：
                    继续
                键们.追加({"字段": _SQL子集_找列(表, 序["名"]), "倒": 序["倒"]})
            如果 长度(键们) > 0：
                行们 = _排序_执行(行们, 键们)
        输出们 = _SQL子集_普通输出(树, 表, 行们)
    令 偏树 = 树["偏"]
    如果 偏树 != 空：
        令 偏 = _SQL子集_整数限值(偏树, 参数们)
        如果 偏 > 0：
            如果 偏 >= 长度(输出们)：
                输出们 = []
            否则：
                输出们 = 输出们[偏:]
    令 界树 = 树["界"]
    如果 界树 != 空：
        令 界 = _SQL子集_整数限值(界树, 参数们)
        如果 (界 >= 0) 与 (界 < 长度(输出们))：
            输出们 = 输出们[0:界]
    返回 输出们

# 输出列解析错误靠找列报 no such column；普通列的值直接取
函数 _SQL子集_普通输出(树, 表, 行们)：
    令 输出们 = []
    如果 树["全部"]：
        遍历 行 在 行们：
            令 出 = {}
            出["id"] = 行["id"]
            遍历 f 在 表["字段们"]：
                出[f] = 行[f]
            输出们.追加(出)
    否则：
        遍历 行 在 行们：
            令 出 = {}
            遍历 列 在 树["列们"]：
                令 真名 = _SQL子集_找列(表, 列["列"])
                出[列["键"]] = 行[真名]
            输出们.追加(出)
    返回 输出们

# 分组聚合：输出 = 分组列（原文键）+ COUNT 列（原文键 COUNT(*)/COUNT(名)）
函数 _SQL子集_聚合输出(树, 表, 行们, 有聚合)：
    令 分组列们 = []
    遍历 g 在 树["分组"]：
        分组列们.追加(_SQL子集_找列(表, g))
    # 校验聚合列与普通列（普通列必须是分组列）
    遍历 列 在 树["列们"]：
        如果 列["聚合"]：
            如果 列["列"] != 空：
                _SQL子集_找列(表, 列["列"])
        否则：
            令 真名 = _SQL子集_找列(表, 列["列"])
            令 在分组 = 假
            遍历 i 在 范围(长度(分组列们))：
                如果 分组列们[i] == 真名：
                    在分组 = 真
            如果 非 在分组：
                _SQL子集_语法错(`SELECT 里的「{列["列"]}」要先 GROUP BY`)
    令 组们 = {}
    令 顺序 = []
    遍历 行 在 行们：
        令 键段们 = []
        遍历 g 在 分组列们：
            键段们.追加(json.转文本(_值库_编码(行[g])))
        令 键 = json.转文本(键段们)
        如果 键 不在 组们：
            组们[键] = []
            顺序.追加(键)
        组们[键].追加(行)
    # 无 GROUP BY 的纯聚合：空表也出一行（COUNT(*)=0，SQLite 同款）
    如果 (长度(树["分组"]) == 0) 与 (长度(顺序) == 0)：
        组们[""] = []
        顺序.追加("")
    令 输出们 = []
    遍历 键 在 顺序：
        令 组行们 = 组们[键]
        令 出 = {}
        遍历 i 在 范围(长度(树["分组"]))：
            出[树["分组"][i]] = 组行们[0][分组列们[i]]
        遍历 列 在 树["列们"]：
            如果 列["聚合"]：
                如果 列["全"]：
                    出[列["键"]] = 长度(组行们)
                否则：
                    令 真名 = _SQL子集_找列(表, 列["列"])
                    令 n = 0
                    遍历 行 在 组行们：
                        如果 行[真名] != 空：
                            n += 1
                    出[列["键"]] = n
        输出们.追加(出)
    返回 输出们

# 列匹配：id 列特殊（行的字典里有）；找不到报 no such column（SQLite 同款）
函数 _SQL子集_找列(表, 名字)：
    如果 名字.小写() == "id"：
        返回 "id"
    令 名 = _SQL子集_找名字(表["字段们"], 名字)
    如果 名 != 空：
        返回 名
    _SQL子集_语义错(`no such column: {名字}`)


# ===== 原 引擎.jsh =====
# 引擎 —— 库注册表 + 15 个 API 的核心逻辑
# 兼容基准（设计.md §五）：错误消息逐字复刻；有意偏差见 §5.8/§5.13
# 注册表按绝对路径共享状态（同一路径重复打开=同一份；关闭其一全部失效）


_引擎_注册表 = {}

# ---------- 概貌（报错消息里的值显示，复刻语言显示规则的容器形态） ----------

函数 _引擎_概貌(值)：
    令 类名 = 类型(值)
    如果 类名 == "空"：
        返回 "空"
    如果 类名 == "布尔"：
        返回 "真" 如果 值 否则 "假"
    如果 (类名 == "整数") 或 (类名 == "小数")：
        返回 文本(值)
    如果 类名 == "字节"：
        返回 _引擎_字节概貌(值)
    如果 类名 == "文本"：
        返回 "'" + 值 + "'"
    如果 类名 == "列表"：
        令 段们 = []
        遍历 项 在 值：
            段们.追加(_引擎_概貌(项))
        返回 "[" + 文本库.拼接(段们, ", ") + "]"
    如果 类名 == "字典"：
        令 段们 = []
        遍历 键 在 值.键()：
            段们.追加(_引擎_概貌(键) + ": " + _引擎_概貌(值[键]))
        返回 "{" + 文本库.拼接(段们, ", ") + "}"
    返回 文本(值)

函数 _引擎_字节概貌(值)：
    令 总 = 长度(值)
    令 个 = 总 如果 总 <= 16 否则 16
    令 十六 = 编码.十六进制编码(值[0:个], 真)
    令 段们 = []
    令 i = 0
    当 i < 长度(十六)：
        段们.追加(十六[i:i + 2])
        i += 2
    如果 总 > 16：
        返回 `字节({文本库.拼接(段们, " ")} … 共 {总} 个字节)`
    返回 `字节({文本库.拼接(段们, " ")})`

# ---------- 打开 / 关闭 / 句柄 ----------

函数 _引擎_表名文本(表名)：
    返回 表名 如果 类型(表名) == "文本" 否则 文本(表名)

# 从原始路径文本推导父目录（保留调用方的分隔符写法——内置报错消息里路径原样）
函数 _引擎_父目录文本(p)：
    令 反斜杠 = 字符(92)
    令 i = -1
    令 n = 长度(p)
    遍历 j 在 范围(n)：
        令 c = p[j]
        如果 (c == "/") 或 (c == 反斜杠)：
            i = j
    如果 i < 0：
        返回 ""
    返回 p[0:i]

函数 _引擎_打开(路径文本)：
    令 无盘 = (长度(路径文本) == 0) 或 (路径文本 == ":memory:")
    如果 非 无盘：
        令 父 = _引擎_父目录文本(路径文本)
        如果 (父 != "") 与 (父 != ".")：
            如果 非 (路径.存在(父))：
                抛出 文件错误(`目录不存在，建不了库：「{父}」`)
    令 键 = "" 如果 无盘 否则 路径.绝对路径(路径文本)
    如果 键 在 _引擎_注册表：
        返回 路径文本
    令 状态 = {"句柄": 路径文本, "路径": 键, "无盘": 无盘, "表们": {}, "日志行数": 0, "上次数": 0, "事务": 空}
    如果 非 无盘：
        令 载入 = _存储器_读快照(键)
        如果 载入 != 空：
            状态["表们"] = 载入["表们"]
        否则：
            # 新库（或空文件）：落一个只有头的快照——打开即有文件，与内置一致
            _存储器_写快照(键, {})
            # 🔴 M212：**顺手清掉孤儿日志**。关闭不再紧凑之后，库的数据可能还躺在
            #    `<库>.log` 里；用户「把 .db 删掉重来」时，日志还在 —— 不清的话
            #    `打开` 会把它重放回来，「删了库还是一条不少」。
            #    走到这里说明**快照文件不存在或为空** ⇒ 这份日志一定是孤儿
            #    （紧凑的顺序永远是「先写快照、再清日志」）。
            令 孤儿 = _存储器_日志路径(键)
            如果 文件.文件存在(孤儿)：
                文件.原子写(孤儿, "")
        状态["日志行数"] = _存储器_重放(状态)
        # 旧快照没有「上次数」键（执行 的返回值基准），补 0
        如果 "上次数" 不在 状态：
            状态["上次数"] = 0
        # M202b：事务状态。快照格式没变 —— 它是**运行期**的东西，不落盘。
        状态["事务"] = 空
        遍历 表名 在 状态["表们"].键()：
            _索引_重建(状态["表们"][表名], 表名)
        _存储器_加锁(状态)
    _引擎_注册表[键] = 状态
    返回 路径文本

函数 _引擎_句柄状态(句柄)：
    令 键 = _引擎_库键(句柄)
    如果 键 在 _引擎_注册表：
        返回 _引擎_注册表[键]
    抛出 值错误(`这个库还没打开：「{句柄}」（先用 令 库 = 数据库.打开("路径") 打开，再把「库」传给后面的函数）`)

函数 _引擎_关闭(句柄)：
    令 键 = _引擎_库键(句柄)
    如果 键 在 _引擎_注册表：
        令 状态 = _引擎_注册表[键]
        _引擎_注册表.弹出(键)
        # 🔴 开着事务就关：**丢掉没提交的改动**（SQLite 关连接也是这个行为）。
        #    不丢的话「开始 → 改 → 忘了提交就关」会留下半截改动，
        #    下次打开看到的是一个用户从没确认过的状态。
        #    ⚠️ M212 起关闭**不再紧凑**，所以这里必须像 `回滚` 一样把日志**截回去** ——
        #       否则那半截改动还躺在日志里，下次打开一重放就变成「真的提交了」。
        如果 状态["事务"] != 空：
            令 快照 = 状态["事务"]
            状态["表们"] = 快照["备份"]
            遍历 名 在 状态["表们"].键()：
                _索引_重建(状态["表们"][名], 名)
            _存储器_截断日志(状态, 快照["日志起点"])
            状态["日志行数"] = 快照["日志起点"]
            状态["事务"] = 空
        # 🔴 M212：**关闭不紧凑**。原来关闭要把内存里的 2 万行整份重新编码 + 重写快照
        #    （实测 126.7 ms），而这份工作下一轮插入时迟早会做（日志超阈值）。
        #    现在只做两件必须做的事：把日志句柄关掉、清锁。实测 **~1 ms**。
        #    代价：日志留着，下次打开要重放（最多 4096 行，约 8 ms）。
        _存储器_关日志(状态)
        _存储器_清锁(状态)
    # 幂等：没打开过 / 已关过 都不报错

# ---------- 表级 ----------

函数 _引擎_表状态(状态, 表名)：
    令 名 = _引擎_表名文本(表名)
    如果 名 在 状态["表们"]：
        返回 状态["表们"][名]
    令 现 = 状态["表们"].键()
    如果 长度(现) == 0:
        抛出 值错误(`没有表「{名}」（这个库还是空的，先 数据库.建表）`)
    抛出 值错误(`没有表「{名}」（现在有这些表：{文本库.拼接(现.排序按(函数(x)：x), "、")}）`)

函数 _引擎_校验字段们(表名, 名单, 字段集合)：
    令 缺的 = []
    遍历 字段 在 名单：
        如果 字段 不在 字段集合：
            缺的.追加(字段)
    如果 长度(缺的) > 0：
        缺的 = 缺的.排序按(_条件_排序键)
        抛出 值错误(`表「{表名}」里没有这些字段：{文本库.拼接(缺的, "、")}`)

函数 _引擎_建表(状态, 表名, 字段们)：
    令 名 = _引擎_表名文本(表名)
    如果 名 在 状态["表们"]：
        返回
    # 兼容：单个字符串 ≡ 单元素列表（native 的 `裸名们` 就这么放）
    如果 类型(字段们) == "文本"：
        字段们 = [字段们]
    如果 (类型(字段们) != "列表") 与 (类型(字段们) != "元组")：
        抛出 值错误(`表「{名}」的字段们要给一个非空的字段名列表，例如 ["金额"]`)
    如果 长度(字段们) == 0：
        抛出 值错误(`表「{名}」的字段们要给一个非空的字段名列表`)
    令 名单 = []
    遍历 元 在 字段们：
        令 字段 = 元 如果 类型(元) == "文本" 否则 文本(元)
        如果 字段 == "id":
            抛出 值错误("字段名里不用写 id —— 每张表都自带 id（把 id 从字段列表里去掉）")
        名单.追加(字段)
    令 已见 = {}
    遍历 字段 在 名单：
        如果 字段 在 已见：
            抛出 运行期错误(`数据库操作失败：duplicate column name: {字段}`)
        已见[字段] = 真
    状态["表们"][名] = _存储器_新表状态(名单)
    _引擎_记日志(状态, {"操作": "建表", "表": 名, "字段们": 名单})

# 删表（DROP TABLE 用）：表必须存在，否则报 SQLite 同款消息
函数 _引擎_删表(状态, 表名)：
    令 名 = _引擎_表名文本(表名)
    如果 名 不在 状态["表们"]：
        抛出 运行期错误(`数据库操作失败：no such table: {名}`)
    状态["表们"].弹出(名)
    _引擎_记日志(状态, {"操作": "删表", "表": 名})

函数 _引擎_表们(状态)：
    令 名单 = []
    遍历 名 在 状态["表们"].键()：
        名单.追加(名)
    返回 名单.排序按(_条件_排序键)

函数 _引擎_有表(状态, 表名)：
    返回 _引擎_表名文本(表名) 在 状态["表们"]

# ---------- 日志 ----------

函数 _引擎_编码记录(记录)：
    令 备份 = {}
    遍历 键 在 记录.键()：
        如果 键 == "id"：
            备份["id"] = 记录["id"]
        否则：
            备份[键] = _值库_编码(记录[键])
    返回 备份

函数 _引擎_记日志(状态, 条目)：
    如果 非 状态["无盘"]：
        _存储器_追加日志(状态, 条目)
    状态["日志行数"] += 1
    _存储器_写后检查(状态)

# ---------- 插入 ----------

# 校验并归一化一条记录；id 由调用方给（放在行首）
函数 _引擎_校验记录(表, 名, 记录, id)：
    如果 类型(记录) != "字典"：
        抛出 类型错误("「记录」要给一个字典（字段 → 值）")
    如果 "id" 在 记录：
        抛出 值错误("id 是自动给的，不用写")
    令 多余 = []
    遍历 字段 在 记录.键()：
        如果 字段 不在 表["字段们"]：
            多余.追加(字段)
    如果 长度(多余) > 0：
        抛出 值错误(`表「{名}」里没有这些字段：{文本库.拼接(多余.排序按(函数(x)：x), "、")}（表「{名}」里有：{文本库.拼接(表["字段们"], "、")}）`)
    如果 长度(记录.键()) == 0：
        # 有意偏差：内置这里是 SQLite 语法错（泄漏原文），我们给中文值错误
        抛出 值错误("插入的记录不能是空的，至少要给一个字段的值")
    令 行 = {"id": id}
    遍历 字段 在 表["字段们"]：
        行[字段] = 空
    遍历 字段 在 记录.键()：
        行[字段] = _值库_校验值(字段, 记录[字段])
    返回 行

函数 _引擎_插入(状态, 表名, 记录)：
    令 表 = _引擎_表状态(状态, 表名)
    令 名 = _引擎_表名文本(表名)
    令 id = 表["下一个id"]
    令 行 = _引擎_校验记录(表, 名, 记录, id)
    _索引_加行(表, 名, 行)
    表["记录们"].追加(行)
    _索引_登记(表, 行)
    表["下一个id"] = id + 1
    _引擎_记日志(状态, {"操作": "插入", "表": 名, "id": id, "记录": _引擎_编码记录(行)})
    状态["上次数"] = 1
    返回 id

# 插入带显式 id（SQL INSERT ... (id, ...) 用）
函数 _引擎_插入带id(状态, 表名, 记录, id)：
    令 表 = _引擎_表状态(状态, 表名)
    令 名 = _引擎_表名文本(表名)
    令 行 = _引擎_校验记录(表, 名, 记录, id)
    _索引_加行(表, 名, 行)
    表["记录们"].追加(行)
    _索引_登记(表, 行)
    如果 id >= 表["下一个id"]：
        表["下一个id"] = id + 1
    _引擎_记日志(状态, {"操作": "插入", "表": 名, "id": id, "记录": _引擎_编码记录(行)})
    状态["上次数"] = 1
    返回 id

# 批量插入：逐行校验+查重（与 SQLite 逐行事务一致）；任何一行失败整批回滚
函数 _引擎_批量插入(状态, 表名, 记录们)：
    令 表 = _引擎_表状态(状态, 表名)
    令 名 = _引擎_表名文本(表名)
    如果 类型(记录们) != "列表"：
        抛出 类型错误("「记录们」要给一个字典列表")
    如果 长度(记录们) == 0：
        返回 0
    令 起 = 表["下一个id"]
    令 原下一个 = 表["下一个id"]
    令 原长 = 长度(表["记录们"])
    遍历 i 在 范围(长度(记录们))：
        尝试：
            令 行 = _引擎_校验记录(表, 名, 记录们[i], 起 + i)
            _索引_加行(表, 名, 行)
            表["记录们"].追加(行)
            _索引_登记(表, 行)
            表["下一个id"] = 行["id"] + 1
        捕获 异常 为 e：
            # 回滚：记录截回原长，映射重建
            表["记录们"] = 表["记录们"][0:原长]
            _索引_重建(表, 名)
            表["下一个id"] = 原下一个
            抛出 e
    令 编码们 = []
    遍历 行 在 表["记录们"][原长:]：
        编码们.追加(_引擎_编码记录(行))
    _引擎_记日志(状态, {"操作": "批量插入", "表": 名, "起id": 起, "记录们": 编码们})
    状态["上次数"] = 长度(记录们)
    返回 长度(记录们)

# ---------- 条件 / 排序 规整 ----------

函数 _引擎_规整条件(表, 名, 条件)：
    如果 条件 == 空：
        返回 空
    如果 类型(条件) != "字典"：
        抛出 类型错误(`「条件」要给一个字典（字段 → 值），给过来的却是「{_引擎_概貌(条件)}」`)
    _条件_校验字段(名, 条件, ["id"] + 表["字段们"])
    返回 条件

函数 _引擎_规整排序(表, 名, 排序)：
    如果 排序 == 空：
        返回 []
    令 类名 = 类型(排序)
    如果 类名 == "文本"：
        如果 排序 == ""：
            返回 []
        令 名单 = [排序]
    否则如果 类名 == "列表"：
        如果 长度(排序) == 0：
            抛出 值错误(`排序字段要给一个非空的字段名列表，例如 ["金额"]`)
        令 名单 = []
        遍历 元 在 排序：
            名单.追加(元 如果 类型(元) == "文本" 否则 文本(元))
    否则：
        抛出 值错误(`排序字段要给一个非空的字段名列表，例如 ["金额"]`)
    _引擎_校验字段们(名, 名单, ["id"] + 表["字段们"])
    返回 [{"字段": s, "倒": 假} 遍历 s 在 名单]

# 条件 → 匹配行们：有可用索引走索引候选（等值 O(命中数)），否则全表扫。
# 语义与全表扫一致：候选行仍要过 _条件_满足；没有适用索引 → 空 → 全表扫
函数 _引擎_条件行们(表, 条件有效)：
    令 候选 = _索引_候选行们(表, 条件有效)
    如果 候选 != 空：
        返回 [行 遍历 行 在 候选 如果 _条件_满足(行, 条件有效)]
    返回 [行 遍历 行 在 表["记录们"] 如果 _条件_满足(行, 条件有效)]

# ---------- 查询 / 条数 ----------

函数 _引擎_查询(状态, 表名, 条件, 排序, 倒序, 条数)：
    令 表 = _引擎_表状态(状态, 表名)
    令 名 = _引擎_表名文本(表名)
    令 条件有效 = _引擎_规整条件(表, 名, 条件)
    令 键们 = _引擎_规整排序(表, 名, 排序)
    令 行们 = 表["记录们"]
    如果 条件有效 != 空：
        行们 = _引擎_条件行们(表, 条件有效)
    如果 长度(键们) > 0：
        行们 = _排序_执行(行们, 键们)
    如果 倒序：
        行们 = 反转(行们)
    如果 条数 != 空：
        如果 类型(条数) != "整数"：
            抛出 类型错误("需要整数")
        如果 条数 < 0：
            抛出 值错误(`条数要给非负整数，给的是「{条数}」`)
        # 实测内置：条数=0 → 不限制（返回全部）
        如果 (条数 > 0) 与 (条数 < 长度(行们))：
            行们 = 行们[0:条数]
    令 结果 = []
    遍历 行 在 行们：
        令 复制 = {}
        遍历 键 在 行.键()：
            复制[键] = 行[键]
        结果.追加(复制)
    返回 结果

函数 _引擎_条数(状态, 表名, 条件)：
    令 表 = _引擎_表状态(状态, 表名)
    如果 条件 == 空：
        返回 长度(表["记录们"])
    令 名 = _引擎_表名文本(表名)
    令 条件有效 = _引擎_规整条件(表, 名, 条件)
    令 候选 = _索引_候选行们(表, 条件有效)
    令 n = 0
    如果 候选 != 空：
        遍历 行 在 候选：
            如果 _条件_满足(行, 条件有效)：
                n += 1
    否则：
        遍历 行 在 表["记录们"]：
            如果 _条件_满足(行, 条件有效)：
                n += 1
    返回 n

# ---------- 修改 / 删除 ----------

函数 _引擎_校验新值(表, 名, 新值)：
    # 实测内置：新值非字典或空字典 → 类型错误「新值」要给一个非空字典
    如果 (类型(新值) != "字典") 或 (长度(新值.键()) == 0)：
        抛出 类型错误("「新值」要给一个非空字典")
    遍历 字段 在 新值.键()：
        如果 字段 == "id"：
            # 实测内置：修改里给 id → 专门消息
            抛出 值错误("id 是主键，不能改")
        如果 字段 不在 表["字段们"]：
            # 只报第一个（复刻内置）
            抛出 值错误(`表「{名}」里没有这些字段：{字段}`)
    令 新行 = {}
    遍历 字段 在 新值.键()：
        新行[字段] = _值库_校验值(字段, 新值[字段])
    返回 新行

函数 _引擎_修改(状态, 表名, 条件, 新值)：
    令 表 = _引擎_表状态(状态, 表名)
    令 名 = _引擎_表名文本(表名)
    # 实测内置校验顺序：空条件 → 新值 → 条件字段
    如果 条件 == 空：
        抛出 值错误("「修改」必须给条件")
    令 新值行 = _引擎_校验新值(表, 名, 新值)
    令 条件有效 = _引擎_规整条件(表, 名, 条件)
    如果 长度(条件有效.键()) == 0：
        抛出 值错误("「修改」必须给条件")
    令 们 = _引擎_条件行们(表, 条件有效)
    # 唯一约束先全查（语句级原子：查不中一行都不改；语句内两行改成同值也算撞）
    _索引_预检改们(表, 名, 们, 新值行)
    # 先更新索引映射（旧键要从改前状态算），再改行里的字段
    遍历 行 在 们：
        _索引_改行(表, 行, 新值行)
    遍历 行 在 们：
        遍历 字段 在 新值行.键()：
            行[字段] = 新值行[字段]
    令 改们 = []
    遍历 行 在 们：
        改们.追加({"id": 行["id"], "新值": _引擎_编码记录(新值行)})
    _引擎_记日志(状态, {"操作": "改行", "表": 名, "改们": 改们})
    状态["上次数"] = 长度(们)
    返回 长度(们)

函数 _引擎_删除(状态, 表名, 条件)：
    令 表 = _引擎_表状态(状态, 表名)
    令 名 = _引擎_表名文本(表名)
    如果 条件 == 空：
        抛出 值错误("「删除」必须给条件")
    令 条件有效 = _引擎_规整条件(表, 名, 条件)
    如果 长度(条件有效.键()) == 0：
        抛出 值错误("「删除」必须给条件")
    令 们 = _引擎_条件行们(表, 条件有效)
    令 id们 = []
    令 删集 = {}
    遍历 行 在 们：
        id们.追加(行["id"])
        删集[行["id"]] = 真
        _索引_删行(表, 行)
    表["记录们"] = [行 遍历 行 在 表["记录们"] 如果 非 (行["id"] 在 删集)]
    _引擎_记日志(状态, {"操作": "删行", "表": 名, "id们": id们})
    状态["上次数"] = 长度(们)
    返回 长度(们)

# ---------- 汇总 ----------

# 组键：整数变文本（复刻内置：整数 3 → 键 "3"），其余原样
函数 _引擎_组键(值)：
    如果 类型(值) == "整数"：
        返回 文本(值)
    返回 值

函数 _引擎_汇总(状态, 表名, 按, 求和, 条件)：
    令 表 = _引擎_表状态(状态, 表名)
    令 名 = _引擎_表名文本(表名)
    令 条件有效 = _引擎_规整条件(表, 名, 条件)
    令 按名 = 按 如果 类型(按) == "文本" 否则 文本(按)
    令 和名 = 求和 如果 类型(求和) == "文本" 否则 文本(求和)
    # 字段存在：按 先查（SELECT 列顺序）
    _引擎_校验字段们(名, [按名], ["id"] + 表["字段们"])
    _引擎_校验字段们(名, [和名], ["id"] + 表["字段们"])
    令 行们 = 表["记录们"]
    如果 条件有效 != 空：
        行们 = [行 遍历 行 在 行们 如果 _条件_满足(行, 条件有效)]
    # 求和列先验值（实测：空值与不是数字的值都报「类型错误」）
    遍历 行 在 行们：
        令 v = 行[和名]
        如果 v == 空：
            抛出 类型错误(`「{和名}」这一列里有空值，没法汇总`)
        令 v类 = 类型(v)
        如果 (v类 != "整数") 与 (v类 != "小数")：
            抛出 类型错误(`「{和名}」这一列里有不是数字的值「{v 如果 类型(v) == "文本" 否则 _引擎_概貌(v)}」，没法汇总`)
    # 组列验空值
    遍历 行 在 行们：
        如果 行[按名] == 空：
            抛出 类型错误(`「{按名}」这一列里有空值，没法汇总`)
    # 分组（组键保持首现顺序）
    令 组们 = {}
    令 顺序 = []
    遍历 行 在 行们：
        令 组值 = 行[按名]
        令 键 = json.转文本([_值库_编码(组值)])
        如果 键 不在 组们：
            组们[键] = {"显示": _引擎_组键(组值), "值": 组值, "个数": 0, "总和": 0.0, "最大": 空, "最小": 空}
            顺序.追加(键)
        令 组 = 组们[键]
        组["个数"] += 1
        令 v = 小数(行[和名])
        组["总和"] = 组["总和"] + v
        如果 (组["最大"] == 空) 或 (_值库_比较(v, 组["最大"]) > 0)：
            组["最大"] = v
        如果 (组["最小"] == 空) 或 (_值库_比较(v, 组["最小"]) < 0)：
            组["最小"] = v
    令 结果 = {}
    遍历 键 在 顺序：
        令 组 = 组们[键]
        结果[组["值"]] = {
            "个数": 组["个数"],
            "总和": 组["总和"],
            "平均": 组["总和"] / 组["个数"],
            "最大": 组["最大"],
            "最小": 组["最小"],
        }
    返回 结果

# ---------- 建索引 ----------

函数 _引擎_建索引(状态, 表名, 字段们, 唯一)：
    令 表 = _引擎_表状态(状态, 表名)
    令 名 = _引擎_表名文本(表名)
    # 兼容：单个字符串 ≡ 单元素列表（与 建表 同一条规矩）
    如果 类型(字段们) == "文本"：
        字段们 = [字段们]
    如果 (类型(字段们) != "列表") 与 (类型(字段们) != "元组")：
        抛出 值错误("索引字段要给一个非空的字段名列表，例如 [\"金额\"]")
    如果 长度(字段们) == 0：
        # 实测内置：空列表 → 值错误「索引字段要给一个非空的字段名列表」
        抛出 值错误(`表「{名}」的索引字段要给一个非空的字段名列表`)
    令 名单 = []
    遍历 元 在 字段们：
        名单.追加(元 如果 类型(元) == "文本" 否则 文本(元))
    _引擎_校验字段们(名, 名单, ["id"] + 表["字段们"])
    # 同定义已存在 → 不动（实测内置重复建索引不报错）
    遍历 定义 在 表["索引们"]：
        如果 (定义["字段们"] == 名单) 与 (定义["唯一"] == 唯一)：
            返回
    # 建映射（唯一 → 已有重复数据当场抛冲突，整库不动；非唯一 → 键 → 行列表）
    令 映射项 = _索引_建映射(表, 名, 名单, 唯一)
    表["索引们"].追加({"字段们": 名单, "唯一": 唯一})
    表["映射们"].追加(映射项)
    _引擎_记日志(状态, {"操作": "建索引", "表": 名, "索引": {"字段们": 名单, "唯一": 唯一}})


# 深拷贝（事务备份用）。只认三种容器：字典 / 列表 / 其它（值类型原样返回）。
#
# ⚠️ 「其它原样返回」是有意的：字节、函数、模块这些是不可变或共享的，
#    拷了反而会出岔子（函数拷成新对象就不再是同一个闭包了）。
函数 _引擎_深拷贝(值)：
    令 t = 类型(值)
    如果 t == "字典":
        令 新 = {}
        遍历 k 在 值.键()：
            新[k] = _引擎_深拷贝(值[k])
        返回 新
    如果 t == "列表":
        令 新 = []
        遍历 x 在 值：
            新.追加(_引擎_深拷贝(x))
        返回 新
    返回 值


# 句柄 → 注册表键。空串与 `:memory:` 都是**无盘库**，共用一个键 ""（见 `打开`）。
函数 _引擎_库键(句柄)：
    如果 (长度(句柄) == 0) 或 (句柄 == ":memory:"):
        返回 ""
    返回 路径.绝对路径(句柄)


# ===========================================================================
# 对外 API（21 个）—— 名字与参数与「SQLite 那版」逐字一致
# ===========================================================================

函数 打开(路径)：
    """打开一个库，返回**句柄**（同一个路径开两次拿到同一个库）。`":memory:"` 或空串是内存库。"""
    返回 _引擎_打开(路径)

函数 关闭(库)：
    """关闭库：把日志交回系统、清掉锁文件。没提交的事务**丢弃**。

    📌 M212 起**不再在关闭时整份重写快照**（原来 2 万行要 126 ms）：改动都已经
    在日志里了，重写只是把它们搬一遍家，下一轮写满日志（4096 行）时反正要做。
    """
    _引擎_关闭(库)

函数 表们(库)：
    """列出库里所有表名（按名字排序）。"""
    返回 _引擎_表们(_引擎_句柄状态(库))

函数 有表(库, 表名)：
    """这个表在不在。"""
    返回 _引擎_有表(_引擎_句柄状态(库), 表名)

函数 建表(库, 表名, 字段们)：
    """建一张表；`字段们` 给字段名列表（不写类型，`id` 自动加、不用写）。表已存在则什么都不做。"""
    _引擎_建表(_引擎_句柄状态(库), 表名, 字段们)

函数 建索引(库, 表名, 字段们, 唯一=假)：
    """按这些字段建索引（`唯一` 为 真 时同时是唯一约束，有重复数据当场报错）。"""
    _引擎_建索引(_引擎_句柄状态(库), 表名, 字段们, 唯一)

函数 插入(库, 表名, 记录)：
    """插一条记录（字典），返回它的 `id`。"""
    返回 _引擎_插入(_引擎_句柄状态(库), 表名, 记录)

函数 批量插入(库, 表名, 记录们)：
    """一次插一批：要么全进，要么一条都不进（中途出错整批回滚）。返回条数。"""
    返回 _引擎_批量插入(_引擎_句柄状态(库), 表名, 记录们)

函数 修改(库, 表名, 条件, 新值)：
    """按条件改行，返回改了几行。`条件` 见 `查询`。"""
    返回 _引擎_修改(_引擎_句柄状态(库), 表名, 条件, 新值)

函数 删除(库, 表名, 条件)：
    """按条件删行，返回删了几行。"""
    返回 _引擎_删除(_引擎_句柄状态(库), 表名, 条件)

函数 查询(库, 表名, 条件=空, 排序=空, 倒序=假, 条数=空)：
    """取记录（字典列表）。默认**插入顺序**；`条件` 写 `{"字段": 值}` 或 `{"字段": {">": 值}}`。"""
    返回 _引擎_查询(_引擎_句柄状态(库), 表名, 条件, 排序, 倒序, 条数)

函数 条数(库, 表名, 条件=空)：
    """数行数（给了条件就只数满足的）。"""
    返回 _引擎_条数(_引擎_句柄状态(库), 表名, 条件)

函数 汇总(库, 表名, 按, 求和, 条件=空)：
    """按 `按` 分组、对 `求和` 列做统计，返回 `{组值: {个数, 总和, 平均, 最大, 最小}}`。"""
    返回 _引擎_汇总(_引擎_句柄状态(库), 表名, 按, 求和, 条件)

函数 执行(库, SQL, 参数们=空)：
    """逃生口：跑一句**写** SQL（INSERT / UPDATE / DELETE / CREATE / DROP），返回影响行数。"""
    返回 _SQL子集_执行(_引擎_句柄状态(库), SQL, 参数们)

函数 执行查询(库, SQL, 参数们=空)：
    """逃生口：跑一句 SELECT，返回字典列表（适合取值；要接着做表格运算用 `查询到表格`）。"""
    返回 _SQL子集_查询(_引擎_句柄状态(库), SQL, 参数们)


# ---------------------------------------------------------------------------
# 事务（M202b 新加）：以前是转给 SQLite 的 BEGIN/COMMIT，现在是引擎自己的
# 「内存快照 + 日志起点」。
#
# 怎么做的：`开始` 把**内存里的表们深拷贝一份**存进 `状态["事务"]`，同时记住
# 当前日志行数；`回滚` 把表们换回备份、把日志截回那个行数。`提交` 只丢掉备份。
#
# 为什么不是「写进日志一条 BEGIN」：日志重放只认建表/插入/改行这些**变更**，
# 给它加事务语义就得改日志格式与重放器 —— 而回滚需要的两样东西（旧数据、旧日志
# 长度）本来就在手里。少一个格式版本，少一处跨版本兼容问题。
# ---------------------------------------------------------------------------

函数 开始(库)：
    """开一个事务。之后的所有写操作要么一起生效（`提交`），要么一起作废（`回滚`）。"""
    令 状态 = _引擎_句柄状态(库)
    如果 状态["事务"] != 空：
        抛出 值错误("已经在一个事务里了，不能再「开始」一次 —— 先用 数据库.提交 或 数据库.回滚 结束上一个事务")
    状态["事务"] = {"备份": _引擎_深拷贝(状态["表们"]), "日志起点": 状态["日志行数"]}

函数 提交(库)：
    """把本事务的改动落定（日志里那些行从此不会再被截掉）。"""
    令 状态 = _引擎_句柄状态(库)
    如果 状态["事务"] == 空：
        抛出 值错误("现在不在事务里，没有可提交的改动 —— 先 数据库.开始(库)，改完再 数据库.提交(库)")
    状态["事务"] = 空
    _存储器_写后检查(状态)

函数 回滚(库)：
    """把本事务的改动全部作废，回到 `开始` 那一刻的样子。"""
    令 状态 = _引擎_句柄状态(库)
    令 快照 = 状态["事务"]
    如果 快照 == 空：
        抛出 值错误("现在不在事务里，没有可回滚的改动 —— 先 数据库.开始(库)，再 数据库.回滚(库)")
    状态["表们"] = 快照["备份"]
    # 索引映射里存的是**行对象的引用**；换回备份后要重建，否则索引指的还是旧行
    遍历 名 在 状态["表们"].键()：
        _索引_重建(状态["表们"][名], 名)
    _存储器_截断日志(状态, 快照["日志起点"])
    状态["日志行数"] = 快照["日志起点"]
    状态["事务"] = 空

函数 用事务(库, 动作)：
    """把 `动作`（一个没参数的函数）包在事务里：跑完自动提交，抛错自动回滚。

    例：`数据库.用事务(库, 函数()：数据库.插入(库, "账", {"额": 1}))`

    ⚠️ 函数**抛错时**原来的错误会原样抛出去（回滚失败也不会把它盖掉）——
       否则用户看到的是一句「回滚失败」，真正的原因再也找不到。
    """
    如果 类型(动作) != "函数":
        抛出 类型错误("「用事务」的第二个参数要给一个**函数**（没有参数的），例如 数据库.用事务(库, 函数()：… )")
    开始(库)
    尝试：
        令 结果 = 动作()
        提交(库)
        返回 结果
    捕获 异常 为 错：
        尝试：
            回滚(库)
        捕获 异常 为 回滚错：
            # 回滚失败不能盖掉原来的错 —— 那个才是用户要看的。
            # 记在这里但不抛：错误对象是值，留一行说明它被忽略过。
            令 忽略 = 回滚错
        抛出 错


# ---------------------------------------------------------------------------
# 迁移（M202b 新加）：跑一个目录下的 `.sql`，按文件名顺序，跑过的记在
# `schema_版本` 表里（下次跳过）。
# ---------------------------------------------------------------------------

# 把一段 SQL 切成**单条语句**：`;` 分隔，但引号里的 `;` 不算，`--` 注释整行跳过。
#
# 为什么要自己切：引擎的 SQL 子集一次只认一条语句（解析器读完一条就停），
# 而迁移文件天然是多条。SQLite 那边是 `execute_batch`，这边只能先切。
函数 _切语句(全文)：
    令 语句们 = []
    令 当前 = ""
    令 i = 0
    令 n = 长度(全文)
    令 引号 = ""
    当 i < n：
        令 c = 全文[i]
        如果 引号 != ""：
            当前 = 当前 + c
            如果 c == 引号：
                如果 (i + 1 < n) 与 (全文[i + 1] == 引号)：
                    # SQL 里 `''` 表示一个引号本身
                    当前 = 当前 + 引号
                    i += 1
                否则：
                    引号 = ""
        否则如果 (c == `'`) 或 (c == `"`)：
            引号 = c
            当前 = 当前 + c
        否则如果 (c == "-") 与 (i + 1 < n) 与 (全文[i + 1] == "-"):
            当 (i < n) 与 (全文[i] != `\n`)：
                i += 1
            继续
        否则如果 c == ";":
            如果 长度(_去空白(当前)) > 0：
                语句们.追加(当前)
            当前 = ""
        否则：
            当前 = 当前 + c
        i += 1
    如果 长度(_去空白(当前)) > 0：
        语句们.追加(当前)
    返回 语句们

函数 _去空白(s)：
    令 头 = 0
    令 尾 = 长度(s)
    当 (头 < 尾) 与 (文本库.是空白(s[头]))：
        头 += 1
    当 (尾 > 头) 与 (文本库.是空白(s[尾 - 1]))：
        尾 -= 1
    返回 s[头:尾]

函数 迁移(库, 目录)：
    """跑 `目录` 下的 `.sql`（按文件名排序），返回这次真跑了的文件名。

    跑过的记在库里的 `schema_版本` 表（`版本` / `跑于`），**下次自动跳过** ——
    所以迁移文件一旦跑过就别改它（改了就另起一个 002_xxx.sql）。
    """
    令 状态 = _引擎_句柄状态(库)
    令 目录文本 = 目录 如果 类型(目录) == "文本" 否则 文本(目录)
    如果 非 路径.存在(目录文本)：
        抛出 文件错误(`迁移目录不存在：「{目录文本}」—— 先建目录，把 001_建表.sql 这类文件放进去`)
    如果 非 路径.是目录(目录文本)：
        抛出 文件错误(`迁移目录要给一个目录，给的是文件：「{目录文本}」`)
    令 名单 = []
    遍历 项 在 文件.列出目录(目录文本)：
        令 名 = 项 如果 类型(项) == "文本" 否则 文本(项)
        如果 (长度(名) > 4) 与 (名[长度(名) - 4:长度(名)] == ".sql"):
            名单.追加(名)
    # ⚠️ 别写 `名单.排序()`：那个是**原地排序、返回 空**（实测）。
    #    要新列表就用 `排序按`。同一个语言里两个名字语义不同，踩过。
    名单 = 名单.排序按(函数(名)：名)
    如果 长度(名单) == 0：
        返回 []
    如果 非 有表(库, "schema_版本")：
        建表(库, "schema_版本", ["版本", "跑于"])
        建索引(库, "schema_版本", ["版本"], 真)
    令 已跑 = {}
    遍历 行 在 查询(库, "schema_版本")：
        已跑[行["版本"]] = 真
    令 跑了 = []
    遍历 名 在 名单：
        如果 名 在 已跑：
            继续
        令 全文 = 文件.读文本(路径.连接(目录文本, 名))
        遍历 语句 在 _切语句(全文)：
            尝试：
                _SQL子集_执行(状态, 语句, [])
            捕获 异常 为 错：
                抛出 值错误(`迁移文件「{名}」跑失败了：{错.消息} —— 改好这个 .sql 再重跑（已经跑过的不会重复跑）`)
        插入(库, "schema_版本", {"版本": 名, "跑于": 时间.时间戳()})
        跑了.追加(名)
    返回 跑了


# ---------------------------------------------------------------------------
# 查询到表格（M202b 新加）：一句 SELECT 直出 `表格` 值，接着就能用表格的
# 挑选 / 筛选 / 透视 / 转文本。
# ---------------------------------------------------------------------------

# 输出列名（空结果也要有表头 —— 那是「查询到表格」与「执行查询」的区别之一）。
函数 _SQL子集_输出列名(状态, 树)：
    如果 树["全部"]：
        令 找到 = _SQL子集_要表(状态, 树["表"])
        返回 ["id"] + 找到[1]["字段们"]
    令 名们 = []
    如果 长度(树["分组"]) > 0：
        遍历 g 在 树["分组"]：
            名们.追加(g)
    遍历 列 在 树["列们"]：
        如果 列["聚合"]：
            名们.追加(列["键"])
        否则如果 长度(树["分组"]) == 0：
            名们.追加(列["键"])
    返回 名们

函数 查询到表格(库, SQL, 参数们=空)：
    """跑一句 SELECT，**直接返回 `表格` 值**（表头 + 数据行）。

    与 `执行查询` 的区别：那个给的是**字典列表**（每行一个字典），适合取值；
    这个给的是表格，适合接着做 `表格.透视` / `表格.转文本` 这类运算。
    """
    令 状态 = _引擎_句柄状态(库)
    # 参数们只收 列表/元组/空（与 `_SQL子集_查询` 同一条校验，见垫片 ㉒）
    如果 (参数们 != 空) 与 (类型(参数们) != "列表") 与 (类型(参数们) != "元组"):
        抛出 值错误(`「参数们」要一个**列表**（每个 ? 对应一项），来的是「{类型(参数们)}」`)
    令 参数列表 = 参数们 如果 参数们 != 空 否则 []
    令 树 = _SQL子集_解析一条(SQL, 参数列表)
    如果 树["类"] != "SELECT"：
        抛出 值错误("「查询到表格」只跑 SELECT；你写的是别的 —— 写操作用 数据库.执行(库, SQL)")
    令 列名们 = _SQL子集_输出列名(状态, 树)
    # 重名列：记录那边报错，表格这边也报（不然取值只拿到第一列）
    令 见 = {}
    遍历 名 在 列名们：
        如果 名 在 见：
            抛出 类型错误(`这句 SQL 里有重名的列（{名}），表格里装不下 —— 在 SQL 里给它们起别名，例如 SELECT 金额 AS 分组, 金额 AS 值`)
        见[名] = 真
    令 行们 = _SQL子集_跑查询(状态, 树, 参数列表)
    # 空值 → 空文本（与 native 那版一致）
    遍历 行 在 行们：
        遍历 列 在 行.键()：
            如果 行[列] == 空:
                行[列] = ""
    如果 长度(行们) > 0：
        返回 表格.从记录(行们)
    # 0 行也得有表头：先造一行全空、再切掉 —— `表格` 没有「只给表头」的构造器，
    # 而「0 行结果没有表头」会让下游的 表格.转文本 / 写表格 直接没有列。
    令 假行 = {}
    遍历 名 在 列名们：
        假行[名] = 空
    返回 表格.切片行(表格.从记录([假行]), 0, 0)
