# Excel 写（M124）：写工作簿 / 写多表
#
# 三条判据（路线图 §12 定的）：
#   ① **往返一致**：写出去 → 读回来 → 值与类型完全相同；
#   ② **字节可复现**：同一份数据写两次**逐字节相同**（zip 时间戳写死 1980-01-01）；
#   ③ 别人（openpyxl）能打开 —— 这条只能在 pytest 里验，语料里没法验。
#
# ⚠️ **不打印文件哈希**：三宿主写出的 zip 字段细节（version needed / external_attr）不必一致，
#    所以哈希值三边天然不同。这里只打印「两次写的是不是一样」—— 那是个**布尔**，三边都该是 `真`。
#
# ⚠️ 文件写在 `路径.临时目录()` 下，路径不进输出。

导入 路径
导入 文件
导入 表格
导入 Excel

令 目录 = 路径.临时目录("m124_")

# ⚠️ 用 `表格.从记录` 造表：字典的键顺序就是表头顺序（基石字典保插入序）。
#    没有「凭空造一个表格」的独立函数 —— 表格总是从**数据**来的（CSV / Excel / 记录）。
令 表 = 表格.从记录([
    {"姓名": "小红", "分数": 95, "备注": "正常"},
    {"姓名": "小刚", "分数": 88, "备用": 空},
    {"姓名": "小明", "分数": 100, "备注": "A&B <公司>"},
])

# ---- 一、写单表 ----
令 甲 = 目录 + "/甲.xlsx"
令 乙 = 目录 + "/乙.xlsx"
Excel.写工作簿(甲, 表, "成绩")
Excel.写工作簿(乙, 表, "成绩")

# ② 字节可复现：同一份数据写两次，文件**逐字节相同**
打印(文件.读字节(甲) == 文件.读字节(乙))

# ① 往返一致
令 簿 = Excel.读工作簿(甲)
打印(簿["工作表们"])
令 回 = Excel.读工作表(簿, "成绩")
打印(表格.表头(回))
打印(表格.数据行(回))
打印(表格.表头(回) == 表格.表头(表))
打印(表格.数据行(回) == 表格.数据行(表))

# ---- 二、数字保住了类型（整数不会变小数）----
令 行们 = 表格.数据行(回)
打印(类型(行们[0][1]))
打印(类型(行们[2][1]))
打印(行们[1][2] == 空)

# ---- 三、多表：标签页顺序 = 字典里的顺序 ----
令 多 = 目录 + "/多.xlsx"
Excel.写多表(多, {
    "成绩":表,
    "说明":表格.从记录([{"提示": "第一行是表头"}, {"提示": "第二行是数据"}]),
})
令 簿二 = Excel.读工作簿(多)
打印(簿二["工作表们"])
打印(表格.数据行(Excel.读工作表(簿二, "说明")))
