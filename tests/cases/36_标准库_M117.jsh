# M117：`数学.限制` / `数学.符号` / `容器.索引表` / `容器.深拷贝` /
#       `随机.随机文本` / `随机.按权重`
#
# ⚠️ 随机那两个**只钉确定的部分**（长度、字符集、必然结果）——
#    随机值本身不可对拍（各宿主的 RNG 本来就不同，也不该相同）。

导入 数学
导入 容器
导入 随机
导入 文本 为 文

# 限制：区间内 / 撞下界 / 撞上界 / 保类型（整数还是整数）
打印(数学.限制(5, 1, 10))
打印(数学.限制(-3, 1, 10))
打印(数学.限制(99, 1, 10))
打印(数学.限制(5.5, 1, 10))
打印(数学.限制(5.5, 1.0, 10.0))
打印(数学.限制(1, 1, 10))

# 符号：负 / 零 / 正，整数与小数都算
打印(数学.符号(-3), 数学.符号(0), 数学.符号(7))
打印(数学.符号(-2.5), 数学.符号(0.0))

# 索引表：重复值保留**首次**下标
打印(容器.索引表(["甲", "乙", "甲", "丙"]))
打印(容器.索引表([]))
打印(容器.索引表("甲乙甲"))

# 深拷贝：改副本不影响原件（浅拷贝会踩共享）
令 原 = {"甲": [1, 2]}
令 副 = 容器.深拷贝(原)
副["甲"].追加(3)
打印(原)
打印(副)

# 随机文本：长度与字符集是确定的
打印(长度(随机.随机文本(8)))
打印(长度(随机.随机文本(0)))
打印(长度(随机.随机文本(6, "数字")))
打印(文.是数字(随机.随机文本(6, "数字")))
打印(文.是数字(随机.随机文本(12, "数字")))
打印(长度(随机.随机文本(5, "小写字母")))

# 按权重：权重 0 的永远选不到；只有一个选项时必然选它
打印(随机.按权重(["甲", "乙"], [0, 1]))
打印(随机.按权重(["甲", "乙"], [1, 0]))
打印(随机.按权重(["只有一个"], [7]))
打印(随机.按权重(["甲", "乙", "丙"], [0, 0, 5]))
