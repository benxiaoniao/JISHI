# M113：字节（值类型）。覆盖 类型/显示/长度/下标/切片/拼接/重复/真值/相等/
# 比较/包含/集合/排序/遍历，以及 编码/加密/文件/数据库 的字节面。
# ⚠️ 全部确定性输出（不打印随机值、不打印临时路径）。

导入 编码
导入 加密
导入 文件
导入 路径
导入 数据库

# -- 类型与显示 --
令 b = 编码.十六进制解码("0CFF00")
打印(类型(b))
打印(b)
打印(长度(b))
打印(b[0], b[-1])
打印(b[0:2], 类型(b[0:2]))
打印(b + 编码.十六进制解码("41"))
打印(b * 2, 2 * b, b * 0)
令 无 = 编码.十六进制解码("")
打印(无, 长度(无), 类型(无))

# -- 真值：空字节是假 --
如果 无:
    打印("空是真-错")
否则:
    打印("空是假")
如果 b:
    打印("非空是真")
否则:
    打印("非空是假-错")

# -- 相等与比较 --
打印(b == 编码.十六进制解码("0CFF00"), b == "甲", b != 编码.十六进制解码("00"))
打印(b < 编码.十六进制解码("FF"), b > 编码.十六进制解码("00"))

# -- 包含（字节在字节=子串；整数在字节=字节值）--
打印(编码.十六进制解码("0CFF") 在 b, 255 在 b, 1 在 b)

# -- 集合去重 / 排序（字节可作元素）--
打印(长度(集合([b, 编码.十六进制解码("0CFF00"), 无])))
令 待排 = [编码.十六进制解码("FF"), 无, 编码.十六进制解码("00")]
待排.排序()
打印(待排)

# -- 遍历给整数 --
令 项们 = []
遍历 x 在 编码.十六进制解码("414243"):
    项们.追加(x)
打印(项们)

# -- 长字节显示会截断（前 16 个 + 总数）--
打印(编码.十六进制解码("000102030405060708090A0B0C0D0E0F1011"))

# -- 编码往返 --
打印(编码.字节文本(编码.base64解码(编码.base64编码("中文"))))
打印(编码.十六进制编码(编码.文本字节("中"), 真))

# -- 加密：随机字节是「字节」（只比类型与长度，不打印值）--
令 盐一 = 加密.安全随机字节(8)
令 盐二 = 加密.安全随机字节(8)
打印(类型(盐一), 长度(盐一), 盐一 == 盐二)

# -- 文件：读字节 / 写字节 往返（不打印路径）--
令 目录 = 路径.临时目录()
令 目标 = 路径.连接(目录, "m113.bin")
文件.写字节(目标, b)
打印(文件.读字节(目标) == b)
文件.删除文件(目标)

# -- 数据库：BLOB 往返 --
令 库 = 数据库.打开(":memory:")
数据库.建表(库, "图", ["名", "内容"])
数据库.插入(库, "图", {"名": "首图", "内容": b})
令 行 = 数据库.查询(库, "图")[0]
打印(类型(行["内容"]), 行["内容"] == b)
