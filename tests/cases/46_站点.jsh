# 站点模块（M168）：布局 / 导航 / 页面 / 资源指纹 / 渲染 / sitemap
#
# ⚠️ 这里**不调 `写站`** —— 它会往磁盘写文件，而语料是在仓库根目录跑的
# （`check_engines` 的教训：在 cwd 写真实文件会污染下一轮）。
# `写站` 由 `tests/test_m168_site.py` 在临时目录里测。
导入 站点
导入 html

令 表 = 站点.布局({
    "标题后缀":"我的博客",
    "品牌":"我的博客",
    "品牌副":"blog",
    "导航项":[["index.html", "首页"], ["关于.html", "关于"]],
    "脚注":"由基石生成",
    "网址前缀":"https://例子.cn",
})

# 指纹：同样内容同样指纹，改一个字就变
打印(站点.资源指纹("abc"))
打印(站点.资源指纹("abd"))
打印(长度(站点.资源指纹("随便什么内容，中文也算")))
打印(站点.资源指纹("") == 站点.资源指纹(""))

# 导航：当前页那条带 class="now"
打印(站点.导航([["index.html", "首页"], ["关于.html", "关于"]], "关于.html"))
打印(站点.导航([], ""))

# 整页：标题后缀 / 品牌副 / 脚注 / 转义
令 页 = {"路径": "index.html", "标题": "首页", "正文": html.标签("h1", "你好")}
打印(站点.页面(页, 表) != "")
打印(站点.页面({"路径": "a.html", "标题": "甲", "正文": "&lt;b&gt;", "脚注": "单独署名"}, 表))

# 渲染：不落盘，返回 [路径, 内容] 对，顺序按调用方给的
令 页们 = [
    {"路径": "b.html", "标题": "乙", "正文": "B"},
    {"路径": "a.html", "标题": "甲", "正文": "A"},
]
令 已渲染 = 站点.渲染(页们, 表)
打印(长度(已渲染))
打印(已渲染[0][0] + " / " + 已渲染[1][0])

# sitemap：排序 + 去重（顺序不取决于调用方）
打印(站点.sitemap(页们, "https://例子.cn"))
打印(站点.sitemap(["x.html"], "https://例子.cn/"))
打印(站点.sitemap(["y.html"], ""))

# 布局：默认值能补全，用户给什么用什么
令 简 = 站点.布局()
打印(简["语言"] + " · " + 简["标题分隔"] + " · " + 简["样式文件"])
打印(简["标题后缀"] == "")
打印(长度(简["导航项"]))

# 没有样式表：`样式` 给空串
令 无样式 = 站点.布局({"样式": "", "指纹": 假})
打印(无样式["样式"] == "")

# 排序口径：按 **UTF-8 字节**，不是 JS 的 UTF-16 单元序 —— 基本平面以外的字符
# （emoji）在两种序下位置不同，三宿主必须按同一个口径排。
打印(站点.sitemap(["…排后面.html", "😀.html", "z.html"], ""))
