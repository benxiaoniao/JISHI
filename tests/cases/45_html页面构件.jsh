# 页面构件（M166）：表单 / 表格 / 布局 / 卡片 / 提示
#
# 这一条**不进 `.out` 的东西只有一样**：整页的 `<style>`（1600 多字符的 CSS）。
# 取代办法是先 `html.取文本` 再打印 —— 骨架里的标题、导航、正文、页脚都在，
# 而样式不影响语义（它由 `test_m166_html_page.py` 的源码级判据盯着三家一致）。
导入 html
导入 表格

# -- 表单构件 --
打印(html.输入框("金额", "金额", "number"))
打印(html.输入框("备注"))
打印(html.输入框("甲", "", "text", "初值"))
打印(html.多行文本("说明", "说明", "写字", 6))
打印(html.下拉("类别", ["餐饮", "交通"], "类别", "交通"))
打印(html.多选("标签", ["工作", "生活"], "分类", ["生活"]))
打印(html.按钮("保存"))
打印(html.按钮("清空", "reset"))
打印(html.表单([html.输入框("金额", "金额"), html.按钮("记一笔")], "/新建"))

# -- 表格：直接从表格值渲染 --
令 账 = 表格.从记录([
    {"日期": "11-01", "项目": "早餐", "金额": "12"},
    {"日期": "11-02", "项目": "地铁", "金额": "3"},
])
打印(html.由表格(账))
打印(html.由表格(账, 真))

# -- 卡片 / 提示 --
打印(html.卡片("本月支出", html.由表格(账)))
打印(html.提示("成功", "已保存"))
打印(html.提示("警告", "余额不足"))
打印(html.提示("错误", "金额要填正数"))

# -- 整页：只比文本骨架（样式太长，见文件头）--
令 页 = html.页面("记账", [html.卡片("本月", "内容")], [["首页", "/"], ["关于", "/关于"]])
打印(html.取文本(页))

# -- 转义不能漏：用户输入里带尖括号也只会是字面文本 --
打印(html.输入框("<坏>", "<标签>"))
打印(html.提示("成功", "<script>alert(1)</script>"))
