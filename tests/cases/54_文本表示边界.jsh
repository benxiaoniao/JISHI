# 文本表示的边界（M214b）：≤7 字节内联、≥8 字节一次分配的堆串。
#
# 这两条路在「长度 / 比较 / 下标 / 切片 / 拼接 / 字典键」上必须给一样的结果。
# 五引擎跑这条语料，任何一侧走岔了都会当场红。
导入 文本 为 文本库

令 串们 = ["", "a", "abc", "abcdefg", "abcdefgh", "中文", "中文abc", "😀", "😀😀"]
遍历 s 在 串们：
    打印(长度(s), s + "!")

# 下标：内联侧与堆侧各来一遍（含负下标）
令 七 = "abcdefg"
令 八 = "abcdefgh"
打印(七[0], 七[6], 七[-1], 七[-7])
打印(八[0], 八[7], 八[-1], 八[-8])

# 切片：结果可能落在内联侧，也可能落在堆侧
打印(八[0:3], 八[3:8], 八[0:8], 八[:4], 八[4:])

# 比较：跨边界（内容相同、长度不同），以及中文
打印(七 == "abcdefg", 七 == 八, 七 < 八)
打印("中文" < "中文abc", "😀" == "😀")

# 字典键：短（内联）与长（堆）都要能当键
令 d = {}
d["abc"] = 1
d["abcdefgh"] = 2
d["中文"] = 3
d["一二三四五六七八"] = 4
打印(d["abc"], d["abcdefgh"], d["中文"], d["一二三四五六七八"])
打印(长度(d), "abcdefgh" 在 d, "abcdefghi" 在 d)

# 遍历文本：按字符（不是字节），空串零次
令 计 = 0
遍历 c 在 "":
    计 = 计 + 1
打印(计)
令 段 = ""
遍历 c 在 "中文abc😀":
    段 = 段 + c + "|"
打印(段)

# 遍历完原串还在（遍历两次，两次都是完整的一遍）
令 双 = "中文ab"
令 n = 0
遍历 c 在 双:
    n = n + 1
遍历 c 在 双:
    n = n + 1
打印(n, 长度(双))
