# M211：多键排序 / 二分查找 / 二分插入点 / 列表字典序比较
# 五引擎（树遍历 / Python VM / C VM / Rust VM / Node）必须逐字一致。

函数 比(左, 右)：
    如果 左[0] != 右[0]：
        返回 左[0] - 右[0]
    如果 左[1] == 右[1]：
        返回 0
    返回 0 - 1 如果 左[1] < 右[1] 否则 1

令 记录 = [[2, "乙"], [1, "丙"], [1, "甲"], [2, "甲"]]
打印(记录.排序按比较(比))
打印(记录)

# 稳定：全平局时保持原顺序
函数 比尾(左, 右)：
    返回 左[1] - 右[1]

打印([[0, 5, "甲"], [1, 5, "乙"], [2, 5, "丙"], [3, 1, "丁"]].排序按比较(比尾))

# 二分查找 / 插入点
令 有序 = [2, 4, 6, 8, 10]
打印(二分查找(有序, 2), 二分查找(有序, 8), 二分查找(有序, 5))
打印(二分插入点(有序, 5), 二分插入点(有序, 0), 二分插入点(有序, 99))
打印(二分查找([1, 3, 3, 3, 7], 3), 二分插入点([1, 3, 3, 3, 7], 3))
打印(二分查找(有序, 9, 0, 4), 二分查找(有序, 9, 4))

# 维护有序表
令 表 = [1, 3, 5, 7]
遍历 新 在 [4, 0, 9, 5]：
    表.插入(二分插入点(表, 新), 新)
打印(表)

# 列表字典序
打印([1, 2] < [1, 3], [1, 2] < [1, 2, 0], [] < [1], [2] > [1, 9])
打印([[1, 2], [3]] < [[1, 2], [4]])
令 们 = [[3, 1], [1, 9], [2, 5], [1, 2]]
们.排序()
打印(们)
