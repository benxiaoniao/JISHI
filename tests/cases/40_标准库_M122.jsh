# HTTP路由（M122）：路由表 / 加路由 / 匹配 / 路径们
#
# 这个模块是**纯逻辑**（列表 + 字典），五个引擎必须逐字节一致 ——
# 所以这里把匹配规则的每一条都摆出来，包括「不该匹配」的那些。
#
# ⚠️ 不打印路由表本身：里面存着**函数值**，三宿主的渲染本来就不同。

导入 HTTP路由

函数 首页(请求, 参数)：
    返回 "首页"

函数 文章(请求, 参数)：
    返回 "文章 " + 参数["id"]

函数 静态(请求, 参数)：
    返回 "静态"

函数 通配(请求, 参数)：
    返回 "通配"

# ---- 一、基本匹配 ----
令 表 = HTTP路由.路由表()
打印(长度(表))

HTTP路由.加路由(表, "GET", "/", 首页)
HTTP路由.加路由(表, "GET", "/文章/:id", 文章)
HTTP路由.加路由(表, "POST", "/文章", 静态)
打印(长度(表))
打印(HTTP路由.路径们(表))

打印(HTTP路由.匹配 (表, "GET", "/")["处理"](空, 空))
打印(HTTP路由.匹配 (表, "GET", "/文章/42")["参数"])
打印(HTTP路由.匹配 (表, "POST", "/文章")["处理"](空, 空))

# ---- 二、方法：不分大小写；`*` 全收 ----
打印(HTTP路由.匹配 (表, "get", "/")["处理"](空, 空))
打印(HTTP路由.匹配 (表, "GET", "/")["处理"](空, 空))

令 全收 = HTTP路由.路由表()
HTTP路由.加路由(全收, "*", "/任何", 通配)
打印(HTTP路由.匹配 (全收, "DELETE", "/任何")["处理"](空, 空))
打印(HTTP路由.匹配 (全收, "get", "/任何")["处理"](空, 空))

# ---- 三、静态优先于参数 ----
令 优先 = HTTP路由.路由表()
HTTP路由.加路由(优先, "GET", "/用户/:id", 文章)
HTTP路由.加路由(优先, "GET", "/用户/新建", 静态)
打印(HTTP路由.匹配 (优先, "GET", "/用户/新建")["处理"](空, 空))
打印(HTTP路由.匹配 (优先, "GET", "/用户/7")["参数"])

# ---- 四、没匹配上的三种情形（都返回 空，不抛错）----
打印(HTTP路由.匹配 (表, "GET", "/没有这个") == 空)
打印(HTTP路由.匹配 (表, "DELETE", "/") == 空)
打印(HTTP路由.匹配 (表, "GET", "/文章") == 空)

# ---- 五、末尾斜杠严格区分：`/文章/` 不匹配 `/文章/:id`（空段不算参数）----
打印(HTTP路由.匹配 (表, "GET", "/文章/") == 空)
打印(HTTP路由.匹配 (表, "GET", "/文章/1")["参数"])

# ---- 六、段数不同就是不匹配 ----
令 深 = HTTP路由.路由表()
HTTP路由.加路由(深, "GET", "/a/:x/:y", 通配)
打印(HTTP路由.匹配 (深, "GET", "/a/1/2")["参数"])
打印(HTTP路由.匹配 (深, "GET", "/a/1") == 空)
打印(HTTP路由.匹配 (深, "GET", "/a/1/2/3") == 空)
