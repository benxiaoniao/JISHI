# M107 标准库：表格 ↔ 记录 与 html 解析（网络那批要联网，在 test_m107_network 里单独测）
导入 表格
导入 html

# ① 字典列表（JSON 接口回来的数据）直接变成表格
令 订单 = [{"客户": "甲", "金额": 12}, {"客户": "乙", "金额": 3, "备注": "x"}, {"客户": "甲", "金额": 8}]
令 表 = 表格.从记录(订单)
打印(表格.表头(表))
打印(表格.分组汇总(表, "客户", "金额"))
打印(表格.转记录(表))

# ② html 解析：取文本 / 取链接 / 取表格（不再正则硬挖）
令 页 = "<p>你好 <b>世界</b>&amp; 大家</p><ul><li><a href=\"/a?x=1&amp;y=2\">第一 个</a></li><li><a href='/b'>第二个</a></li></ul><table><tr><th>名</th><th>值</th></tr><tr><td>笔</td><td>2.5</td></tr></table>"
打印(html.取文本(页))
打印(html.取链接(页))
打印(html.取表格(页))
