# M120：零碎补齐（七个）
#   `路径.分隔符` · `系统.CPU核数` · `日期.月天数` · `时间.时区偏移`
#   `json.有效`（+ `json.解析` 改严格）· `表格.转文本` / `表格.转TSV`
#
# ⚠️ 这批里有**三个是平台 / 机器相关**的：`路径.分隔符` 的字符、
#    `系统.CPU核数` 的数、`时间.时区偏移` 的偏移量。而 `tests/cases/*.out`
#    是**签入仓库**的黄金输出，CI 会在 Linux / macOS 上跑
#    ⇒ 钉死具体值 = 在别的平台上必红。所以这里只钉**不变量**。

导入 路径
导入 系统
导入 日期
导入 时间
导入 json
导入 表格

# 分隔符：长度 1，且一定是这两种之一
打印(长度(路径.分隔符()))
打印(路径.分隔符() == "\\" 或 路径.分隔符() == "/")

# CPU 核数：至少 1
打印(系统.CPU核数() >= 1)

# 月天数：闰年规则（**1900 不是闰年、2000 是** —— 百年例外 + 四百年例外）
打印(日期.月天数(2026, 1), 日期.月天数(2026, 4), 日期.月天数(2026, 12))
打印(日期.月天数(2024, 2), 日期.月天数(2025, 2))
打印(日期.月天数(1900, 2), 日期.月天数(2000, 2))

# 时区偏移：形状是 `±HH:MM`
令 偏 = 时间.时区偏移()
打印(长度(偏))
打印(偏.开头是("+") 或 偏.开头是("-"))
打印(偏.包含(":"))

# json.有效：与 json.解析**同一个解析器**（所以 NaN / Infinity 不算）
打印(json.有效("{\"a\": 1}"), json.有效("[1, 2]"), json.有效("1"), json.有效("\"甲\""))
打印(json.有效("{'a': 1}"), json.有效("{\"a\": 1,}"), json.有效(""))
打印(json.有效("NaN"), json.有效("Infinity"), json.有效("{\"a\": NaN}"))
打印(json.有效("  {\"a\": 1}  "))
打印(json.有效("null"), json.有效("true"), json.有效("tru"))

# 转文本：表头 + 分隔线；数字列右对齐；汉字按 2 列对齐
令 t = 表格.从记录([
    {"姓名": "张三", "分数": 92},
    {"姓名": "李四", "分数": 100},
])
打印(表格.转文本(t))

# 转TSV：制表符分隔（末尾不带换行）
打印(表格.转TSV(t))

# 混合列（有文本有数字）⇒ 整列左对齐
令 混 = 表格.从记录([
    {"项": "甲", "值": 1},
    {"项": "乙", "值": "未知"},
])
打印(表格.转文本(混))

# 空表格（0 列）⇒ 空串（不是崩、也不是一个孤零零的分隔线）
打印(表格.转文本(表格.从记录([])))
打印(表格.转TSV(表格.从记录([])))
