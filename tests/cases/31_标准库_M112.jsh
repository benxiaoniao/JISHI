# M112：数据库（SQLite）的离线可验部分
#
# ⚠️ 前面大半用 `:memory:`（内存库，跑完就没）—— 完全不碰磁盘，跨平台天然可比。
# 最后一段用**临时目录里的真文件**验证「关掉再打开，数据还在」；
# 只打印计数与取值，**不打印任何路径**（免得平台相关）。
#
# ⚠️ 两条纪律（写真实语料时会踩到）：
#   ① 不写「跳掉中间可选参数的命名实参」（`f(a, 第三条=1)`）—— Python 允许、
#      宿主按位置调用不允许，是**已登记**的既有分叉（13 个既有函数同形状）；
#   ② 不打印「被捕获的异常」（两边渲染不同，也是既有分叉）。

导入 数据库
导入 日期
导入 文本 为 文本库
导入 路径

令 库 = 数据库.打开(":memory:")
数据库.建表(库, "账目", ["日期", "类别", "金额", "备注"])

# 一、表的存在性
打印(数据库.表们(库))
打印(数据库.有表(库, "账目"))
打印(数据库.有表(库, "没有的"))

# 二、插入：返回新行的 id
打印(数据库.插入(库, "账目", {"日期": "2026-10-01", "类别": "餐饮", "金额": 25.5, "备注": "午饭"}))
打印(数据库.插入(库, "账目", {"日期": "2026-10-01", "类别": "交通", "金额": 100, "备注": "打车"}))
打印(数据库.插入(库, "账目", {"日期": "2026-10-02", "类别": "餐饮", "金额": 12.0}))
打印(文本库.格式化("条数={}", 数据库.条数(库, "账目")))

# 三、查询：默认**插入顺序**（不是「碰巧的顺序」）
遍历 账 在 数据库.查询(库, "账目"):
    打印(文本库.格式化("{} {} {:.2f} [{}]", 账["id"], 账["日期"], 账["金额"], 账["备注"]))

# 四、条件：等值 / 比大小 / 包含 / 非空
打印(长度(数据库.查询(库, "账目", {"类别": "餐饮"})))
打印(长度(数据库.查询(库, "账目", {"金额": {">": 20}})))
打印(长度(数据库.查询(库, "账目", {"备注": {"包含": "车"}})))
打印(长度(数据库.查询(库, "账目", {"备注": {"非空": 真}})))
打印(长度(数据库.查询(库, "账目", {"备注": {"非空": 假}})))

# 五、排序 / 倒序 / 条数
遍历 账 在 数据库.查询(库, "账目", 空, "金额", 真):
    打印(文本库.格式化("{:.2f}", 账["金额"]))
打印(长度(数据库.查询(库, "账目", 空, "类别", 假, 2)))

# 六、汇总：与 `表格.汇总` **同形状**（个数 / 总和 / 平均 / 最大 / 最小）
令 各类 = 数据库.汇总(库, "账目", "类别", "金额")
遍历 类名 在 各类:
    令 统 = 各类[类名]
    打印(文本库.格式化("{} 个={} 总和={:.2f} 平均={:.2f} 最大={:.2f} 最小={:.2f}",
        类名, 统["个数"], 统["总和"], 统["平均"], 统["最大"], 统["最小"]))

# 七、改 / 删：返回影响的行数
打印(数据库.修改(库, "账目", {"类别": "餐饮"}, {"备注": "改过了"}))
打印(数据库.删除(库, "账目", {"类别": "交通"}))
打印(数据库.条数(库, "账目"))

# 八、批量插入（一个事务）+ 建索引（幂等）
打印(数据库.批量插入(库, "账目", [
    {"日期": "2026-10-03", "类别": "购物", "金额": 30, "备注": "买菜"},
    {"日期": "2026-10-03", "类别": "购物", "金额": 5, "备注": "水"},
]))
数据库.建索引(库, "账目", ["类别"])
数据库.建索引(库, "账目", ["类别"])
打印(数据库.条数(库, "账目", {"类别": "购物"}))

# 九、类型映射：真假→整数、空→NULL、日期时间→文本、精确小数→浮点
数据库.建表(库, "杂项", ["名", "值"])
数据库.插入(库, "杂项", {"名": "布尔", "值": 真})
数据库.插入(库, "杂项", {"名": "空值", "值": 空})
数据库.插入(库, "杂项", {"名": "日期", "值": 日期.解析("2026-10-01")})
数据库.插入(库, "杂项", {"名": "精确", "值": 精确("0.1")})
遍历 行 在 数据库.查询(库, "杂项"):
    打印(文本库.格式化("{}={} {}", 行["名"], 行["值"], 行["值"] == 空))

# 十、逃生口：直接写 SQL（顺序由自己的 ORDER BY 定）
打印(数据库.执行查询(库, "SELECT 类别, COUNT(*) AS n FROM 账目 GROUP BY 类别 ORDER BY 类别"))
打印(数据库.执行(库, "UPDATE 账目 SET 金额 = 1 WHERE 类别 = '购物'"))
打印(数据库.条数(库, "账目", {"金额": 1}))

# 十一、真文件：关掉再打开，数据还在（只打印计数，不打印路径）
令 目录 = 路径.临时目录("基石语料-M112-")
令 文件库 = 数据库.打开(路径.连接(目录, "账目.db"))
数据库.建表(文件库, "账目", ["金额"])
数据库.批量插入(文件库, "账目", [{"金额": 1}, {"金额": 2}, {"金额": 3}])
数据库.关闭(文件库)
令 再开 = 数据库.打开(路径.连接(目录, "账目.db"))
打印(数据库.条数(再开, "账目"))
打印(数据库.汇总(再开, "账目", "金额", "金额")[3]["总和"])
数据库.关闭(再开)
打印(路径.递归删除(目录))
