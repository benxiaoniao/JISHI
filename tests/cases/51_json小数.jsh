# M212：`json.转文本` 里的小数
# Node 宿主曾把 1.5 写成 "[object Object]"（FloatBox 没拆箱）——
# 数据库落盘、任何带小数的 JSON 都中招，而且不报错。

导入 json
导入 文本 为 文本库

令 甲 = {"整数": 2, "小数": 1.5, "负小数": -0.25}
令 文 = json.转文本(甲)
打印(文)

令 回 = json.解析(文)
打印(类型(回["整数"]), 回["整数"])
打印(类型(回["小数"]), 回["小数"])
打印(类型(回["负小数"]), 回["负小数"])

# 嵌套 / 列表里的小数也一样
令 乙 = {"们": [{"值": 2.5}, {"值": 3.25}]}
打印(json.转文本(乙))
打印(json.解析(json.转文本(乙))["们"][1]["值"])

# 缩进写法（Python 的 indent 口径）
打印(json.转文本({"甲": [1.5, 2]}, 2))
