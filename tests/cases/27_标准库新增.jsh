# M106 新增的标准库能力：显示宽度 + 对齐、迭代.归约/分区、表格.分组汇总/连接
# 自包含：自己造数据文件、跑完删掉（check_engines 给每个语料一个私有 cwd）

导入 文本
导入 迭代
导入 表格
导入 文件

打印(文本.显示宽度("中文"), 文本.显示宽度("abc"), 文本.显示宽度("😀"))
打印("[" + 文本.左对齐("中文", 8) + "]", "[" + 文本.右对齐("中文", 8) + "]")
打印("[" + 文本.居中("中文", 9) + "]", "[" + 文本.填充("ab", 5, "-") + "]")

打印(迭代.归约([1, 2, 3, 4], 函数(甲, 乙)：甲 + 乙))
打印(迭代.归约([1, 2], 函数(甲, 乙)：甲 + 乙, 10))
令 通过, 没过 = 迭代.分区([55, 80, 42, 91], 函数(x)：x >= 60)
打印(通过, 没过)

文件.写文本("_语料成绩.csv", "姓名,班级,数学\n小明,一班,90\n小红,一班,80\n小刚,二班,70\n")
令 成绩 = 表格.读表格("_语料成绩.csv")
令 各班 = 表格.分组汇总(成绩, "班级", "数学")
打印(各班["一班"]["个数"], 各班["一班"]["平均"], 各班["二班"]["总和"])

文件.写文本("_语料加分.csv", "姓名,加分\n小明,5\n小刚,3\n")
令 合 = 表格.连接(成绩, 表格.读表格("_语料加分.csv"), "姓名")
打印(合)
打印(表格.表头(合))
遍历 行 在 表格.数据行(合)：
    打印(行)

文件.删除文件("_语料成绩.csv")
文件.删除文件("_语料加分.csv")
