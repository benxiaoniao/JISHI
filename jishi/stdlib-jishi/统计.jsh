# 基石标准库 · 统计（**用基石自己写的库**）
#
# 为什么有这么一层（M52）：
#   以前标准库要**用三种语言各写一遍**（Python / JS / Rust）——`统计` 这类纯逻辑
#   模块，同一套算法维护三份，改一处得改三处，还容易悄悄漂移。从这里开始，
#   纯逻辑模块**只写一遍**（就是本文件），编译成字节码后**五个引擎共用**
#   （树遍历 / Python VM / C VM / Node / Rust）。
#
# 加载规则：`导入 统计` 时**先查这一层**，这里没有再回落到宿主层
#   （`jishi/stdlib/*.py` 与两个宿主各自的标准库）。所以迁移是渐进的，
#   搬一个模块就少一份重复，宿主层随时还在兜底。
#
# ⚠️ 写这个目录的模块要守三条：
#   ① 引别的模块一律写成 `导入 X 为 _X` —— 导出时会**排除下划线开头的名字**，
#      否则 `统计.数学` 这种内部依赖会漏到用户面前。
#   ② 报错**类型**要与 Python 侧一致（`类型错误` / `值错误`），对拍测试比类型；
#      文案允许略有出入（如实记在文档里）。
#   ③ **热路径别放这里**：走字节码比宿主原语慢（M52 实测见 `docs/设计决策.md`）。

导入 数学 为 _数学


函数 _取数字表(数据, 名字)：
    """把输入统一成数字列表；不是数字就给中文错（与 Python 侧 `_nums` 同口径）。

    `尝试` 只包住「能不能遍历」这一件事——元素检查放在外面，否则自己抛的
    「第 N 个不是数字」会被自己的 `捕获 类型错误` 吃成「要传一组数字（列表）」。
    """
    如果 类型(数据) == "文本"：
        抛出 类型错误("「" + 名字 + "」要传一组数字，不能传文本")
    令 原始 = []
    尝试：
        遍历 项 在 数据：
            原始.追加(项)
    捕获 类型错误 为 _e：
        抛出 类型错误("「" + 名字 + "」要传一组数字（列表）")
    令 序 = []
    令 位次 = 0
    遍历 项 在 原始：
        位次 = 位次 + 1
        令 t = 类型(项)
        如果 t == "整数" 或 t == "小数"：
            序.追加(项)
        否则：
            抛出 类型错误("「" + 名字 + "」里第 " + 文本(位次) + " 个不是数字：" + 文本(项))
    返回 序


函数 _要非空(序, 名字)：
    如果 长度(序) == 0：
        抛出 值错误("「" + 名字 + "」要至少有一个数字，现在是空的")
    返回 序


函数 _升序(数据, 名字)：
    令 序 = _要非空(_取数字表(数据, 名字), 名字)
    序.排序()
    返回 序


函数 求和(数据)：
    """返回所有数字的和（空列表返回 0）。"""
    令 序 = _取数字表(数据, "求和")
    如果 长度(序) == 0：
        返回 0
    令 总 = 0
    遍历 x 在 序：
        总 = 总 + x
    返回 总


函数 平均(数据)：
    """返回算术平均数。"""
    令 序 = _要非空(_取数字表(数据, "平均"), "平均")
    令 总 = 0
    遍历 x 在 序：
        总 = 总 + x
    返回 总 / 长度(序)


函数 中位数(数据)：
    """返回中位数（偶数个时取中间两个的平均）。"""
    令 序 = _升序(数据, "中位数")
    令 n = 长度(序)
    令 中 = n // 2
    如果 n % 2 == 1：
        返回 序[中]
    返回 (序[中 - 1] + 序[中]) / 2


函数 众数(数据)：
    """返回出现次数最多的值；并列最多时取**最先出现**的那个（结果可复现）。"""
    令 序 = _要非空(_取数字表(数据, "众数"), "众数")
    令 计数 = {}
    令 次序 = []
    遍历 v 在 序：
        如果 v 不在 计数：
            计数[v] = 0
            次序.追加(v)
        计数[v] = 计数[v] + 1
    令 最好 = 次序[0]
    令 最好数 = 计数[次序[0]]
    遍历 v 在 次序：
        如果 计数[v] > 最好数：
            最好 = v
            最好数 = 计数[v]
    返回 最好


函数 方差(数据, 样本 = 假)：
    """返回方差（默认**总体方差**；`样本=真` 时除以 n-1）。"""
    令 序 = _要非空(_取数字表(数据, "方差"), "方差")
    令 n = 长度(序)
    如果 样本 与 n < 2：
        抛出 值错误("样本方差至少要 2 个数（要除以 n-1）")
    令 总 = 0
    遍历 x 在 序：
        总 = 总 + x
    令 均 = 总 / n
    令 平方和 = 0
    遍历 x 在 序：
        平方和 = 平方和 + (x - 均) * (x - 均)
    如果 样本：
        返回 平方和 / (n - 1)
    返回 平方和 / n


函数 标准差(数据, 样本 = 假)：
    """返回标准差（方差的开方）。"""
    返回 _数学.开方(方差(数据, 样本))


函数 极差(数据)：
    """返回最大值与最小值的差。"""
    令 序 = _要非空(_取数字表(数据, "极差"), "极差")
    返回 最大(序) - 最小(序)


函数 分位数(数据, p)：
    """返回第 p 分位数（p 取 0–1）；用**线性插值**，与多数统计软件一致。"""
    令 tp = 类型(p)
    如果 tp != "整数" 与 tp != "小数"：
        抛出 类型错误("「分位数」的第二个参数要传 0 到 1 之间的小数")
    如果 p < 0 或 p > 1：
        抛出 值错误("分位数要在 0 到 1 之间，现在是 " + 文本(p))
    令 序 = _升序(数据, "分位数")
    如果 长度(序) == 1：
        返回 序[0]
    令 位置 = p * (长度(序) - 1)
    令 下 = _数学.向下取整(位置)
    令 上 = _数学.向上取整(位置)
    如果 下 == 上：
        返回 序[下]
    返回 序[下] + (序[上] - 序[下]) * (位置 - 下)


函数 去极值平均(数据, 去掉个数 = 1)：
    """去掉最大和最小的各「去掉个数」个之后求平均（比赛评分常用）。"""
    如果 类型(去掉个数) != "整数"：
        抛出 类型错误("「去掉个数」要传整数")
    如果 去掉个数 < 0：
        抛出 值错误("「去掉个数」不能是负数")
    令 序 = _升序(数据, "去极值平均")
    如果 去掉个数 * 2 >= 长度(序)：
        抛出 值错误("去掉 " + 文本(去掉个数) + " 个最高和最低之后就没数据了（一共 "
             + 文本(长度(序)) + " 个）")
    令 保留 = 序[去掉个数:长度(序) - 去掉个数]
    令 总 = 0
    遍历 x 在 保留：
        总 = 总 + x
    返回 总 / 长度(保留)


函数 加权平均(数据, 权重)：
    """返回加权平均数：每个数乘自己的权重再求和，除以权重之和。"""
    令 序 = _要非空(_取数字表(数据, "加权平均"), "加权平均")
    令 重 = _取数字表(权重, "加权平均的权重")
    如果 长度(序) != 长度(重)：
        抛出 值错误("数据和权重的个数不一样：" + 文本(长度(序)) + " 个数据、"
             + 文本(长度(重)) + " 个权重")
    令 重和 = 0
    遍历 w 在 重：
        重和 = 重和 + w
    如果 重和 == 0：
        抛出 值错误("权重之和是 0，没法算加权平均")
    令 积 = 0
    令 i = 0
    当 i < 长度(序)：
        积 = 积 + 序[i] * 重[i]
        i = i + 1
    返回 积 / 重和
