# 基石标准库 · 容器（**用基石自己写的库**）
#
# 「用基石写的标准库」的约定与判据见 `统计.jsh` 的模块头与
# `docs/设计决策.md` D45。这里只记本模块特有的两点：
#
#   ① **保序**是本模块的立命之本：`计数` 保「首次出现的顺序」，
#      `最多` / `按值排序` 平局时按**首次出现的先后** —— 结果可复现，
#      不随宿主字典的迭代顺序漂（M41 特意为它加过对拍用例）。
#      基石里靠「字典保插入序」+「`排序按` 是稳定排序」两条共同保证。
#   ② 比大小的键用 `0 - 次数` 取负来做**降序**（而不是「升序后反转」）——
#      反转会把平局项的顺序也翻过来，破坏保序。


函数 _取序列(数据, 名字)：
    """像 Python 侧 `_as_iterable` 那样把输入摊平成列表。

    文本按字符、字典按键、集合按元素、列表原样 —— 与 `遍历` 的语义一致，
    所以这里直接遍历就行；不能遍历的值报中文类型错误。
    """
    令 出 = []
    尝试：
        遍历 项 在 数据：
            出.追加(项)
    捕获 类型错误 为 _e：
        抛出 类型错误("「" + 文本(数据) + "」不能当「" + 名字 + "」的内容用")
    返回 出


函数 计数(可迭代)：
    """数每个元素出现了几次，返回「元素 → 次数」字典（保**首次出现**的顺序）。"""
    令 出 = {}
    遍历 项 在 _取序列(可迭代, "计数")：
        如果 项 在 出：
            出[项] = 出[项] + 1
        否则：
            出[项] = 1
    返回 出


函数 _按次数降序(表)：
    """把「元素 → 次数」字典转成 `[[元素, 次数], …]`，按次数降序、平局保序。

    `0 - 次数` 取负后再升序排 = 次数降序，**而且稳定排序会把平局的项留在
    它们原来的相对位置**（就是首次出现的先后）。用「升序排完再反转」会连
    平局顺序一起翻掉 —— 那是错的。
    """
    令 项 = []
    遍历 键 在 表：
        项.追加([键, 表[键]])
    # ⚠️ `排序按` **返回新列表**（不是原地排），必须接住返回值
    返回 项.排序按(函数(对)：0 - 对[1])


函数 最多(可迭代, 个数 = 1):
    """出现次数最多的前 `个数` 个，返回 [[元素, 次数], …]（降序，平局保序）。

    `个数=1` 时返回单个元素（不是列表），方便 `令 冠军 = 容器.最多(词)`。
    """
    令 n = 整数(个数)
    如果 n <= 0：
        抛出 类型错误("「最多」的个数要大于 0，得到了 " + 文本(个数))
    令 项 = _按次数降序(计数(可迭代))
    令 选出 = []
    令 i = 0
    当 i < n 与 i < 长度(项)：
        选出.追加(项[i])
        i = i + 1
    如果 n == 1：
        如果 长度(选出) == 0：
            返回 空
        返回 选出[0][0]
    返回 选出


函数 按值排序(频次字典, 降序 = 真)：
    """把「元素 → 次数」这类字典按**值**排成 [[元素, 值], …]（平局保序）。"""
    如果 类型(频次字典) != "字典"：
        抛出 类型错误("「按值排序」要一个字典，得到了「" + 类型(频次字典) + "」")
    令 项 = []
    遍历 键 在 频次字典：
        项.追加([键, 频次字典[键]])
    如果 降序：
        # ⚠️ `排序按` **返回新列表**（不是原地排）
        返回 项.排序按(函数(对)：0 - 对[1])
    返回 项.排序按(函数(对)：对[1])


函数 分组(可迭代, 键函数)：
    """按「键函数(元素)」的返回值分组，返回「键 → [元素, …]」（键保首次出现序）。"""
    令 出 = {}
    遍历 项 在 _取序列(可迭代, "分组")：
        令 键 = 键函数(项)
        如果 键 不在 出：
            出[键] = []
        出[键].追加(项)
    返回 出


函数 _取出前n(全部, n):
    令 i = 0
    令 出 = []
    当 i < n：
        出.追加(全部[i])
        i = i + 1
    返回 出


函数 取前(可迭代, 个数)：
    """取前 `个数` 个元素（不足就给全部）。"""
    令 全部 = _取序列(可迭代, "取前")
    令 n = 整数(个数)
    如果 n < 0：
        n = 0
    如果 n > 长度(全部)：
        n = 长度(全部)
    返回 _取出前n(全部, n)


函数 取后(可迭代, 个数)：
    """取后 `个数` 个元素（不足就给全部）。"""
    令 全部 = _取序列(可迭代, "取后")
    令 n = 整数(个数)
    如果 n < 0：
        n = 0
    如果 n > 长度(全部)：
        n = 长度(全部)
    令 起点 = 长度(全部) - n
    令 出 = []
    令 i = 起点
    当 i < 长度(全部)：
        出.追加(全部[i])
        i = i + 1
    返回 出


函数 分块(可迭代, 每块个数)：
    """把序列切成若干等长小块（最后一块可能短）。"""
    令 n = 整数(每块个数)
    如果 n <= 0：
        抛出 类型错误("「分块」的每块个数要大于 0，得到了 " + 文本(每块个数))
    令 全部 = _取序列(可迭代, "分块")
    令 出 = []
    令 i = 0
    当 i < 长度(全部)：
        剩余 = 长度(全部) - i
        如果 剩余 > n：
            剩余 = n
        出.追加(_取出前n(全部[i:长度(全部)], 剩余))
        i = i + n
    返回 出
