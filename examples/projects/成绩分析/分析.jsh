# 成绩分析 —— 用基石写的一个真实命令行工具
# 读取带表头的 CSV，输出总分排名 / 各科平均 / 最高分 / 不及格名单

导入 表格
导入 文本

函数 数字(值):
    # 把 CSV 里的文本列转成数字，转不动就返回 0
    尝试:
        返回 小数(值)
    捕获 值错误:
        返回 0

函数 总分(行, 科目):
    # 行是 [姓名, 语文, 数学, 英语]，科目是 ["语文","数学","英语"] 对应的列下标
    令 合计 = 0
    遍历 i 在 范围(1, 长度(行)):
        合计 = 合计 + 整数(数字(行[i]))
    返回 合计

函数 分析(文件路径):
    令 t = 表格.读表格(文件路径)
    令 名字列 = 表格.挑选(t, "姓名")
    令 科目 = ["语文", "数学", "英语"]
    令 行们 = 表格.数据行(t)

    打印("== 成绩分析 ==")
    打印(文本.格式化("共 {} 名学生", 长度(名字列)))
    打印()

    # 总分排名：构造 [总分, 姓名] 对，排序
    令 排名 = []
    遍历 行 在 行们:
        排名.追加([总分(行, 科目), 行[0]])
    排名.排序()
    令 排名 = 排名[::-1]  # 从高到低

    打印("总分排名：")
    遍历 i 在 范围(长度(排名)):
        令 名次 = i + 1
        打印(文本.格式化("  {}. {} {} 分", 名次, 排名[i][1], 排名[i][0]))
    打印()

    # 各科平均与最高
    打印("各科情况：")
    遍历 科 在 科目:
        令 分数列 = [数字(x) 遍历 x 在 表格.挑选(t, 科)]
        令 平均 = 总和(分数列) / 长度(分数列)
        令 最高 = 最大(分数列)
        打印(文本.格式化("  {}：平均 {:.1f}，最高 {}", 科, 平均, 最高))
    打印()

    # 不及格名单（任一科 < 60）
    打印("不及格名单：")
    令 有不及格 = 假
    遍历 行 在 行们:
        遍历 i 在 范围(1, 长度(行)):
            如果 数字(行[i]) < 60:
                打印(文本.格式化("  {}（{} {}）", 行[0], 科目[i - 1], 行[i]))
                有不及格 = 真
    如果 非 有不及格:
        打印("  全部及格，很棒！")

函数 主程序():
    # 支持命令行参数（jishi 分析.jsh 成绩.csv），也支持交互输入
    导入 系统
    令 参数们 = 系统.参数()
    令 路径 = ""
    如果 长度(参数们) > 0:
        路径 = 参数们[0]
    否则:
        打印("请输入 CSV 文件路径（直接回车用 成绩.csv）：")
        路径 = 输入()
    如果 路径 == "":
        路径 = "成绩.csv"
    尝试:
        分析(路径)
    捕获 文件错误 为 e:
        打印(文本.格式化("读文件失败：{}", e.消息))
        打印("请确认文件存在，且第一行是「姓名,语文,数学,英语」表头")

主程序()
