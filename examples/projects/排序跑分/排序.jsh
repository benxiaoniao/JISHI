# 排序跑分 —— 三个排序算法的正确性与耗时（算法练习类场景）
#
# 用法：
#     jishi 排序.jsh            跑默认规模（100 / 200 / 400）
#     jishi 排序.jsh 800        指定最大规模
#
# 想练的三件事：① 递归与列表推导式写出快排；② 用内建 `排序()` 当**裁判**
# 校验自己写的排序（正确性不能靠自己说了算）；③ 用 `时间.高精度时间` 量出
# 三种排序在同一批数据上的耗时差——把「复杂度」从课本上的符号变成表里的数字。

导入 文本 为 文本模块
导入 数学
导入 随机
导入 时间
导入 系统

函数 冒泡(数据):
    # O(n²)：相邻比较、大的往后冒
    令 结果 = 数据[:]
    令 n = 长度(结果)
    遍历 i 在 范围(0, n):
        令 换过 = 假
        遍历 j 在 范围(0, n - i - 1):
            如果 结果[j] > 结果[j + 1]:
                # 下标元素不能参与解包赋值（`a[i], a[j] = …` 不支持），
                # 老老实实用一个临时变量
                令 临时 = 结果[j]
                结果[j] = 结果[j + 1]
                结果[j + 1] = 临时
                换过 = 真
        如果 非 换过:
            中断  # 这一轮没换过 → 已经有序，提前收工
    返回 结果

函数 插入(数据):
    # O(n²)：把每个元素插到左边已排好的那段里
    令 结果 = 数据[:]
    遍历 i 在 范围(1, 长度(结果)):
        令 当前 = 结果[i]
        令 j = i - 1
        当 j >= 0 与 结果[j] > 当前:
            结果[j + 1] = 结果[j]
            j = j - 1
        结果[j + 1] = 当前
    返回 结果

函数 快速(数据):
    # 平均 O(n log n)：选基准、分两半、各自递归
    如果 长度(数据) <= 1:
        返回 数据[:]
    令 基准 = 数据[0]
    令 小 = [x 遍历 x 在 数据[1:] 如果 x < 基准]
    令 大 = [x 遍历 x 在 数据[1:] 如果 x >= 基准]
    返回 快速(小) + [基准] + 快速(大)

函数 造数据(规模):
    令 出 = []
    遍历 i 在 范围(规模):
        出.追加(随机.随机整数(0, 规模 * 10))
    返回 出

函数 耗时(排序函数, 数据):
    # 返回 (毫秒, 结果)，结果留给调用方校验。
    # 用标准库 `时间.计时`（M50）代替原先「取两次高精度时间再相减」——
    # 那样写有两处容易漏：忘了取结束时间、或忘了乘 1000 换算毫秒。
    用 时间.计时() 为 表:
        令 结果 = 排序函数(数据)
    返回 [表.耗时() * 1000, 结果]

函数 主程序():
    令 参数们 = 系统.参数()
    令 规模们 = [100, 200, 400]
    如果 长度(参数们) > 0:
        尝试:
            规模们 = [整数(参数们[0])]
        捕获 异常:
            打印(`「{参数们[0]}」不是规模数字，用默认规模`)
    令 选手们 = [["冒泡", 冒泡], ["插入", 插入], ["快速", 快速]]

    打印("== 排序跑分 ==")
    打印(`每种排序各跑一遍，随机整数数据；正确性用内建「排序()」当裁判。`)
    打印()
    令 表头 = 文本模块.左对齐("规模", 8)
    遍历 名, 排序法 在 选手们:
        表头 = 表头 + 文本模块.左对齐(名 + "(毫秒)", 14)
    打印(表头)
    打印("-" * (40))

    令 全部正确 = 真
    遍历 规模 在 规模们:
        令 数据 = 造数据(规模)
        令 期望 = 数据[:]
        期望.排序()
        令 行 = 文本模块.左对齐(规模, 8)
        遍历 名, 排序法 在 选手们:
            令 用时, 结果 = 耗时(排序法, 数据)
            如果 结果 != 期望:
                全部正确 = 假
                行 = 行 + 文本模块.左对齐("结果不对!", 14)
            否则:
                行 = 行 + 文本模块.左对齐(数学.四舍五入(用时, 2), 14)
        打印(行)

    打印()
    如果 全部正确:
        打印("三个排序的结果都与内建排序一致 ✅")
    否则:
        打印("有排序算错了 ❌ —— 先用小规模输入打印中间过程看是哪一步")

主程序()
