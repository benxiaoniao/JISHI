# 小网站 —— `HTTP服务端`（M115）+ `HTTP路由`（M122）的最小可用组合
#
# 跑：jishi 网站.jsh     然后浏览器开 http://127.0.0.1:8000/
# 停：Ctrl-C
#
# 想从命令行看效果：
#   curl http://127.0.0.1:8000/
#   curl http://127.0.0.1:8000/文章/1
#   curl http://127.0.0.1:8000/没有这个        ← 404 页会列出所有已注册的路

导入 HTTP服务端
导入 HTTP路由
# ⚠️ `导入 文本` 会把**内建函数** `文本(...)` 遮蔽掉 —— 而这里两个都要用
#    （`文本(序)` 转文本、`文本库.拼接(...)` 拼 HTML）⇒ 用别名导入。
导入 文本 为 文本库

令 页面类型 = "text/html; charset=utf-8"

# ---- 处理函数：签名统一是 `(请求, 参数)` ----
# `请求` 是 `解析请求` 给的那个字典（方法/路径/查询/请求头/正文）；
# `参数` 是路由里 `:名字` 抽出来的（没有参数就是空字典）。

函数 首页(请求, 参数)：
    令 链接们 = []
    遍历 序 在 [1, 2, 3]：
        令 地址 = "/文章/" + 文本(序)
        链接们.追加("<li><a href=\"" + 地址 + "\">第 " + 文本(序) + " 篇</a></li>")
    返回 HTTP服务端.构造响应(200,
        "<h1>基石小站</h1><p>用中文写的 HTTP 服务端。</p><ul>"
        +文本库.拼接(链接们, "") + "</ul>",
        页面类型)

函数 文章(请求, 参数)：
    令 号 = 参数["id"]
    如果 号 == "1"：
        返回 HTTP服务端.构造响应(200,
            "<h1>第一篇</h1><p>路由参数 id = 1。</p><a href=\"/\">回首页</a>", 页面类型)
    如果 号 == "2"：
        返回 HTTP服务端.构造响应(200,
            "<h1>第二篇</h1><p>路由参数 id = 2。</p><a href=\"/\">回首页</a>", 页面类型)
    如果 号 == "3"：
        返回 HTTP服务端.构造响应(200,
            "<h1>第三篇</h1><p>路由参数 id = 3。</p><a href=\"/\">回首页</a>", 页面类型)
    # 路由能匹配（`/文章/:id` 收任意一段），但这里没有这篇 —— 是**业务上的 404**
    返回 HTTP服务端.构造响应(404,
        "<h1>没有第 " + 号 + " 篇</h1><a href=\"/\">回首页</a>", 页面类型)

函数 关于(请求, 参数)：
    # `参数` 里能看到**查询串**？不在参数里 —— 查询串在 `请求["查询"]`
    令 谁 = "陌生人"
    # ⚠️ `包含` **不是内建函数**，是字典的方法（`d.包含(键)`）——
    #    这类「以为有其实没有」的坑，报错会直接告诉你「找不到名字「包含」」。
    如果 请求["查询"].包含("名字")：
        令 谁 = 请求["查询"]["名字"]
    返回 HTTP服务端.构造响应(200,
        "<h1>关于</h1><p>你好，" + 谁 + "。</p>", 页面类型)

# ---- 路由表 ----
令 表 = HTTP路由.路由表()
HTTP路由.加路由(表, "GET", "/", 首页)
HTTP路由.加路由(表, "GET", "/关于", 关于)
HTTP路由.加路由(表, "GET", "/文章/:id", 文章)

打印("路由表：", 文本库.拼接(HTTP路由.路径们(表), " · "))

# ---- 分发：把请求交给路由表 ----
# ⚠️ 写成**具名函数**而不是内联的 `函数(请求): …`：
#    基石的匿名函数是**表达式**，里面不能放 `令` 这类语句。
#    `表` 是顶层变量，具名函数直接读得到，不需要闭包。
函数 分发(请求)：
    令 命中 = HTTP路由.匹配 (表, 请求["方法"], 请求["路径"])
    如果 命中 == 空：
        # 404 页**列出所有已注册的路** —— 网址打错时，这一句比「没有这一页」有用得多
        令 行们 = []
        遍历 路 在 HTTP路由.路径们(表)：
            行们.追加("<li><code>" + 路 + "</code></li>")
        返回 HTTP服务端.构造响应(404,
            "<h1>404</h1><p>没有这个地址。已经有的：</p><ul>"
            +文本库.拼接(行们, "") + "</ul><a href=\"/\">回首页</a>",
            页面类型)
    返回 命中["处理"](请求, 命中["参数"])

# ---- 起服务 ----
# ⚠️ 只监听 127.0.0.1（安全默认）；要别人访问得改 `启动` 的口径，那是另一件事。
打印("打开 http://127.0.0.1:8000/   （Ctrl-C 停）")

HTTP服务端.启动(8000, 分发)
