# 待办清单 —— 用基石写的一个命令行工具（CLI 工具类场景）
#
# 数据存在同目录的 待办.json 里（一个列表，每项 {任务, 完成, 创建}）。
#
# 用法（在项目目录里跑）：
#     jishi 待办.jsh 列出
#     jishi 待办.jsh 添加 买牛奶
#     jishi 待办.jsh 添加 写周报 修自行车        # 多个词会拼成一条
#     jishi 待办.jsh 完成 2
#     jishi 待办.jsh 删除 1
#     jishi 待办.jsh 清空已完成
#
# 设计上刻意只用「标准库 + 文件」，不引第三方：CLI 工具该有的四件事——
# 命令行参数、文件持久化、格式化输出、出错时给人话——都在这里过一遍。

导入 文件
导入 系统
导入 时间
导入 json
导入 文本 为 文本模块

令 数据文件 = "待办.json"

函数 读任务():
    # 文件不存在 / 内容坏了都当成「空清单」，不让用户先去修 JSON
    如果 非 文件.文件存在(数据文件):
        返回 []
    尝试:
        令 内容 = json.读文件(数据文件)
        如果 类型(内容) == "列表":
            返回 内容
        返回 []
    捕获 异常:
        打印(`（{数据文件} 读不动，先按空清单处理）`)
        返回 []

函数 存任务(任务们):
    json.写文件(数据文件, 任务们, 2)

函数 用法():
    打印("用法：jishi 待办.jsh 命令 [参数]")
    打印("命令：")
    打印("  列出                  看全部任务（带序号）")
    打印("  添加 任务内容         加一条（多个词会拼成一条）")
    打印("  完成 序号             标记完成")
    打印("  取消完成 序号         把标记撤回去")
    打印("  删除 序号             删掉一条")
    打印("  清空已完成            把已完成的全删掉")

函数 展示(任务们):
    如果 长度(任务们) == 0:
        打印("（清单是空的，先「添加」一条吧）")
        返回
    令 已完成 = 0
    打印("== 待办清单 ==")
    # 解包遍历（M41）：不用再自己按下标取
    遍历 序号, 项 在 带下标(任务们, 1):
        令 标记 = "√" 如果 项.获取("完成", 假) 否则 " "
        打印(`  [{标记}] {序号}. {项.获取("任务", "")}`)
        如果 项.获取("完成", 假):
            已完成 = 已完成 + 1
    打印()
    打印(`共 {长度(任务们)} 条：已完成 {已完成}，未完成 {长度(任务们) - 已完成}`)

函数 取序号(参数们):
    # 序号是给人看的（从 1 开始），错了要明确说是哪一步错了。
    如果 长度(参数们) < 1:
        打印("这条命令需要一个序号，例如：jishi 待办.jsh 完成 2")
        返回 -1
    尝试:
        返回 整数(参数们[0]) - 1
    捕获 值错误:
        # 归类与 Python 一致（M41）：`整数("abc")` 抛值错误。
        # 捕获得更精确之后，真出别的错（比如内存不足）不会被这里吞掉。
        打印(`「{参数们[0]}」不是序号——序号是数字，例如 3`)
        返回 -1

函数 校验(下标, 任务们):
    如果 下标 < 0:
        返回 假
    如果 下标 >= 长度(任务们):
        打印(`清单里没有第 {下标 + 1} 条（共 {长度(任务们)} 条）`)
        返回 假
    返回 真

函数 主程序():
    令 参数们 = 系统.参数()
    如果 长度(参数们) == 0:
        用法()
        返回
    令 命令 = 参数们[0]
    令 其余 = 参数们[1:]
    令 任务们 = 读任务()

    如果 命令 == "列出":
        展示(任务们)
        返回

    如果 命令 == "添加":
        如果 长度(其余) == 0:
            打印("要加什么？例如：jishi 待办.jsh 添加 买牛奶")
            返回
        令 内容 = 文本拼接(其余)
        任务们.追加({"任务": 内容, "完成": 假, "创建": 时间.现在()})
        存任务(任务们)
        打印(`已添加第 {长度(任务们)} 条：{内容}`)
        返回

    如果 命令 == "完成" 或 命令 == "取消完成":
        令 下标 = 取序号(其余)
        如果 非 校验(下标, 任务们):
            返回
        任务们[下标]["完成"] = 命令 == "完成"
        存任务(任务们)
        打印(`第 {下标 + 1} 条现在：{任务们[下标]["任务"]}（{命令}）`)
        返回

    如果 命令 == "删除":
        令 下标 = 取序号(其余)
        如果 非 校验(下标, 任务们):
            返回
        令 去掉的 = 任务们.弹出(下标)
        存任务(任务们)
        打印(`已删除：{去掉的["任务"]}`)
        返回

    如果 命令 == "清空已完成":
        令 保留 = []
        遍历 项 在 任务们:
            如果 非 项.获取("完成", 假):
                保留.追加(项)
        令 去掉几条 = 长度(任务们) - 长度(保留)
        存任务(保留)
        打印(`清掉了 {去掉几条} 条已完成，还剩 {长度(保留)} 条`)
        返回

    打印(`不认识这个命令：「{命令}」`)
    打印()
    用法()

函数 文本拼接(词们):
    # `添加 写 周报` 会拆成多个参数，拼回一条任务
    返回 文本模块.拼接(词们, " ")

主程序()
