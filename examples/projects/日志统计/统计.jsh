# 日志统计 —— 用基石写的真实日志分析工具
# 读访问日志（每行 "IP 方法 路径 状态码"），统计访问量/独立IP/状态码/热门路径

导入 容器
函数 解析行(行):
    # "192.168.1.1 - GET /首页 200" → 段 = [IP, "-", 方法, 路径, 状态码]
    # 返回 [IP, 路径, 状态码]
    令 段 = 行.拆分(" ")
    如果 长度(段) < 5:
        返回 空
    返回 [段[0], 段[3], 段[4]]

函数 统计(日志路径):
    # 用上下文管理器读文件（M26）：块一结束就自动关闭，不用惦记关文件。
    # 直接遍历文件对象是**流式**的——整份日志不必先读进内存。
    令 有效 = []
    用 打开(日志路径) 为 日志:
        遍历 行 在 日志:
            令 行 = 行.去空白()
            如果 行 != "":
                令 解析 = 解析行(行)
                如果 解析 != 空:
                    有效.追加(解析)

    如果 长度(有效) == 0:
        打印("日志里没有可解析的请求")
        返回

    打印("== 日志统计 ==")
    打印(`总请求数：{长度(有效)}`)

    # 独立 IP（容器.计数 替代原先手写的「有就加一、没有就置一」）
    令 ip列表 = [行[0] 遍历 行 在 有效]
    打印(`独立 IP 数：{长度(容器.计数(ip列表))}`)
    打印()

    # 状态码分布
    令 状态码 = [行[2] 遍历 行 在 有效]
    令 码频次 = 容器.计数(状态码)
    打印("状态码分布：")
    遍历 码, 次数 在 容器.按值排序(码频次):
        打印(`  {码}：{次数} 次`)
    打印()

    # 访问最多的路径 Top5
    令 路径 = [行[1] 遍历 行 在 有效]
    令 排序后 = 容器.按值排序(容器.计数(路径))
    打印("访问最多的路径：")
    遍历 名, 次数 在 容器.取前(排序后, 5):
        打印(`  {名}：{次数} 次`)
    打印()

    # 404 请求的 IP
    打印("404 请求的 IP：")
    令 有404 = 假
    遍历 行 在 有效:
        如果 行[2] == "404":
            打印(`  {行[0]}`)
            有404 = 真
    如果 非 有404:
        打印("  （无 404 请求）")

函数 主程序():
    打印("请输入日志文件路径（直接回车用 访问.log）：")
    令 路径 = 输入()
    如果 路径 == "":
        路径 = "访问.log"
    尝试:
        统计(路径)
    捕获 文件错误 为 e:
        打印(`读日志失败：{e.消息}`)

主程序()
