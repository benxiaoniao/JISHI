# 网页采集 —— 用基石写的真实爬虫工具
# 抓网页 → 正则提取链接 → 存 CSV → 统计域名分布

导入 网络
导入 正则
导入 表格

函数 提取链接(html):
    # 匹配 <a href="网址">标题</a>，用捕获分组
    # 模式里有双引号，用中文引号作字符串定界符避免冲突
    令 模式 = “<a[^>]+href="([^"]+)"[^>]*>(.*?)</a>”
    令 匹配组 = 正则.查找全部(模式, html)
    令 结果 = []
    遍历 组 在 匹配组:
        令 网址 = 组[0]
        令 标题 = 正则.替换("<[^>]+>", "", 组[1])  # 去掉标题里的标签
        标题 = 标题.去空白()
        如果 网址.开头是("http"):
            结果.追加([标题, 网址])
    返回 结果

函数 域名(网址):
    # 从 http://域名/路径 里抽出域名
    令 去协议 = 正则.替换("^https?://", "", 网址)
    令 分段 = 去协议.拆分("/")
    返回 分段[0]

函数 统计域名(链接们):
    令 频次 = {}
    遍历 链 在 链接们:
        令 域 = 域名(链[1])
        如果 频次.包含(域):
            频次[域] = 频次[域] + 1
        否则:
            频次[域] = 1
    返回 频次

函数 主程序():
    打印("请输入要采集的网址：")
    令 网址 = 输入().去空白()
    如果 网址 == "":
        打印("网址不能为空")
        返回

    打印(`正在抓取 {网址} ...`)
    尝试:
        令 html = 网络.获取(网址)
    捕获 运行期错误 为 e:
        打印(`抓取失败：{e.消息}`)
        返回

    令 链接们 = 提取链接(html)
    打印(`共提取到 {长度(链接们)} 个链接`)
    打印()

    # 存 CSV
    表格.写表格("链接.csv", [["标题", "网址"]] + 链接们)
    打印("已保存到 链接.csv")
    打印()

    # 域名分布
    令 频次 = 统计域名(链接们)
    打印("域名分布（去重后）：")
    遍历 域 在 频次:
        打印(`  {域}：{频次[域]} 个`)

主程序()
