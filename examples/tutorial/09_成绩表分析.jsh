# 第 6 章示例：成绩表分析（表格模块）
导入 表格
导入 文件

# 先造一张成绩表（真实场景用 表格.读表格 读现成的 CSV 文件）
表格.写表格("成绩.csv", [
    ["姓名", "分数"],
    ["小明", "85"],
    ["小红", "92"],
    ["小刚", "78"],
    ["小丽", "88"],
])

令 t = 表格.读表格("成绩.csv")
打印("表头：", 表格.表头(t))
打印("姓名列：", 表格.挑选(t, "姓名"))

# 统计
令 s = 表格.汇总(t, "分数")
打印("平均分：", s["平均"])
打印("最高分：", s["最大"], "，最低分：", s["最小"])

# 排序找第一名
令 从高到低 = 表格.排序按(t, "分数", 真)
打印("第一名：", 表格.挑选(从高到低, "姓名")[0])

# 清理演示文件
文件.删除文件("成绩.csv")
打印("演示完成")
