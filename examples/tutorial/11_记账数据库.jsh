# 第 11 章配套示例：把账存进数据库（SQLite）
#
# 运行：jishi examples/tutorial/11_记账数据库.jsh
# 会在**当前目录**建一个「账目.db」，跑完自己删掉。
#
# 两个要点先记住：
# ① 金额一律存「分」（25.50 元 → 2550 分）—— 钱不能拿浮点累加；
# ② 查出来的记录是**字典列表**，跟 `表格.读表格` 那种「行列表」不一样。

导入 数据库
导入 文件
# ⚠️ `导入 文本` 会把内建的 `文本(...)` 遮掉（第 11 章「坑」一节讲过），
#    要两个都用就**别名导入**。
导入 文本 为 文本库

令 库文件 = "账目.db"
令 库 = 数据库.打开(库文件)

# 建表不用写类型（SQLite 是动态类型）；每张表自动带一个 id。
# 重复跑也不会出错：已经有的表/索引不动它。
数据库.建表(库, "账目", ["日期", "类别", "金额分", "备注"])
数据库.建索引(库, "账目", ["类别"])

# 分 → 「8.50 元」这样的文本
函数 元(分)：
    返回 文本库.小数位(分 / 100, 2)

# 记一笔：元 → 分用 `精确` 转，别让浮点碰钱
函数 记一笔(日期, 类别, 金额, 备注 = "")：
    数据库.插入(库, "账目", {
        "日期"：日期,
        "类别"：类别,
        "金额分"：整数(精确(金额) * 100),
        "备注"：备注,
    })

记一笔("2026-10-01", "餐饮", 8.5, "早餐")
记一笔("2026-10-01", "交通", 4, "地铁")

# 一次记很多条：同一个事务，比一条条插快得多
令 新记的 = 数据库.批量插入(库, "账目", [
    {"日期"："2026-10-02", "类别"："餐饮", "金额分"：1500, "备注"："午饭"},
    {"日期"："2026-10-02", "类别"："购物", "金额分"：8990, "备注"："键盘"},
    {"日期"："2026-10-03", "类别"："餐饮", "金额分"：2200, "备注"："聚餐"},
])
打印("新记了", 新记的, "笔；一共", 数据库.条数(库, "账目"), "笔")

# 查：最有用的三个参数都在这儿 —— 排序、倒序、条数
打印("---- 最近两笔 ----")
遍历 账 在 数据库.查询(库, "账目", 空, "id", 真, 2)：
    打印(账["日期"], 账["类别"], 元(账["金额分"]), "元", 账["备注"])

# 查：条件是个字典（字段 → 值）；比大小就嵌一层（字段 → {符号: 值}）
打印("---- 超过 50 元的（从贵到便宜）----")
遍历 账 在 数据库.查询(库, "账目", {"金额分"：{">"：5000}}, "金额分", 真)：
    打印(账["日期"], 账["类别"], 元(账["金额分"]), "元")

# 汇总：按「类别」分组，对「金额分」求和 —— 形状与 `表格.汇总` 一模一样
打印("---- 分类汇总 ----")
令 各类 = 数据库.汇总(库, "账目", "类别", "金额分")
遍历 类别 在 各类：
    令 统 = 各类[类别]
    打印(类别, 统["个数"], "笔，合计", 元(统["总和"]), "元，平均", 元(统["平均"]), "元")

# 改：备注写错了就改（返回改了几行）
打印("改备注 →", 数据库.修改(库, "账目", {"备注"："早餐"}, {"备注"："早餐（豆浆+包子）"}))

# 删：记错了就删（返回删了几行）
打印("删掉地铁 →", 数据库.删除(库, "账目", {"类别"："交通", "金额分"：400}))

# 逃生口：真要写 SQL 也行
打印("---- 手写 SQL：每类几笔 ----")
遍历 行 在 数据库.执行查询(库, "SELECT 类别, COUNT(*) AS 笔数 FROM 账目 GROUP BY 类别 ORDER BY MIN(rowid)")：
    打印(行["类别"], 行["笔数"])

# 关掉库、删掉文件（示例不留垃圾）
数据库.关闭(库)
文件.删除文件(库文件)
打印("演示完成（账目.db 已清理）")
