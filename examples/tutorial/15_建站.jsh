# 第 15 章 · 建站
#
# 用「站点」模块把几个页面拼成一个**能直接传服务器**的静态站。
# 跑：jishi 15_建站.jsh
# 产物：建站示例/（HTML + CSS + sitemap.xml，纯静态，不需要后端）
#
# 本站的四条规矩：可复现（两次生成字节相同）、样式表带内容指纹、
# 不引框架不引 CDN、五个执行器输出逐字一致。

导入 站点
导入 html

# ---------------------------------------------------------------------------
# 1. 布局：整站共用的那几项（标题后缀、品牌、导航、脚注、样式）
# ---------------------------------------------------------------------------
# 没给的键都有默认值；导航项是 [地址, 文字] 的列表。
令 布局表 = 站点.布局({
    "标题后缀":"小站",
    "品牌":"小站",
    "品牌副":"demo",
    "导航项":[["index.html", "首页"], ["文章.html", "文章"]],
    "脚注":"由基石生成 · 站点模块示例",
    "网址前缀":"https://例子.cn",  # sitemap 里用的绝对前缀
})

# 想知道布局长什么样，打印出来看（字典会原样显示）
打印(布局表["语言"] + " / " + 布局表["样式文件"])
打印(长度(布局表["样式"]) > 0)

# ---------------------------------------------------------------------------
# 2. 页面：每页就是「路径 + 标题 + 正文」
# ---------------------------------------------------------------------------
# 正文是 **HTML 片段**，通常用 html 模块拼。用户输入一律先 html.转义。
令 文章们 = [
    ["第一篇", "今天学会了用基石建站。"],
    ["第二篇", "样式指纹替我解决了缓存问题。"],
]

令 目录 = []
遍历 i 在 范围(0, 长度(文章们)):
    令 条 = 文章们[i]
    目录.追加(html.标签("li", html.标签("a", 条[0], {"href": "文章.html"})))

令 首页正文 = (html.标签("h1", "首页")
    +html.标签("p", "这一页是基石写出来的。", {"类名": "lead"})
    +html.标签("h2", "文章")
    +html.无序列表(目录))

令 文章正文 = html.标签("h1", "文章")
遍历 条 在 文章们:
    文章正文 = 文章正文 + html.标签("h2", 条[0]) + html.标签("p", 条[1])

令 页们 = [
    {"路径": "index.html", "标题": "首页", "正文": 首页正文},
    {"路径": "文章.html", "标题": "文章", "正文": 文章正文},
]

# 只看不落盘：渲染返回 [[路径, 内容], …]
令 已渲染 = 站点.渲染(页们, 布局表)
打印(`共 {长度(已渲染)} 页，首页 {长度(已渲染[0][1])} 字节`)

# ---------------------------------------------------------------------------
# 3. 写站：页面 + 带指纹的样式表 + sitemap
# ---------------------------------------------------------------------------
令 统计 = 站点.写站("建站示例", 页们, 布局表)
打印(`页面 {统计["页面数"]} 个`)
打印(`样式表 {统计["样式文件"]}`)  # 名字里带内容指纹
打印(`站点地图 {统计["sitemap"]}`)
打印("把这个目录整个传上去就能访问。")

# 指纹还能单独算：同样内容同样指纹，改一个字就变
打印(站点.资源指纹("abc"))
打印(站点.资源指纹("abd"))
