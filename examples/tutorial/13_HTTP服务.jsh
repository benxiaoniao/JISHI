# 第 13 章配套示例（下）：真起一个服务
#
# 运行：jishi examples/tutorial/13_HTTP服务.jsh
# 然后浏览器打开 http://127.0.0.1:8000 （或 curl 一下）
#
# ⚠️ 第三个参数是「服务 10 个请求就退」—— 方便演示与自动化（浏览器还会偷偷请求
#    /favicon.ico，所以别把这个数定得太小）。**要一直开着就删掉第三个参数**。
#
# ⚠️ 只有 **Python / Rust / C VM** 能起服务；**Node 宿主**与**浏览器试玩页**
#    会明确报一句「这个平台没有 HTTP 服务端」—— 见 D81 的取舍。

导入 HTTP服务端
导入 HTTP路由
导入 json
导入 文本 为 文本库

令 成绩们 = [
    {"姓名": "小明", "语文": 92, "数学": 88},
    {"姓名": "小红", "语文": 85, "数学": 97},
    {"姓名": "小刚", "语文": 78, "数学": 66},
]

函数 首页(请求, 参数)：
    令 页 = "<h1>成绩查询</h1><ul>"
    页 = 页 + "<li><a href=\"/成绩/小明\">/成绩/小明</a></li>"
    页 = 页 + "<li><a href=\"/排行\">/排行</a></li>"
    页 = 页 + "</ul>"
    返回 HTTP服务端.构造响应(200, 页, "text/html; charset=utf-8")

函数 查某人(请求, 参数)：
    遍历 人 在 成绩们：
        如果 人["姓名"] == 参数["姓名"]：
            返回 HTTP服务端.构造响应(200, json.转文本(人),
                                     "application/json; charset=utf-8")
    返回 HTTP服务端.构造响应(404, json.转文本({"错": "没有这个学生"}),
                             "application/json; charset=utf-8")

函数 排行(请求, 参数)：
    令 行们 = []
    遍历 人 在 成绩们：
        行们.追加([人["姓名"], 人["语文"] + 人["数学"]])
    令 升 = 行们.排序按(取第二项)
    升.反转()
    令 出 = []
    遍历 对 在 配对(升, 范围(1, 长度(升) + 1)):
        出.追加({"名次": 对[1], "姓名": 对[0][0], "总分": 对[0][1]})
    返回 HTTP服务端.构造响应(200, json.转文本(出),
                             "application/json; charset=utf-8")

函数 取第二项(行)：
    返回 行[1]

令 表 = HTTP路由.路由表()
HTTP路由.加路由(表, "GET", "/", 首页)
HTTP路由.加路由(表, "GET", "/成绩/:姓名", 查某人)
HTTP路由.加路由(表, "GET", "/排行", 排行)

函数 处理(请求)：
    令 命中 = HTTP路由.匹配 (表, 请求["方法"], 请求["路径"])
    如果 命中 == 空:
        返回 HTTP服务端.构造响应(404, "没有这一页")
    返回 命中["处理"](请求, 命中["参数"])

# 端口单独放一个变量：换个口只要改这一行（也方便自动化测试换端口）
令 端口 = 8000
打印(文本库.格式化("服务已起：http://127.0.0.1:{}   （Ctrl-C 停）", 端口))
令 结果 = HTTP服务端.启动(端口, 处理, 10)
打印(文本库.格式化("服务已停：共处理 {} 个请求（端口 {}）",
                    结果["请求数"], 结果["端口"]))
