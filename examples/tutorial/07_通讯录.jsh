# 第 5 章示例：通讯录——字典的典型用法
令 通讯录 = {"小明"："13800000001", "小红"："13800000002"}

# 添加与修改
通讯录["小刚"] = "13800000003"
通讯录["小明"] = "13900000001"  # 同样的键会覆盖旧值

# 查询
打印("小红的电话：", 通讯录.获取("小红"))
打印("小刚的电话：", 通讯录.获取("不存在的人", "没有登记"))

# 遍历所有联系人
遍历 姓名 在 通讯录.键()：
    打印(姓名, "的电话是", 通讯录.获取(姓名))

打印("共", 长度(通讯录), "位联系人")
通讯录.弹出("小明")
打印("删除后剩", 长度(通讯录), "位")
