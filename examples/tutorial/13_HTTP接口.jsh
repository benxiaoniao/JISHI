# 第 13 章配套示例（上）：接口的「纯函数」这一半
#
# 运行：jishi examples/tutorial/13_HTTP接口.jsh
# 不起服务、不占端口 —— 用 `解析请求` 造假请求，把处理函数当普通函数测。
#
# 这么写有两个好处：
# ① 五个执行器都能跑（`启动` 在 Node 宿主与浏览器试玩页里明确不支持）；
# ② 改一行就能重跑，不用开浏览器点来点去。

导入 HTTP服务端
导入 HTTP路由
导入 json
导入 文本 为 文本库

令 成绩们 = [
    {"姓名": "小明", "语文": 92, "数学": 88},
    {"姓名": "小红", "语文": 85, "数学": 97},
    {"姓名": "小刚", "语文": 78, "数学": 66},
]

# `列表.排序按` 要一个「取键函数」，所以先给它一个名字
函数 总分(行)：
    返回 行[1]

# ---- 一、处理函数：入参是「请求字典 + 路径参数」，出参是**一段响应文本** ----
函数 首页(请求, 参数)：
    返回 HTTP服务端.构造响应(200, "<h1>成绩查询</h1><p>试试 /成绩/小明</p>",
                             "text/html; charset=utf-8")

函数 查某人(请求, 参数)：
    遍历 人 在 成绩们：
        如果 人["姓名"] == 参数["姓名"]：
            返回 HTTP服务端.构造响应(
                200, json.转文本(人), "application/json; charset=utf-8")
    返回 HTTP服务端.构造响应(404, json.转文本({"错": "没有这个学生"}))

函数 排行(请求, 参数)：
# 查询参数都在 `请求["查询"]` 里（`?前=2` 解成 {"前": "2"}）；没给就用 3
    令 前几 = 3
    如果 请求["查询"].包含("前"):
        前几 = 整数(请求["查询"]["前"])
    令 人门 = []
    遍历 人 在 成绩们:
        人门.追加([人["姓名"], 人["语文"] + 人["数学"]])
    令 升 = 人门.排序按(总分)  # `排序按` 返回新列表（原列表不动）
    升.反转()  # `反转` 才是原地
    令 单 = []
    遍历 对 在 配对(升[0:前几], 范围(1, 前几 + 1)):
        单.追加({"名次": 对[1], "姓名": 对[0][0], "总分": 对[0][1]})
    返回 HTTP服务端.构造响应(200, json.转文本(单),
                             "application/json; charset=utf-8")

# ---- 二、路由表：路径 → 处理函数（`:名字` 是任意一段，会进「参数」）----
令 表 = HTTP路由.路由表()
HTTP路由.加路由(表, "GET", "/", 首页)
HTTP路由.加路由(表, "GET", "/成绩/:姓名", 查某人)
HTTP路由.加路由(表, "GET", "/排行", 排行)
打印("已注册：", HTTP路由.路径们(表))

# ---- 三、不起服务也能测：造一个请求，走一遍「匹配 → 处理」----
函数 走一遍(方法, 目标):
    令 原文 = 方法 + " " + 目标 + " HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n"
    令 请求 = HTTP服务端.解析请求(原文)
    令 命中 = HTTP路由.匹配 (表, 请求["方法"], 请求["路径"])
    如果 命中 == 空:
        返回 HTTP服务端.构造响应(404, "没有这一页")
    返回 命中["处理"](请求, 命中["参数"])

# 一条完整响应长什么样（第一行是状态行，空行之后才是正文）
打印("---- 一条完整响应 ----")
打印(走一遍("GET", "/"))

# 后面只看「状态行 + 正文最后一行」就够
函数 看一眼(方法, 目标):
    令 应答 = 走一遍(方法, 目标)
    令 段 = 文本库.按行拆分(应答)
    打印(方法, 目标, "→", 段[0], "｜", 段[长度(段) - 1])

打印("---- 几条请求 ----")
看一眼("GET", "/成绩/小明")
看一眼("GET", "/成绩/不存在")
看一眼("GET", "/排行?前=2")
看一眼("GET", "/没有这个路径")
看一眼("POST", "/")
