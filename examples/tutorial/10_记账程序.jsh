# 第 7 章示例：记账程序（综合实战）
# 用到：函数、字典、文件、表格、时间、判断、循环
导入 表格
导入 时间
导入 文件

令 账本 = "账本.csv"

# 第一次运行时建立账本（表头）
如果 非 文件.文件存在(账本)：
    表格.写表格(账本, [["日期", "项目", "金额"]])

# 记一笔：一行代码完成录入
函数 记一笔(项目, 金额)：
    表格.追加(账本, [时间.今天(), 项目, 文本(金额)])

记一笔("早餐", 8)
记一笔("地铁", 4)
记一笔("买书", 45)
记一笔("午餐", 15)

# 读取账本并统计
令 t = 表格.读表格(账本)
令 s = 表格.汇总(t, "金额")
打印("共", s["个数"], "笔，合计", s["总和"], "元")

# 找出最贵的一笔
令 从贵到便宜 = 表格.排序按(t, "金额", 真)
打印("最贵的一笔：", 表格.挑选(从贵到便宜, "项目")[0])

# 全部账目
打印("---- 全部账目 ----")
遍历 行 在 表格.数据行(t)：
    打印(行[0], 行[1], 行[2], "元")

# 清理演示文件
文件.删除文件(账本)
打印("演示完成（账本已清理）")
