# 面向对象 —— 类 / 继承 / 新建
# 演示：用类组织数据和行为，用继承复用代码

# 一个基础类：动物
类 动物:
    函数 初始化(自身, 名字):
        自身.名字 = 名字
    函数 叫(自身):
        打印(自身.名字, "在叫")

# 继承：猫 复用 动物 的方法，覆盖「叫」
类 猫 继承 动物:
    函数 叫(自身):
        打印(自身.名字, "喵喵")

# 继承：狗 复用「叫」，新增自己的方法
类 狗 继承 动物:
    函数 摇尾(自身):
        打印(自身.名字, "摇尾巴")

# 一个带状态和行为的类：银行账户
类 账户:
    函数 初始化(自身, 余额):
        自身.余额 = 余额
    函数 存(自身, 数额):
        自身.余额 = 自身.余额 + 数额
    函数 取(自身, 数额):
        如果 数额 > 自身.余额:
            抛出 值错误("余额不足")
        自身.余额 = 自身.余额 - 数额
    函数 查(自身):
        返回 自身.余额

# 用起来
令 咪咪 = 新建 猫("咪咪")
咪咪.叫()

令 旺财 = 新建 狗("旺财")
旺财.叫()
旺财.摇尾()

令 我的账户 = 新建 账户(100)
我的账户.存(50)
打印("账户余额：", 我的账户.查())

# 账户和异常配合：取款过多会抛出 值错误
尝试:
    我的账户.取(999)
捕获 值错误 为 e:
    打印("取款失败：", e.消息)
