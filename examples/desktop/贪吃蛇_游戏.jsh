# 贪吃蛇 —— M188 的第二个示例（纯网格逻辑）
#
# 跑：在仓库根执行  jishi examples/desktop/贪吃蛇.jsh
#     进去就能玩：方向键（或者 W A S D）转弯，吃到红点长一节、快一点。
#
# 和打砖块一样分三件：
#   · `贪吃蛇.jsh`       桌面入口（只开窗）
#   · `贪吃蛇_游戏.jsh`  游戏本体（**唯一源码**，官网试玩页跑的也是这份）
#   · `贪吃蛇.html`      页面（画布 + 一句 data-游戏）
#
# 为什么选它当第二个：**没有浮点物理**，全是网格与整数 —— 正好把
# 「状态机 + 存档 + 输入」这条线单独验一遍，出问题时不会和碰撞混在一起。

导入 图形
导入 声音
导入 存档
导入 随机
导入 数学

令 格 = 24
令 列数 = 20
令 行数 = 20
令 画布宽 = 格 * 列数
令 画布高 = 格 * 行数

#: 蛇**头在末尾**（`蛇[长度 - 1]`），尾巴在 `蛇[0]`。
#: 为什么这么存：走一步 = 追加新头 + 弹掉旧尾，两个操作都不用「按索引插入」。
令 游戏 = {
    "蛇":[],
    "方向":{"x": 1, "y": 0},
    "食物":{"x": 10, "y": 10},
    "分数":0,
    "最高分":0,
    "状态":"玩",
    "累计":0,
    "间隔":150,
    "音":0,
}

# ---------------------------------------------------------------------------
# 一、开局 / 重开 / 食物
# ---------------------------------------------------------------------------

函数 找空位()：
    令 试 = 0
    当 试 < 300：
        令 x = 随机.随机整数(0, 列数 - 1)
        令 y = 随机.随机整数(0, 行数 - 1)
        令 撞 = 假
        遍历 节 在 游戏["蛇"]：
            如果 节["x"] == x 与 节["y"] == y：
                撞 = 真
        如果 非 撞：
            返回 {"x": x, "y": y}
        试 = 试 + 1
# 蛇把整盘占满了（几乎不可能）：随便给一格，别死循环
    返回 {"x": 0, "y": 0}

函数 前方食物()：
# 开局那颗放在**正前方 4 格**：玩家一进来就知道该往哪走，
# 而不是盯着蛇原地发呆（顺带让判据能确定地验「吃到 → 加分 → 变长」）。
    令 头 = 游戏["蛇"][长度(游戏["蛇"]) - 1]
    令 前 = 头["x"] + 4
    如果 前 < 列数：
        返回 {"x": 前, "y": 头["y"]}
    返回 找空位()

函数 重开()：
    游戏["蛇"] = [{"x": 5, "y": 10}, {"x": 6, "y": 10}, {"x": 7, "y": 10}]
    游戏["方向"] = {"x": 1, "y": 0}
    游戏["分数"] = 0
    游戏["状态"] = "玩"
    游戏["累计"] = 0
    游戏["间隔"] = 150
    游戏["食物"] = 前方食物()

函数 初始化()：
    图形.准备({"宽": 画布宽, "高": 画布高, "背景": "#0b1020"})
    游戏["音"] = 声音.载入("碰.wav")
    游戏["最高分"] = 存档.读("贪吃蛇最高分", 0)
    重开()
    打印("贪吃蛇：方向键 / W A S D 转弯，空格重开")

# ---------------------------------------------------------------------------
# 二、每一步
# ---------------------------------------------------------------------------

函数 响一下(音量)：
# 没解锁 / 没解码完时 `播放` 返回假，不报错（见 D111）
    声音.播放(游戏["音"], {"音量": 音量})

函数 结束()：
    游戏["状态"] = "结束"
    如果 游戏["分数"] > 游戏["最高分"]：
        游戏["最高分"] = 游戏["分数"]
        存档.存("贪吃蛇最高分", 游戏["最高分"])

函数 走一步()：
    令 蛇 = 游戏["蛇"]
    令 头 = 蛇[长度(蛇) - 1]
    令 新 = {"x": 头["x"] + 游戏["方向"]["x"], "y": 头["y"] + 游戏["方向"]["y"]}

# ① 撞墙
    如果 新["x"] < 0 或 新["x"] >= 列数 或 新["y"] < 0 或 新["y"] >= 行数：
        结束()
        返回

# ② 撞自己：尾巴这一节下一步会让位，所以从第 1 节查到倒数第 2 节
#    （第 0 节是尾巴，不吃食物时它会被弹掉）
    令 i = 1
    当 i < 长度(蛇)：
        令 节 = 蛇[i]
        如果 节["x"] == 新["x"] 与 节["y"] == 新["y"]：
            结束()
            返回
        i = i + 1

    蛇.追加(新)
    如果 新["x"] == 游戏["食物"]["x"] 与 新["y"] == 游戏["食物"]["y"]：
        游戏["分数"] = 游戏["分数"] + 10
        游戏["间隔"] = 数学.限制(游戏["间隔"] - 4, 70, 400)
        游戏["食物"] = 找空位()
        响一下(0.5)
    否则：
        蛇.弹出(0)

函数 转向()：
    令 方 = 游戏["方向"]
    令 上 = 图形.按过("上") 或 图形.按过("w")
    令 下 = 图形.按过("下") 或 图形.按过("s")
    令 左 = 图形.按过("左") 或 图形.按过("a")
    令 右 = 图形.按过("右") 或 图形.按过("d")
# 不能原地掉头（`否则如果` 保证一帧只认一个方向）
    如果 上 与 方["y"] == 0：
        游戏["方向"] = {"x": 0, "y": -1}
    否则如果 下 与 方["y"] == 0：
        游戏["方向"] = {"x": 0, "y": 1}
    否则如果 左 与 方["x"] == 0：
        游戏["方向"] = {"x": -1, "y": 0}
    否则如果 右 与 方["x"] == 0：
        游戏["方向"] = {"x": 1, "y": 0}

# ---------------------------------------------------------------------------
# 三、每帧
# ---------------------------------------------------------------------------

函数 每帧(号, 间隔毫秒)：
    如果 游戏["状态"] == "玩"：
        转向()
        游戏["累计"] = 游戏["累计"] + 间隔毫秒
        # 一帧最多走 4 步：卡了一下不该让蛇"瞬移穿墙"
        令 步 = 0
        当 游戏["累计"] >= 游戏["间隔"] 与 步 < 4 与 游戏["状态"] == "玩"：
            游戏["累计"] = 游戏["累计"] - 游戏["间隔"]
            走一步()
            步 = 步 + 1
    否则：
        如果 图形.按过("空格") 或 图形.按过("r")：
            重开()
    画()

# ---------------------------------------------------------------------------
# 四、画
# ---------------------------------------------------------------------------

函数 画()：
    图形.清屏("#0b1020")

# 网格线（20 竖 + 20 横，比一格一格铺底色省一半调用）
    令 i = 1
    当 i < 列数：
        图形.线(i * 格, 0, i * 格, 画布高, {"描边": "#141d33", "线宽": 1})
        图形.线(0, i * 格, 画布宽, i * 格, {"描边": "#141d33", "线宽": 1})
        i = i + 1

    令 食 = 游戏["食物"]
    图形.圆(食["x"] * 格 + 格 / 2, 食["y"] * 格 + 格 / 2, 格 / 2 - 3,
              {"填充": "#f87171"})

    令 蛇 = 游戏["蛇"]
    令 序 = 0
    当 序 < 长度(蛇)：
        令 节 = 蛇[序]
        令 色 = "#16a34a"
        如果 序 == 长度(蛇) - 1：
            色 = "#4ade80"  # 蛇头亮一点
        图形.矩形(节["x"] * 格 + 1, 节["y"] * 格 + 1, 格 - 2, 格 - 2,
                  {"填充": 色, "圆角": 5})
        序 = 序 + 1

    图形.文本("分数 " + 文本(游戏["分数"]), 12, 26,
              {"字号": 18, "填充": "#e2e8f0"})
    图形.文本("长度 " + 文本(长度(蛇)), 12, 50,
              {"字号": 14, "填充": "#94a3b8"})
    图形.文本("最高 " + 文本(游戏["最高分"]), 画布宽 - 12, 26,
              {"字号": 14, "填充": "#94a3b8", "对齐": "右"})

    如果 游戏["状态"] == "结束"：
        图形.文本("撞上了 —— 得了 " + 文本(游戏["分数"]) + " 分",
                  画布宽 / 2, 画布高 / 2 - 20,
                  {"字号": 30, "填充": "#f87171", "对齐": "中"})
        图形.文本("按空格再来一局", 画布宽 / 2, 画布高 / 2 + 24,
                  {"字号": 18, "填充": "#cbd5e1", "对齐": "中"})

# 进常驻 VM：之后每帧只在这个 VM 上跑 `每帧`（D110）
图形.运行(初始化, 每帧)
