# 迷你地牢（游戏本体）—— M197 的验收物
#
# 跑：jishi examples/desktop/迷你地牢.jsh      （桌面窗口）
# 或者打开 examples/desktop/迷你地牢.html      （页面里跑同一份本体）
#
# 这一份演示 M197 补的六件事，每件都在下面标了「M197」：
#   · 瓦片碰撞层（`是实心`）—— 玩家撞不穿墙
#   · 瓦片斜坡（`斜坡` / `是斜坡`）—— 标出来的那几格能走、不挡人
#   · 精灵图集切分（`图集切分`）+ 动画完成（`动画完成`）
#   · 地图从 Tiled 读（有 .tmx 就用，没有就用程序生成的那张）
#   · 场景转场（`转场` / `转场中`）
#   · 多存档槽（`槽们`）+ 自动存（`自动存`）
#
# 操作：← → ↑ ↓ 或 WASD 移动；空格开始 / 重来；ESC 退出转场。

导入 图形
导入 瓦片
导入 精灵
导入 场景
导入 存档
导入 地图
导入 数学

# ---- 常量 ----------------------------------------------------------------

令 格 = 32
令 列数 = 17
令 行数 = 11
令 屏宽 = 列数 * 格
令 屏高 = 行数 * 格

#: 整局状态都放这一个字典里（基石没有 `global`，函数里改全局要走容器）
令 局 = {}

# ---- 地图 ----------------------------------------------------------------

函数 建地牢()：
    """程序生成一张地牢：外框是墙，中间撒一些柱子，左下角开一条斜坡。

    🔴 **必须每行长度一致**（`瓦片.载入` 按最长行算列数，短行会被当成空）
    —— 少一格不会报错，画出来才发现缺一块。
    """
    令 行们 = []
    令 r = 0
    当 r < 行数：
        令 行 = []
        令 c = 0
        当 c < 列数：
            令 边 = r == 0 或 r == 行数 - 1 或 c == 0 或 c == 列数 - 1
            # 中间撒柱子：用行列做「伪随机」，保证每次开图都一样
            令 柱 = (r % 3 == 0) 与 (c % 4 == 0) 与 r > 1 与 c > 1 与 r < 行数 - 2 与 c < 列数 - 2
            如果 边 或 柱：
                行.追加(0)
            否则：
                行.追加(1)
            c = c + 1
        行们.追加(行)
        r = r + 1
    令 地 = 瓦片.载入({"图集": 局["图集"], "瓦片宽": 格, "瓦片高": 格, "行们": 行们})
    # M197：斜坡 —— 标了方向的格子算「能走上去」，不吃碰撞
    瓦片.斜坡(地, 2, 2, "右")
    瓦片.斜坡(地, 3, 2, "右")
    瓦片.斜坡(地, 4, 2, "右")
    返回 地


函数 载地图()：
    """M197：有 Tiled 画的图就用它，没有就程序生成。

    📌 这是「同一个游戏两种关卡来源」的写法 —— `从Tiled` 只换数据，不换代码。
    """
    尝试：
        令 地 = 地图.从Tiled("地牢.tmx")
        返回 地
    捕获 文件错误 为 e：
        # 没有 .tmx 是常态（发行包里不一定带），**不是错** —— 退回程序生成
        返回 建地牢()


# ---- 碰撞 ----------------------------------------------------------------

函数 能站(x, y)：
    """这个位置站得下吗？（玩家是个 22×22 的盒子，查四个角）

    M197：`是实心` 把「碰到的瓦片号」换成了「这一格挡不挡人」——
    判断从「号在不在名单里」变成一句话，斜坡也不算墙了。
    """
    令 半 = 11
    令 角们 = [[x - 半, y - 半], [x + 半, y - 半], [x - 半, y + 半], [x + 半, y + 半]]
    遍历 角 在 角们：
        如果 瓦片.是实心(局["墙"], 整数(角[0] // 格), 整数(角[1] // 格))：
            返回 假
    返回 真


# ---- 场景 ----------------------------------------------------------------

函数 标题初始化()：
    局["得分"] = 0
    局["血"] = 5
    局["怪们"] = 建怪们()
    局["玩家"] = {"x": 48.0, "y": 48.0, "无敌": 0}
    局["最高"] = 存档.读("最高分", 0)


函数 进游戏()：
    局["得分"] = 0
    局["血"] = 5
    局["玩家"] = {"x": 48.0, "y": 48.0, "无敌": 60}
    局["怪们"] = 建怪们()
    场景.转场("淡入", 24)


函数 结束初始化()：
    如果 局["得分"] > 局["最高"]：
        局["最高"] = 局["得分"]
        存档.存("最高分", 局["最高"])
    场景.转场("淡入", 20)


# ---- 怪物 ----------------------------------------------------------------

函数 建怪们()：
    令 出 = []
    令 位们 = [[400.0, 80.0], [400.0, 240.0], [240.0, 240.0]]
    遍历 位 在 位们：
        出.追加({"x": 位[0], "y": 位[1], "速": 62.0, "向": 1})
    返回 出


函数 怪能不能站(怪, x, y)：
    令 半 = 10
    令 角们 = [[x - 半, y - 半], [x + 半, y - 半], [x - 半, y + 半], [x + 半, y + 半]]
    遍历 角 在 角们：
        如果 瓦片.是实心(局["墙"], 整数(角[0] // 格), 整数(角[1] // 格))：
            返回 假
    返回 真


函数 走怪们(秒)：
    令 玩家 = 局["玩家"]
    遍历 怪 在 局["怪们"]：
        令 dx = 玩家["x"] - 怪["x"]
        令 dy = 玩家["y"] - 怪["y"]
        令 远 = 数学.开方(dx * dx + dy * dy)
        如果 远 < 150.0：
            # 近：朝玩家走（简单追踪，不做寻路 —— A* 留给 M197 之后的站）
            如果 远 > 1.0：
                令 步x = dx / 远 * 怪["速"] * 秒
                令 步y = dy / 远 * 怪["速"] * 秒
                如果 怪能不能站(怪, 怪["x"] + 步x, 怪["y"] + 步y)：
                    怪["x"] = 怪["x"] + 步x
                    怪["y"] = 怪["y"] + 步y
        否则：
            # 远：左右巡逻，撞墙就掉头
            令 步x = 怪["向"] * 怪["速"] * 秒
            如果 怪能不能站(怪, 怪["x"] + 步x, 怪["y"]):
                怪["x"] = 怪["x"] + 步x
            否则：
                怪["向"] = -怪["向"]


# ---- 画 ------------------------------------------------------------------

函数 画地()：
    瓦片.画(局["地"])


函数 画玩家()：
    令 玩家 = 局["玩家"]
    令 精 = 局["精"]
    精灵.更新(精, 局["间隔"])
    如果 玩家["无敌"] > 0：
        # 受伤后的闪烁：每 4 帧藏一次（**看得见**比「一直画」好判断）
        如果 (整数(玩家["无敌"]) // 4) % 2 == 0：
            返回
    精灵.画(精, 玩家["x"], 玩家["y"])


函数 画怪们()：
    遍历 怪 在 局["怪们"]：
        图形.圆(怪["x"], 怪["y"], 10, {"填充": "#e0566e", "描边": "#2a0b12", "线宽": 2})
        图形.圆(怪["x"] - 3, 怪["y"] - 2, 2, {"填充": "#fff"})
        图形.圆(怪["x"] + 3, 怪["y"] - 2, 2, {"填充": "#fff"})


函数 画状态()：
    图形.文本("得分 " + 文本(局["得分"]), 10, 22, {"字号": 14, "填充": "#e8eeff"})
    令 血 = 局["血"]
    令 i = 0
    当 i < 血：
        图形.圆(屏宽 - 18 - i * 20, 16, 6, {"填充": "#7ee0a0"})
        i = i + 1


# ---- 每帧 ----------------------------------------------------------------

函数 走玩家(秒)：
    令 玩家 = 局["玩家"]
    令 速 = 150.0
    令 dx = 0.0
    令 dy = 0.0
    如果 图形.按着("左") 或 图形.按着("a")：
        dx = dx - 速 * 秒
    如果 图形.按着("右") 或 图形.按着("d")：
        dx = dx + 速 * 秒
    如果 图形.按着("上") 或 图形.按着("w")：
        dy = dy - 速 * 秒
    如果 图形.按着("下") 或 图形.按着("s")：
        dy = dy + 速 * 秒
    # **分轴判**：撞了横着的那面墙，竖着还能走（贴墙滑行）
    如果 dx != 0.0 与 能站(玩家["x"] + dx, 玩家["y"]):
        玩家["x"] = 玩家["x"] + dx
    如果 dy != 0.0 与 能站(玩家["x"], 玩家["y"] + dy):
        玩家["y"] = 玩家["y"] + dy
    如果 玩家["无敌"] > 0：
        玩家["无敌"] = 玩家["无敌"] - 1


函数 判碰撞():
    令 玩家 = 局["玩家"]
    如果 玩家["无敌"] > 0：
        返回
    遍历 怪 在 局["怪们"]：
        令 dx = 玩家["x"] - 怪["x"]
        令 dy = 玩家["y"] - 怪["y"]
        如果 dx * dx + dy * dy < 22.0 * 22.0：
            局["血"] = 局["血"] - 1
            玩家["无敌"] = 70
            如果 局["血"] <= 0：
                场景.切("结束")
            返回


函数 每帧(号, 间隔)：
    局["帧"] = 号
    局["间隔"] = 间隔
    # 🔴 M197：转场期间**只画遮罩**，不动逻辑（否则玩家在转场里还能被打）
    如果 场景.转场中()：
        返回

    令 当前场景 = 场景.现在()

    如果 当前场景 == "标题"：
        图形.清屏("#0b0d14")
        图形.文本("迷 你 地 牢", 屏宽 / 2, 120, {"字号": 34, "对齐": "中", "填充": "#e8eeff"})
        图形.文本("方向键 / WASD 移动", 屏宽 / 2, 180, {"字号": 15, "对齐": "中", "填充": "#8f9dc8"})
        图形.文本("最高分 " + 文本(局["最高"]), 屏宽 / 2, 210, {"字号": 15, "对齐": "中", "填充": "#ffe9a8"})
        如果 图形.按过("空格")：
            场景.切("游戏")
        返回

    如果 当前场景 == "结束"：
        图形.清屏("#1a0b12")
        图形.文本("被 抓 住 了", 屏宽 / 2, 130, {"字号": 30, "对齐": "中", "填充": "#e0566e"})
        图形.文本("这一局 " + 文本(局["得分"]), 屏宽 / 2, 180, {"字号": 16, "对齐": "中", "填充": "#e8eeff"})
        图形.文本("最高 " + 文本(局["最高"]), 屏宽 / 2, 208, {"字号": 16, "对齐": "中", "填充": "#ffe9a8"})
        图形.文本("按空格重来", 屏宽 / 2, 250, {"字号": 14, "对齐": "中", "填充": "#8f9dc8"})
        如果 图形.按过("空格")：
            场景.切("标题")
        返回

    # ---- 游戏中 ----
    令 秒 = 间隔 / 1000.0
    如果 秒 > 0.1：
        秒 = 0.1  # 卡帧时别让一次走太远（会穿墙）—— 与帧循环的 dt clamp 同一个道理
    走玩家(秒)
    走怪们(秒)
    判碰撞()
    局["得分"] = 局["得分"] + 1

    图形.清屏("#0b0d14")
    画地()
    画怪们()
    画玩家()
    画状态()

    # M197：每帧喂一次自动存 —— 它只更新快照，真正落盘按间隔来
    存档.自动存({"得分": 局["得分"], "血": 局["血"]}, 5000)


# ---- 启动 ----------------------------------------------------------------

函数 初始化()：
    图形.准备({"宽": 屏宽, "高": 屏高, "背景": "#0b0d14"})
    局["图集"] = 图形.读图("瓦片图.png")
    局["玩家图"] = 图形.读图("小人.png")
    局["地"] = 载地图()
    局["墙"] = 瓦片.碰撞层(局["地"], [0])
    局["精"] = 精灵.新建 (局["玩家图"], {"宽": 32, "高": 32, "列数": 4, "行数": 1})
    # M197：锚点放中心 —— 玩家坐标指的是「身体中心」，撞墙时四角对称
    精灵.设原点(局["精"], 0.5, 0.5)

    # M197：图集切分 —— 4×1 的图切出 4 帧；这里只用前 3 帧当「走」的动画
    令 切 = 精灵.图集切分(128, 32, 32, 32)
    局["帧数"] = 切["帧数"]
    精灵.播(局["精"], "走", {"帧们": [1, 2, 3], "速度": 10, "循环": 真})

    场景.定("标题", {"初始化": 标题初始化})
    场景.定("游戏", {"初始化": 进游戏})
    场景.定("结束", {"初始化": 结束初始化})
    场景.切("标题")

    打印("迷你地牢：方向键 / WASD 移动，空格开始")
    打印("存档槽：", 存档.槽们())


图形.运行(初始化, 每帧)
