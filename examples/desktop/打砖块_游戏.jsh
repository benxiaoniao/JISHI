# 打砖块 —— 用基石写的第一个能玩的游戏（M188）
#
# 跑：在仓库根执行  jishi examples/desktop/打砖块.jsh
#     出来的是一个**真窗口**，进去就能玩（挡板跟着鼠标，或者按 ← →）。
#
# 这一份是**唯一的游戏源码**：
#   · 窗口里跑 —— `打砖块.html` 用 fetch 把本文件读进来再交给 wasm 引擎；
#   · 官网试玩 —— `build_play.py` 把本文件内联进 `play.html`（零安装）。
#   ⚠️ 别把源码再抄一份进 HTML：抄了就会漂，而漂了以后「网页上好好的、装到
#      机器上不对」是最难查的那类问题。
#
# 用到四样东西：
#   图形 —— 画 + 键盘鼠标 + 帧循环（`图形.运行` 之后 VM 是**常驻**的，见 D110）
#   声音 —— 碰砖 / 碰挡板时响一下（浏览器没解锁之前 `播放` 返回假，不报错）
#   存档 —— 最高分（存在页面的 localStorage 里）
#   数学 —— 开方 / 绝对值（算反弹方向用）
#
# 📌 **游戏状态全放一个字典里**：基石没有 `global`，函数里写 `分数 = 分数 + 1`
#    是**局部变量**，改不到外面。放字典（`游戏["分数"]`）才改得动 —— M186 踩过。

导入 图形
导入 声音
导入 存档
导入 数学

令 画布宽 = 640
令 画布高 = 480

# 砖块：8 列 5 行，左上角留一条给分数栏
令 砖列 = 8
令 砖行 = 5
令 砖宽 = 68
令 砖高 = 22
令 砖距 = 6
令 砖左 = 46
令 砖顶 = 70

# 五行的颜色（从上到下：红 → 橙 → 绿 → 蓝 → 紫）
令 砖色们 = ["#ef4444", "#f59e0b", "#22c55e", "#38bdf8", "#a78bfa"]

令 游戏 = {
    "分数":0,
    "命":3,
    "状态":"玩",  # 玩 / 过关 / 结束
    "球":{"x": 320.0, "y": 400.0, "半径": 8.0, "速度x": 190.0, "速度y": -260.0},
    "挡板":{"x": 260.0, "y": 448.0, "宽": 120.0, "高": 12.0},
    "砖们":[],
    "最高分":0,
    "音":0,
}

# ---------------------------------------------------------------------------
# 一、开局与重开
# ---------------------------------------------------------------------------

函数 造砖()：
    令 们 = []
    令 行 = 0
    当 行 < 砖行：
        令 列 = 0
        当 列 < 砖列：
            令 块 = {
                "x":砖左 + 列 * (砖宽 + 砖距),
                "y":砖顶 + 行 * (砖高 + 砖距),
                "宽":砖宽,
                "高":砖高,
                "活":真,
                "色":砖色们[行],
            }
            们.追加(块)
            列 = 列 + 1
        行 = 行 + 1
    返回 们

函数 摆球()：
    游戏["球"]["x"] = 游戏["挡板"]["x"] + 游戏["挡板"]["宽"] / 2
    游戏["球"]["y"] = 游戏["挡板"]["y"] - 12
    游戏["球"]["速度x"] = 190.0
    游戏["球"]["速度y"] = -260.0

函数 重开()：
    游戏["分数"] = 0
    游戏["命"] = 3
    游戏["状态"] = "玩"
    游戏["挡板"]["x"] = 画布宽 / 2 - 游戏["挡板"]["宽"] / 2
    游戏["砖们"] = 造砖()
    摆球()

函数 初始化()：
    图形.准备({"宽": 画布宽, "高": 画布高, "背景": "#0b1020"})
    游戏["音"] = 声音.载入("碰.wav")
    游戏["最高分"] = 存档.读("打砖块最高分", 0)
    重开()
    打印("打砖块：鼠标移动挡板，空格重开")

# ---------------------------------------------------------------------------
# 二、每帧：输入 → 物理 → 判定 → 画
# ---------------------------------------------------------------------------

函数 响一下(音量)：
# 浏览器在用户动手之前是**不能放声音**的：`播放` 返回假，不报错（见 D111）。
# 这里不管返回值 —— 没解锁就静音，玩家玩两下它自己就解锁了。
    声音.播放(游戏["音"], {"音量": 音量})

函数 挡板跟手(间隔)：
    令 板 = 游戏["挡板"]
    令 速 = 520.0 * 间隔
    如果 图形.按着("左")：
        板["x"] = 板["x"] - 速
    如果 图形.按着("右")：
        板["x"] = 板["x"] + 速
# 鼠标也能控（网页里最顺手）：挡板中心对着鼠标走，但别瞬移
    令 鼠 = 图形.鼠标()
    如果 鼠["x"] > 0：
        令 目标 = 鼠["x"] - 板["宽"] / 2
        令 差 = 目标 - 板["x"]
        如果 数学.绝对值(差) > 2：
            板["x"] = 板["x"] + 差 * 0.35
    板["x"] = 数学.限制(板["x"], 0, 画布宽 - 板["宽"])

函数 撞到砖(球, 块)：
    返回 图形.碰到({"x": 球["x"], "y": 球["y"], "半径": 球["半径"]},
                    {"x": 块["x"], "y": 块["y"], "宽": 块["宽"], "高": 块["高"]})

函数 一步(秒)：
    令 球 = 游戏["球"]
    令 板 = 游戏["挡板"]

    球["x"] = 球["x"] + 球["速度x"] * 秒
    球["y"] = 球["y"] + 球["速度y"] * 秒

# 左右墙
    如果 球["x"] - 球["半径"] <= 0：
        球["x"] = 球["半径"]
        球["速度x"] = 数学.绝对值(球["速度x"])
        响一下(0.25)
    如果 球["x"] + 球["半径"] >= 画布宽：
        球["x"] = 画布宽 - 球["半径"]
        球["速度x"] = -数学.绝对值(球["速度x"])
        响一下(0.25)

# 天花板
    如果 球["y"] - 球["半径"] <= 0：
        球["y"] = 球["半径"]
        球["速度y"] = 数学.绝对值(球["速度y"])
        响一下(0.25)

# 挡板：按打中的位置决定反弹角度（打边上角度大，打中间更直）
    如果 球["速度y"] > 0 与 球["y"] + 球["半径"] >= 板["y"] 与 球["y"] - 球["半径"] <= 板["y"] + 板["高"]：
        如果 球["x"] >= 板["x"] - 球["半径"] 与 球["x"] <= 板["x"] + 板["宽"] + 球["半径"]：
            令 位 = (球["x"] - (板["x"] + 板["宽"] / 2)) / (板["宽"] / 2)
            位 = 数学.限制(位, -1, 1)
            令 速度 = 数学.开方(球["速度x"] * 球["速度x"] + 球["速度y"] * 球["速度y"])
            速度 = 数学.限制(速度 * 1.02, 260, 720)
            令 角 = 位 * 1.0  # 最多偏 57 度
            球["速度x"] = 速度 * 数学.正弦(角)
            球["速度y"] = -数学.绝对值(速度 * 数学.余弦(角))
            球["y"] = 板["y"] - 球["半径"]
            响一下(0.5)

# 砖：一次只撞一块（撞完就反弹，剩下的下一帧再说）
    遍历 块 在 游戏["砖们"]：
        如果 非 块["活"]：
            继续
        如果 撞到砖(球, 块)：
            块["活"] = 假
            游戏["分数"] = 游戏["分数"] + 10
            球["速度y"] = -球["速度y"]
            球["y"] = 球["y"] + 球["速度y"] * 秒 * 2
            响一下(0.4)
            中断

# 掉下去一条命
    如果 球["y"] - 球["半径"] > 画布高：
        游戏["命"] = 游戏["命"] - 1
        如果 游戏["命"] <= 0：
            游戏["状态"] = "结束"
            如果 游戏["分数"] > 游戏["最高分"]：
                游戏["最高分"] = 游戏["分数"]
                存档.存("打砖块最高分", 游戏["最高分"])
        否则：
            摆球()

函数 还剩几块()：
    令 数 = 0
    遍历 块 在 游戏["砖们"]：
        如果 块["活"]：
            数 = 数 + 1
    返回 数

函数 每帧(号, 间隔)：
    令 秒 = 间隔 / 1000
# 引擎已经把 `间隔` 掐到 100 ms（D110）；这里再按 1/120 秒切成小步 ——
# 球一帧能走 40 像素时，不切步会**直接穿过砖**（碰撞是离散采样）。
    令 步数 = 数学.向上取整(秒 / 0.008)
    如果 步数 < 1：
        步数 = 1
    令 每步 = 秒 / 步数

    如果 游戏["状态"] == "玩"：
        挡板跟手(秒)
        令 i = 0
        当 i < 步数 与 游戏["状态"] == "玩"：
            一步(每步)
            i = i + 1
        如果 游戏["状态"] == "玩" 与 还剩几块() == 0：
            游戏["状态"] = "过关"
            如果 游戏["分数"] > 游戏["最高分"]：
                游戏["最高分"] = 游戏["分数"]
                存档.存("打砖块最高分", 游戏["最高分"])
    否则：
        # 结束 / 过关之后按空格重开
        如果 图形.按过("空格") 或 图形.按过("r")：
            重开()

    画()

# ---------------------------------------------------------------------------
# 三、画
# ---------------------------------------------------------------------------

函数 画()：
    图形.清屏("#0b1020")

    遍历 块 在 游戏["砖们"]：
        如果 非 块["活"]：
            继续
        图形.矩形(块["x"], 块["y"], 块["宽"], 块["高"],
                  {"填充": 块["色"], "圆角": 4})

    令 板 = 游戏["挡板"]
    图形.矩形(板["x"], 板["y"], 板["宽"], 板["高"],
              {"填充": "#e2e8f0", "圆角": 6})

    令 球 = 游戏["球"]
    图形.圆(球["x"], 球["y"], 球["半径"], {"填充": "#fde047"})

    图形.文本("分数 " + 文本(游戏["分数"]), 16, 28,
              {"字号": 20, "填充": "#e2e8f0"})
    图形.文本("命 " + 文本(游戏["命"]), 16, 52,
              {"字号": 16, "填充": "#94a3b8"})
    图形.文本("最高 " + 文本(游戏["最高分"]), 画布宽 - 16, 28,
              {"字号": 16, "填充": "#94a3b8", "对齐": "右"})

    如果 游戏["状态"] == "过关"：
        图形.文本("过关！按空格再来一局", 画布宽 / 2, 画布高 / 2,
                  {"字号": 34, "填充": "#4ade80", "对齐": "中"})
    如果 游戏["状态"] == "结束"：
        图形.文本("结束 —— 得了 " + 文本(游戏["分数"]) + " 分", 画布宽 / 2, 画布高 / 2 - 20,
                  {"字号": 34, "填充": "#f87171", "对齐": "中"})
        图形.文本("按空格再来一局", 画布宽 / 2, 画布高 / 2 + 24,
                  {"字号": 20, "填充": "#cbd5e1", "对齐": "中"})

# 进常驻 VM：之后每帧只在这个 VM 上跑 `每帧`，全局状态一直在（D110）
图形.运行(初始化, 每帧)
