# 平台跳跃 —— M188 的第三个示例（瓦片地图 + 相机 + 重力 + 精灵动画）
#
# 跑：在仓库根执行  jishi examples/desktop/平台跳跃.jsh
#     进去就能玩：← → 走，空格 / ↑ 跳，跑到右边的旗子那儿算过关。
#
# 这个示例是三个里**最像真游戏**的：滚动地图、踩上去、撞墙停、跟着主角走 ——
# 也是唯一一个把 M187 的三个模块一起用上的：
#
#   地图  —— 关卡结构（`地图.读` 收字典，页面里没有文件系统，所以关卡内联）
#   瓦片  —— 把地形画出来，并按视口裁剪（`瓦片.画` 收相机）
#   精灵  —— 主角的四帧动画（站 / 跑 / 跑 / 跳）
#
# 📌 **素材**：`瓦片图.png`（4 格 × 32:土 / 草 / 砖 / 石）与 `小人.png`
#    （4 帧 × 32）。都是 32×32 的纯色块 + 描边，用任何画图工具都能改；
#    换成自己的图只要保持格子尺寸一致。
#
# ⚠️ 关卡内联在 `造关卡()` 里，不是读 json 文件 —— 页面上 `地图.读` 只能收字典
#    （wasm 没有文件系统）。命令行里当然也能 `地图.读("关卡.json")`，
#    但一份源码要在两个宿主跑，只能取交集。

导入 图形
导入 精灵
导入 瓦片
导入 地图
导入 存档
导入 数学
导入 文本 为 文字

# 一格 32 像素；世界 60 列 × 18 行（视口 800×480，相机横向跟随）
令 格 = 32
令 列数 = 60
令 行数 = 15
令 画布宽 = 800
令 画布高 = 480
令 世界宽 = 格 * 列数
令 世界高 = 格 * 行数

# 物理常量（像素 / 秒）
令 重力 = 1800.0
令 走速 = 230.0
令 跳速 = -580.0

#: 起点（列 4，站在地面上）与终点（列 56）
令 起点列 = 4
令 终点列 = 56

令 游戏 = {
    "图":0,
    "玩家图":0,
    "玩家":{"x": 0.0, "y": 0.0, "速度x": 0.0, "速度y": 0.0, "落地": 假, "朝左": 假},
    "相机":0.0,
    "状态":"玩",
    "用时":0.0,
    "最快":0.0,
    "瓦片们":0,
}

# ---------------------------------------------------------------------------
# 一、关卡
# ---------------------------------------------------------------------------

函数 空格行()：
    令 行 = []
    令 c = 0
    当 c < 列数：
        行.追加(-1)
        c = c + 1
    返回 行

函数 铺(行们, 行号, 起, 止, 号)：
    令 c = 起
    当 c <= 止：
        行们[行号][c] = 号
        c = c + 1

函数 造关卡()：
    令 行们 = []
    令 r = 0
    当 r < 行数：
        行们.追加(空格行())
        r = r + 1

# 地面：第 13 行草、第 14 行土，**列 0–1 留个坑**（掉下去回起点）
# 📌 世界正好和视口一样高（15 × 32 = 480），所以相机只管横向 —— 纵向固定 0。
    铺(行们, 13, 2, 列数 - 1, 1)
    铺(行们, 14, 2, 列数 - 1, 0)

# 两处台阶：一格 / 两格高，得跳一下才上得去
    铺(行们, 12, 20, 21, 1)
    铺(行们, 11, 40, 41, 1)
    铺(行们, 12, 40, 41, 0)

# 两处空中砖台（好看，也能踩）
    铺(行们, 9, 28, 31, 2)
    铺(行们, 7, 48, 50, 2)

    返回 {"瓦片宽": 格, "瓦片高": 格, "图集": "瓦片图.png",
          "层们":[{"名": "地形", "行们": 行们}]}

# ---------------------------------------------------------------------------
# 二、开局
# ---------------------------------------------------------------------------

函数 重开()：
    游戏["玩家"]["x"] = 起点列 * 格
    游戏["玩家"]["y"] = 13 * 格 - 32
    游戏["玩家"]["速度x"] = 0.0
    游戏["玩家"]["速度y"] = 0.0
    游戏["玩家"]["落地"] = 假
    游戏["玩家"]["朝左"] = 假
    游戏["相机"] = 0.0
    游戏["状态"] = "玩"
    游戏["用时"] = 0.0

函数 初始化()：
    图形.准备({"宽": 画布宽, "高": 画布高, "背景": "#7ec8e3"})
    游戏["玩家图"] = 图形.读图("小人.png")
    游戏["图"] = 瓦片.载入({
        "图集":图形.读图("瓦片图.png"),
        "瓦片宽":格,
        "瓦片高":格,
        "行们":地图.层(地图.读(造关卡()), "地形")["行们"],
    })
    游戏["精灵"] = 精灵.新建 (游戏["玩家图"], {"宽": 32, "高": 32, "列数": 4, "行数": 1})
    游戏["最快"] = 存档.读("平台跳跃最快", 0.0)
    重开()
    打印("平台跳跃：← → 走，空格 / ↑ 跳，跑到右边的旗子那儿")

# ---------------------------------------------------------------------------
# 三、物理：一格一格地判定
# ---------------------------------------------------------------------------

#: 这个格子是不是实心的（左右越界当墙；上方是空的；掉出底部不算实心 —— 那是「掉下去了」）
函数 实心(列, 行)：
    如果 列 < 0 或 列 >= 列数：
        返回 真
    如果 行 < 0 或 行 >= 行数：
        返回 假
    返回 瓦片.取(游戏["图"], 列, 行) >= 0

#: 玩家盒子（比 32 小一圈，不然贴墙时会「离墙半格就停」）
函数 盒()：
    令 p = 游戏["玩家"]
    返回 {"左": p["x"] + 6.0, "右": p["x"] + 26.0,
          "上":p["y"] + 2.0, "下":p["y"] + 30.0}

函数 移x(秒)：
    令 p = 游戏["玩家"]
    p["x"] = p["x"] + p["速度x"] * 秒
    令 b = 盒()
    如果 p["速度x"] > 0：
        令 列 = 整数(b["右"] / 格)
        如果 实心(列, 整数(b["上"] / 格)) 或 实心(列, 整数((b["下"] - 1) / 格)):
            p["x"] = 列 * 格 - 26.0
            p["速度x"] = 0.0
    否则如果 p["速度x"] < 0：
        令 列 = 整数(b["左"] / 格)
        如果 实心(列, 整数(b["上"] / 格)) 或 实心(列, 整数((b["下"] - 1) / 格)):
            p["x"] = (列 + 1) * 格 - 6.0
            p["速度x"] = 0.0

函数 移y(秒)：
    令 p = 游戏["玩家"]
    p["速度y"] = p["速度y"] + 重力 * 秒
    p["y"] = p["y"] + p["速度y"] * 秒
    令 b = 盒()
    如果 p["速度y"] > 0：
        令 行 = 整数(b["下"] / 格)
        如果 实心(整数(b["左"] / 格), 行) 或 实心(整数((b["右"] - 1) / 格), 行):
            p["y"] = 行 * 格 - 30.0
            p["速度y"] = 0.0
            p["落地"] = 真
    否则如果 p["速度y"] < 0：
        令 行 = 整数(b["上"] / 格)
        如果 实心(整数(b["左"] / 格), 行) 或 实心(整数((b["右"] - 1) / 格), 行):
            p["y"] = (行 + 1) * 格 - 2.0
            p["速度y"] = 0.0

# ---------------------------------------------------------------------------
# 四、每帧
# ---------------------------------------------------------------------------

函数 操作()：
    令 p = 游戏["玩家"]
    p["速度x"] = 0.0
    如果 图形.按着("左") 或 图形.按着("a"):
        p["速度x"] = -走速
        p["朝左"] = 真
    如果 图形.按着("右") 或 图形.按着("d"):
        p["速度x"] = 走速
        p["朝左"] = 假
# 跳：**边沿**触发，而且必须踩着地（空中按了不记着）
    如果 (图形.按过("空格") 或 图形.按过("上") 或 图形.按过("w")) 与 p["落地"]:
        p["速度y"] = 跳速
        p["落地"] = 假

函数 跟拍()：
    令 目 = 游戏["玩家"]["x"] + 16.0 - 画布宽 / 2
    游戏["相机"] = 数学.限制(目, 0.0, 世界宽 - 画布宽)

函数 每帧(号, 间隔毫秒)：
    令 秒 = 间隔毫秒 / 1000.0

    如果 游戏["状态"] == "玩":
        游戏["用时"] = 游戏["用时"] + 秒
        操作()
        # 切成小步：一帧走 40 像素时，不切分就会**穿过一格台阶**（离散采样）
        令 步数 = 整数(秒 / 0.008) + 1
        令 每步 = 秒 / 步数
        令 i = 0
        当 i < 步数:
            游戏["玩家"]["落地"] = 假
            移x(每步)
            移y(每步)
            i = i + 1
        # 掉出世界：回起点（不判负 —— 这一版先让人能玩下去）
        如果 游戏["玩家"]["y"] > 世界高:
            重开()
        # 到终点
        如果 游戏["玩家"]["x"] >= 终点列 * 格:
            游戏["状态"] = "过关"
            如果 游戏["最快"] == 0.0 或 游戏["用时"] < 游戏["最快"]:
                游戏["最快"] = 游戏["用时"]
                存档.存("平台跳跃最快", 游戏["最快"])
    否则:
        如果 图形.按过("空格") 或 图形.按过("r"):
            重开()

    动画(秒)
    跟拍()
    画()

函数 动画(秒)：
    令 精 = 游戏["精灵"]
    令 p = 游戏["玩家"]
    如果 非 p["落地"]:
        精灵.设帧(精, 3)  # 跳：脚收起那一帧
    否则如果 数学.绝对值(p["速度x"]) > 1.0:
        精灵.播(精, "跑", {"帧们": [1, 2], "速度": 8})
    否则:
        精灵.停(精)
        精灵.设帧(精, 0)
    精灵.更新(精, 秒 * 1000.0)

# ---------------------------------------------------------------------------
# 五、画
# ---------------------------------------------------------------------------

函数 画()：
    图形.清屏("#7ec8e3")

# 世界坐标：先设相机，再按相机裁剪着画瓦片
    图形.设相机(游戏["相机"], 0.0)
    游戏["瓦片们"] = 瓦片.画(游戏["图"], {"x": 游戏["相机"], "y": 0.0,
                                         "宽":画布宽, "高":画布高})

    令 p = 游戏["玩家"]
    令 选项 = 空
    如果 p["朝左"]:
        选项 = {"翻转": "横"}
    精灵.画(游戏["精灵"], p["x"], p["y"], 选项)

# 终点旗（世界坐标，画一根杆 + 一面旗）
    图形.矩形(终点列 * 格 + 12, 13 * 格 - 96, 4, 96, {"填充": "#e2e8f0"})
    图形.矩形(终点列 * 格 + 16, 13 * 格 - 96, 34, 22, {"填充": "#f43f5e"})

# HUD 回到屏幕坐标（不然会跟着相机跑）
    图形.设相机(0.0, 0.0)
    图形.文本("用时 " + 文字.小数位(游戏["用时"], 1) + " 秒", 14, 28,
              {"字号": 18, "填充": "#0f172a"})
    如果 游戏["最快"] > 0.0:
        图形.文本("最快 " + 文字.小数位(游戏["最快"], 1) + " 秒", 14, 52,
                  {"字号": 14, "填充": "#334155"})
    图形.文本("← → 走 · 空格 跳 · 跑到右边的旗子", 画布宽 - 14, 28,
              {"字号": 14, "填充": "#0f172a", "对齐": "右"})

    如果 游戏["状态"] == "过关":
        图形.矩形(0, 画布高 / 2 - 60, 画布宽, 120, {"填充": "rgba(15,23,42,0.85)"})
        图形.文本("过关！用了 " + 文字.小数位(游戏["用时"], 1) + " 秒",
                  画布宽 / 2, 画布高 / 2 - 10,
                  {"字号": 32, "填充": "#4ade80", "对齐": "中"})
        图形.文本("按空格再来一次", 画布宽 / 2, 画布高 / 2 + 30,
                  {"字号": 18, "填充": "#cbd5e1", "对齐": "中"})

# 进常驻 VM：之后每帧只在这个 VM 上跑 `每帧`（D110）
图形.运行(初始化, 每帧)
