# 图片格式转换包自己的测试 —— 用基石自己的 `测试` 模块写（不是 pytest）
#
# 跑：jishi 测试 examples/packages/图片格式转换
#
# 📌 0.2.9 起 `从 本地包` 在产品版（jishi-rs）上也能跑（编译期展开），
#    所以这条测试用它自己那个宿主跑就行。

导入 测试
导入 图片格式转换 从 本地包
导入 编码
导入 文件
导入 路径

令 目录 = 路径.临时目录()


函数 _路径(名):
    返回 路径.连接(目录, 名)


函数 空图有尺寸和底色():
    令 图 = 图片格式转换.空图(3, 2, [10, 20, 30])
    测试.相等(图片格式转换.尺寸(图), {"宽": 3, "高": 2}, "尺寸该是 3×2")
    测试.相等(图片格式转换.取像素(图, 2, 1), [10, 20, 30], "每个像素都该是底色")


函数 设像素只改那一个():
    令 图 = 图片格式转换.空图(4, 4, [0, 0, 0])
    图片格式转换.设像素(图, 1, 2, [200, 100, 50])
    测试.相等(图片格式转换.取像素(图, 1, 2), [200, 100, 50])
    测试.相等(图片格式转换.取像素(图, 0, 0), [0, 0, 0], "别的像素不该被碰")


函数 填充整张():
    令 图 = 图片格式转换.空图(2, 2, [0, 0, 0])
    图片格式转换.填充(图, [7, 8, 9])
    测试.相等(图片格式转换.取像素(图, 1, 1), [7, 8, 9])


函数 BMP_来回一致():
    # 宽 5 = **不是 4 的倍数**，BMP 每行要补齐到 4 字节，最容易写错的地方
    令 图 = 图片格式转换.空图(5, 3, [1, 2, 3])
    图片格式转换.设像素(图, 4, 2, [9, 8, 7])
    令 路 = _路径("宽5.bmp")
    图片格式转换.写(图, 路)
    令 回 = 图片格式转换.读(路)
    测试.相等(图片格式转换.尺寸(回), {"宽": 5, "高": 3})
    测试.相等(图片格式转换.取像素(回, 0, 0), [1, 2, 3], "左上要对（BMP 是自下而上存的）")
    测试.相等(图片格式转换.取像素(回, 4, 2), [9, 8, 7], "右下要对")


函数 PPM_来回一致():
    令 图 = 图片格式转换.空图(3, 2, [255, 0, 0])
    图片格式转换.设像素(图, 2, 1, [0, 255, 0])
    令 路 = _路径("小.ppm")
    图片格式转换.写(图, 路)
    令 回 = 图片格式转换.读(路)
    测试.相等(图片格式转换.取像素(回, 0, 0), [255, 0, 0])
    测试.相等(图片格式转换.取像素(回, 2, 1), [0, 255, 0])


函数 PNG_结构合法():
    """读不了 PNG（没实现 inflate），但**写出来的一定要合法**：
    签名 + 结尾的 IEND（它的 CRC 是固定的 `ae426082`）+ IHDR 里的尺寸对得上。"""
    令 图 = 图片格式转换.空图(7, 5, [3, 4, 5])
    令 路 = _路径("七乘五.png")
    图片格式转换.写(图, 路)
    令 数据 = 文件.读字节(路)
    测试.相等(编码.十六进制编码(数据[0:8]), "89504e470d0a1a0a", "PNG 签名不对")
    令 尾 = 数据[长度(数据) - 12:长度(数据)]
    测试.相等(编码.十六进制编码(尾), "0000000049454e44ae426082",
             "结尾该是 IEND 块（长度 0 + 类型 + 固定 CRC）")
    # IHDR 的宽高在签名之后 8 字节处、大端 4 字节
    令 宽 = 0
    令 高 = 0
    令 位 = 0
    当 位 < 4：
        宽 = 宽 * 256 + 数据[16 + 位]
        高 = 高 * 256 + 数据[20 + 位]
        位 = 位 + 1
    测试.相等(宽, 7, "IHDR 里的宽")
    测试.相等(高, 5, "IHDR 里的高")


函数 转换一步到位():
    令 源 = _路径("源.bmp")
    令 图 = 图片格式转换.空图(2, 2, [11, 22, 33])
    图片格式转换.写(图, 源)
    令 目标 = _路径("目标.ppm")
    图片格式转换.转(源, 目标)
    测试.为真(文件.文件存在(目标), "转换后该有目标文件")
    测试.相等(图片格式转换.取像素(图片格式转换.读(目标), 0, 0), [11, 22, 33])


# ⚠️ 匿名函数只能写**单表达式**（M24 的边界），所以这些「该报错的那一下」
#    都写成具名函数再传进去 —— 别硬凑成一行。
函数 _读PNG():
    图片格式转换.读(_路径("不许读.png"))


函数 _写TGA():
    图片格式转换.写(图片格式转换.空图(1, 1), _路径("图.tga"))


函数 _取越界像素():
    图片格式转换.取像素(图片格式转换.空图(2, 3), 5, 0)


函数 _零宽图():
    图片格式转换.空图(0, 5)


函数 PNG_读不了要说清楚():
    令 路 = _路径("不许读.png")
    图片格式转换.写(图片格式转换.空图(1, 1), 路)
    令 错 = 测试.抛出 (_读PNG)
    测试.包含(错.消息, "PNG 读不了", "该说清「能写不能读」，而不是一句「出错了」")
    测试.包含(错.消息, "inflate", "该说清缺的是什么能力")


函数 不认识的格式要说清():
    令 错 = 测试.抛出 (_写TGA)
    测试.包含(错.消息, "能写：bmp / ppm / png", "该告诉用户能写什么")


函数 越界说清范围():
    令 错 = 测试.抛出 (_取越界像素)
    测试.包含(错.消息, "2×3", "该报出图片实际尺寸")


函数 宽高不能为零():
    令 错 = 测试.抛出 (_零宽图)
    测试.包含(错.消息, "大于 0")


测试.用例("空图的尺寸与底色", 空图有尺寸和底色)
测试.用例("设像素只改那一个", 设像素只改那一个)
测试.用例("填充整张", 填充整张)
测试.用例("BMP 来回一致（宽不是 4 的倍数）", BMP_来回一致)
测试.用例("PPM 来回一致", PPM_来回一致)
测试.用例("PNG 结构合法", PNG_结构合法)
测试.用例("一步转换", 转换一步到位)
测试.用例("PNG 读不了要说清楚", PNG_读不了要说清楚)
测试.用例("不认识的格式要说清", 不认识的格式要说清)
测试.用例("越界要说清范围", 越界说清范围)
测试.用例("宽高不能为零", 宽高不能为零)

测试.汇总()
