# 备份归档器 —— 按日期打包产物、给清单签名、把日志压成 .gz
#
# ⚠️ 这是一个**绕道探针**（M109），不是教学示例。它是「时间 + 余项」
# （日期时间 / 加密 / 压缩）那一批的量尺：只用手上现有的标准库尽力写，
# 写不顺手的地方逐条记在本目录 README.md 的「绕道清单」里，
# 由 tools/detour_ledger.py 汇总成 docs/绕道台账.md。
#
# 用法（在探针目录里跑；样本/ 是准备好的输入）：
#     jishi 备份.jsh               # 用默认口令
#     jishi 备份.jsh 我的口令
#
# 它干的事：算日期（今天 / 加月 / 加年 / 解析 ISO）→ 打包 → 日志压成 .gz →
# 写清单（每条带 sha256）→ 给清单签名（HMAC）→ 存「盐 + 口令摘要」→
# 清理过期归档 → 把 .gz 解压回来验一遍。
#
# 对照：参考实现.py 用 Python 标准库（datetime / hashlib / hmac / gzip /
# zipfile / secrets）做同一件事。

导入 文件
导入 路径
导入 日期
导入 加密
导入 编码
导入 压缩
导入 文本 为 文本库  # 别名导入：模块「文本」会遮蔽内建 文本(...)，
        # 而 f-string 插值正是靠它把值转成文本（见 docs/语言规格.md）
导入 系统

令 源目录 = "样本"
令 归档目录 = "归档"
令 保留天数 = 30

函数 箱子路径(日)：
    返回 路径.连接(归档目录, "备份-" + 日 + ".zip")

函数 打包今天()：
    文件.创建目录(归档目录)
    令 箱子 = 箱子路径(日期.今天())
    压缩.打包(箱子, 源目录)
    返回 箱子

函数 压日志()：
    # zip 是「一箱多件」，日志要的是**单个文件**的压缩（.gz）：
    # 一个文件一个流，解压时不用先有 zip 目录表。
    令 全部 = ""
    遍历 名 在 路径.递归列出(源目录, ".log"):
        全部 = 全部 + 文件.读文本(路径.连接(源目录, 名))
    令 目标 = 路径.连接(归档目录, "日志.gz")
    压缩.压缩文件(目标, 全部)
    返回 [目标, 长度(全部)]

函数 清单文本(箱子)：
    令 行 = ["# 备份清单", "", "归档：" + 路径.文件名(箱子), ""]
    遍历 名 在 路径.递归列出(源目录):
        令 全 = 路径.连接(源目录, 名)
        行.追加(`- {名}  {路径.大小(全)} 字节  sha256 {加密.摘要(文件.读文本(全))}`)
    返回 文本库.拼接(行, "\n") + "\n"

函数 存口令(口令)：
    # 绝不存口令本身：存「盐 + 口令摘要」。盐必须是**不可预测**的，
    # 否则同一口令在不同机器上算出同一个摘要，一撞库就全暴露。
    令 盐 = 加密.安全随机字节(16)
    返回 文本库.拼接([
        "盐 " + 编码.十六进制编码(盐),  # 盐现在是字节，存成十六进制文本
        "口令摘要 " + 加密.口令摘要(口令, 盐, 1000),
    ], "\n") + "\n"

函数 清理旧归档()：
    令 最早 = 日期.减天数(保留天数, 日期.今天())
    令 删了 = 0
    遍历 名 在 路径.按模式找(归档目录, "备份-*.zip", 假):
        令 日 = 名[3:13]  # 备份-2026-10-12.zip → 2026-10-12
        如果 日期.早于(日, 最早):
            路径.删除(路径.连接(归档目录, 名))
            删了 = 删了 + 1
    返回 删了

函数 下次计划()：
    # 备份每月一次、年度复盘每年来一次 —— 都是「加一个月 / 加一年」，
    # 不是「加 30 天 / 加 365 天」（天数加法在月末会跑偏）。
    返回 [日期.加月(1, 日期.今天()), 日期.加年(1, 日期.今天())]

函数 日志跨度(日志内容)：
    # 日志第一行是 ISO 时间戳，算它离今天多少天。
    令 行 = 文本库.按行拆分(日志内容)
    如果 长度(行) == 0:
        返回 0
    令 日 = 日期.解析ISO(行[0])
    返回 日期.相差天数(日期.今天(), 日)

函数 看一份(箱子, 名字)：
    # 想「只看箱子里的一份文件」—— 现在只能整箱解开再删掉其余（见 R301）。
    返回 `（想单独取出 {名字}，见绕道 R301）`


函数 主程序(参数们)：
    令 口令 = "示例口令"
    如果 长度(参数们) > 0:
        口令 = 参数们[0]

    打印("=== 备份归档器 ===")

    令 箱子 = 打包今天()
    打印(`已打包 {路径.文件名(箱子)}（{路径.大小(箱子)} 字节）`)

    令 压结果 = 压日志()
    打印(`已压日志 日志.gz（原文 {压结果[1]} 字符）`)

    令 清单 = 清单文本(箱子)
    文件.写文本(路径.连接(归档目录, "清单.txt"), 清单)
    打印(`清单 {长度(清单)} 字符`)

    # 签名：清单被人改一个字符，HMAC 就对不上。
    打印(`签名 {加密.HMAC(口令, 清单, "sha256")}`)

    文件.写文本(路径.连接(归档目录, "口令.txt"), 存口令(口令))
    打印("已写 口令.txt（盐 + 口令摘要，不存口令本身）")

    打印(`清掉过期归档 {清理旧归档()} 份`)

    令 计划 = 下次计划()
    打印(`下次备份 {计划[0]} · 年度复盘 {计划[1]}`)

    令 回来 = 压缩.解压文件(路径.连接(归档目录, "日志.gz"))
    打印(`日志解压回来 {长度(回来)} 字符 · 时间跨度 {日志跨度(回来)} 天`)

    打印(看一份(箱子, "说明.md"))


主程序(系统.参数())
