# 记账本 —— 用现有标准库尽力写：账目存在一个 JSON 文件里
#
# ⚠️ 这是一个**绕道探针**（M105），不是教学示例。
# 它会跑、也真的能用，但每写一步都在撞「标准库不够用」的墙；
# 撞出来的每一处都记在本目录 README.md 的「绕道清单」里，
# 由 tools/detour_ledger.py 汇总成 docs/绕道台账.md。
#
# 对照：参考实现.py 用 Python 的 sqlite3 —— 行数更少，
# 而且数据量再大也不用「每次全量读进内存」。

导入 json
导入 文件
导入 文本
导入 系统
导入 时间

令 账本文件 = "账目.json"


函数 读账本():
    如果 非 文件.文件存在(账本文件):
        返回 []
    尝试:
        返回 json.读文件(账本文件)
    捕获 异常:
        返回 []


函数 存账本(账目们):
    # M108 起改用**原子写**（原绕道 R004 已消）：先写同目录临时文件、再改名，
    # 写一半崩了（或断电）也不会把整本账弄成半截。
    文件.原子写(账本文件, json.转文本(账目们, 2))


函数 记一笔(金额, 类别, 备注):
    令 账目们 = 读账本()
    账目们.追加({"金额": 金额, "类别": 类别, "备注": 备注, "日期": 时间.今天()})
    存账本(账目们)
    打印(文本.格式化("已记：{:.2f} 元 / {} / {}", 金额, 类别, 备注))


函数 按类别汇总(账目们):
    令 汇总 = {}
    遍历 账 在 账目们:
        令 类名 = 账["类别"]
        如果 汇总.包含(类名):
            汇总[类名] = 汇总[类名] + 账["金额"]
        否则:
            汇总[类名] = 账["金额"]
    返回 汇总


函数 查类别(账目们, 类别):
    令 结果 = []
    遍历 账 在 账目们:
        如果 账["类别"] == 类别:
            结果.追加(账)
    返回 结果


函数 列出账本():
    令 账目们 = 读账本()
    打印(文本.格式化("共 {} 笔", 长度(账目们)))
    打印(文本.左对齐("日期", 12) + 文本.左对齐("类别", 8)
         +文本.右对齐("金额", 10) + "  备注")
    遍历 账 在 账目们:
        打印(文本.左对齐(账["日期"], 12) + 文本.左对齐(账["类别"], 8)
             +文本.右对齐(文本.格式化("{:.2f}", 账["金额"]), 10)
             +"  " + 账["备注"])


函数 打印汇总():
    令 账目们 = 读账本()
    令 汇总 = 按类别汇总(账目们)
    打印(文本.左对齐("类别", 10) + 文本.右对齐("合计", 10))
    令 合计 = 0
    遍历 类名 在 汇总.键():
        令 额 = 汇总[类名]
        打印(文本.左对齐(类名, 10) + 文本.右对齐(文本.格式化("{:.2f}", 额), 10))
        合计 = 合计 + 额
    打印(文本.左对齐("合计", 10) + 文本.右对齐(文本.格式化("{:.2f}", 合计), 10))


函数 主程序():
    令 参数们 = 系统.参数()
    如果 长度(参数们) == 0:
        列出账本()
    否则如果 参数们[0] == "记":
        如果 长度(参数们) < 3:
            打印("用法：jishi 记账.jsh 记 <金额> <类别> [备注]")
        否则:
            令 备注 = 参数们[3] 如果 长度(参数们) > 3 否则 ""
            记一笔(小数(参数们[1]), 参数们[2], 备注)
    否则如果 参数们[0] == "汇总":
        打印汇总()
    否则如果 参数们[0] == "查":
        如果 长度(参数们) < 2:
            打印("用法：jishi 记账.jsh 查 <类别>")
        否则:
            令 结果 = 查类别(读账本(), 参数们[1])
            打印(文本.格式化("「{}」共 {} 笔", 参数们[1], 长度(结果)))
            遍历 账 在 结果:
                打印("  " + 账["日期"] + "  "
                     +文本.格式化("{:.2f}", 账["金额"]) + "  " + 账["备注"])
    否则如果 参数们[0] == "列出":
        列出账本()
    否则:
        打印("用法：jishi 记账.jsh [记 <金额> <类别> [备注] | 汇总 | 查 <类别> | 列出]")


主程序()
