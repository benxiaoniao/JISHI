# 记账本 —— 账目存在一个 SQLite 库里（M112 起）
#
# ⚠️ 这是一个**绕道探针**（M105），不是教学示例。
# 它会跑、也真的能用，每写一步都在撞「标准库不够用」的墙；
# 撞出来的每一处都记在本目录 README.md 的「绕道清单」里，
# 由 tools/detour_ledger.py 汇总成 docs/绕道台账.md。
#
# 📌 **M112 已消掉原来的两条绕道**（R001「按类别汇总要手写累加」、
#    R002「按类别查要全表扫」）：现在用 `数据库.汇总` / 带条件的 `查询`，
#    数据在库里、不用再整本读进内存，`读账本` / `存账本` 两个函数也没了。
#
# 对照：参考实现.py 用 Python 的 sqlite3 —— 现在两边都是 SQLite，
# 而且**用的是同一个 schema**（`id / 金额 / 类别 / 备注 / 日期`），
# 所以基石建的库，Python 那边能直接打开读写。

导入 数据库
导入 系统
导入 时间
导入 文本 为 文本库

令 账本文件 = "账目.db"
令 表名 = "账目"


函数 打开账本():
    # M112 起：一个 SQLite 文件就是一本账。`建表` / `建索引` 都是幂等的。
    令 库 = 数据库.打开(账本文件)
    数据库.建表(库, 表名, ["金额", "类别", "备注", "日期"])
    数据库.建索引(库, 表名, "类别")
    返回 库


函数 记一笔(库, 金额, 类别, 备注):
    数据库.插入(库, 表名, {"金额": 金额, "类别": 类别, "备注": 备注, "日期": 时间.今天()})
    打印(文本库.格式化("已记：{:.2f} 元 / {} / {}", 金额, 类别, 备注))


函数 列出账本(库):
    令 账目们 = 数据库.查询(库, 表名)
    打印(文本库.格式化("共 {} 笔", 长度(账目们)))
    打印(文本库.左对齐("日期", 12) + 文本库.左对齐("类别", 8)
         +文本库.右对齐("金额", 10) + "  备注")
    遍历 账 在 账目们:
        打印(文本库.左对齐(账["日期"], 12) + 文本库.左对齐(账["类别"], 8)
             +文本库.右对齐(文本库.格式化("{:.2f}", 账["金额"]), 10)
             +"  " + 账["备注"])


函数 打印汇总(库):
    # 原绕道 R001：以前要把整本账读进内存、手写「有就加、没有就置」。
    # 现在一句 `数据库.汇总` —— 而且与 `表格.分组汇总` 同形状。
    令 各类 = 数据库.汇总(库, 表名, "类别", "金额")
    打印(文本库.左对齐("类别", 10) + 文本库.右对齐("合计", 10))
    令 合计 = 0
    遍历 类名 在 各类:
        令 额 = 各类[类名]["总和"]
        打印(文本库.左对齐(类名, 10) + 文本库.右对齐(文本库.格式化("{:.2f}", 额), 10))
        合计 = 合计 + 额
    打印(文本库.左对齐("合计", 10) + 文本库.右对齐(文本库.格式化("{:.2f}", 合计), 10))


函数 查类别(库, 类别):
    # 原绕道 R002：以前要逐条比字符串（全表扫）。现在交给库里，而且上面建了索引。
    返回 数据库.查询(库, 表名, {"类别": 类别})


函数 主程序():
    令 参数们 = 系统.参数()
    令 库 = 打开账本()
    如果 长度(参数们) == 0:
        列出账本(库)
    否则如果 参数们[0] == "记":
        如果 长度(参数们) < 3:
            打印("用法：jishi 记账.jsh 记 <金额> <类别> [备注]")
        否则:
            令 备注 = 参数们[3] 如果 长度(参数们) > 3 否则 ""
            记一笔(库, 小数(参数们[1]), 参数们[2], 备注)
    否则如果 参数们[0] == "汇总":
        打印汇总(库)
    否则如果 参数们[0] == "查":
        如果 长度(参数们) < 2:
            打印("用法：jishi 记账.jsh 查 <类别>")
        否则:
            令 结果 = 查类别(库, 参数们[1])
            打印(文本库.格式化("「{}」共 {} 笔", 参数们[1], 长度(结果)))
            遍历 账 在 结果:
                打印("  " + 账["日期"] + "  "
                     +文本库.格式化("{:.2f}", 账["金额"]) + "  " + 账["备注"])
    否则如果 参数们[0] == "列出":
        列出账本(库)
    否则:
        打印("用法：jishi 记账.jsh [记 <金额> <类别> [备注] | 汇总 | 查 <类别> | 列出]")
    数据库.关闭(库)


主程序()
