# 批量摘要 —— 对一批文件逐个算 SHA256
#
# ⚠️ 绕道探针（M105）。这里真正撞的是：**没有并发**。
# 一个个算当然是对的，但一批几千个文件就只能一个接一个排队；
# Python 参考实现用 ThreadPoolExecutor 同时算，同样的活快好几倍。
#
# 对照：参考实现.py

导入 加密
导入 路径
导入 文本
导入 时间
导入 系统


函数 逐个摘要(文件们):
    令 结果 = {}
    遍历 f 在 文件们:
        结果[f] = 加密.文件摘要(f)
    返回 结果


函数 主程序():
    令 参数们 = 系统.参数()
    如果 长度(参数们) == 0:
        打印("用法：jishi 批量.jsh <目录> [后缀]")
    否则如果 非 路径.是目录(参数们[0]):
        打印(文本.格式化("「{}」不是目录", 参数们[0]))
    否则:
        令 目录 = 参数们[0]
        令 后缀 = 参数们[1] 如果 长度(参数们) > 1 否则 ""
        令 相对们 = 路径.递归列出(目录, 后缀)
        令 文件们 = [路径.连接(目录, f) 遍历 f 在 相对们]
        打印(文本.格式化("共 {} 个文件，逐个算摘要…", 长度(文件们)))
        令 开始 = 时间.高精度时间()
        令 结果 = 逐个摘要(文件们)
        令 用时 = 时间.高精度时间() - 开始
        打印(文本.格式化("逐个处理用了 {:.3f} 秒", 用时))
        遍历 f 在 文件们:
            打印("  " + 路径.文件名(f) + "  " + 结果[f][:16])
        打印()
        打印("（想同时算？没有线程 / 进程 / 异步 —— 见绕道 R005）")


主程序()
