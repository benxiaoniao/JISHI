# 批量摘要 —— 对一批文件逐个算 SHA256
#
# ⚠️ 绕道探针（M105）。这里当初撞的是：**没有并发** —— 一批几千个文件
# 只能一个接一个排队；Python 参考实现用 ThreadPoolExecutor 同时算，快好几倍。
#
# **M114 已解决**：`并发.批量摘要(路径们)` 把一批文件的摘要同时算出来。
# 这个探针现在两档都跑，把「到底快多少」**量出来**（不声称）。
#
# 对照：参考实现.py（同一件事用 Python 标准库做）

导入 并发
导入 加密
导入 路径
导入 文本
导入 时间
导入 系统


函数 逐个摘要(文件们):
    令 结果 = []
    遍历 f 在 文件们:
        结果.追加(加密.文件摘要(f))
    返回 结果


函数 并发摘要(文件们):
    # M114：一条调用，宿主里用线程池同时读 + 算；**结果顺序与输入一致**
    返回 并发.批量摘要(文件们)


函数 主程序():
    令 参数们 = 系统.参数()
    如果 长度(参数们) == 0:
        打印("用法：jishi 批量.jsh <目录> [后缀]")
    否则如果 非 路径.是目录(参数们[0]):
        打印(文本.格式化("「{}」不是目录", 参数们[0]))
    否则:
        令 目录 = 参数们[0]
        令 后缀 = 参数们[1] 如果 长度(参数们) > 1 否则 ""
        令 相对们 = 路径.递归列出(目录, 后缀)
        令 文件们 = [路径.连接(目录, f) 遍历 f 在 相对们]
        打印(文本.格式化("共 {} 个文件。", 长度(文件们)))

        令 起 = 时间.高精度时间()
        令 甲 = 逐个摘要(文件们)
        令 顺序用时 = 时间.高精度时间() - 起

        令 起 = 时间.高精度时间()
        令 乙 = 并发摘要(文件们)
        令 并发用时 = 时间.高精度时间() - 起

        打印(文本.格式化("顺序 {:.3f} 秒 / 并发 {:.3f} 秒", 顺序用时, 并发用时))
        如果 长度(文件们) > 0 与 并发用时 > 0:
            打印(文本.格式化("加速 {:.2f} 倍", 顺序用时 / 并发用时))
        # ⚠️ **这一行是 M114 的要害**：并发没改语义，只是快
        打印(文本.格式化("两档结果一致：{}", 甲 == 乙))

        遍历 i 在 范围(长度(文件们)):
            打印("  " + 路径.文件名(文件们[i]) + "  " + 甲[i][:16])
        打印()
        打印("（小文件批量划算；大文件、纯计算反而更慢 —— 见 README）")


主程序()
