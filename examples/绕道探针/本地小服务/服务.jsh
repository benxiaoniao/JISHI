# 本地小服务 —— 给「待办清单」一个**能点**的网页界面
#
# ⚠️ 绕道探针（M105）。这里当初撞得最狠：**语言完全没有「服务端」能力**
# —— 没有 socket、也没有 HTTP 服务端，只能生成一张静态页让用户自己刷新。
#
# **M115 已解决**：`HTTP服务端.启动(端口, 处理函数, 最多请求数)` 起一个只监听
# 本机的小服务，每个请求调一次你的处理函数 —— 页面上的表单现在**真能提交**。
#
# 对照：参考实现.py（同一件事用 Python 的 http.server 做）
#
# 用法：
#   jishi 服务.jsh                 # 只打用法（**不阻塞** —— 判据会自动跑它）
#   jishi 服务.jsh 0               # 自动挑一个空闲端口，一直跑（Ctrl-C 停）
#   jishi 服务.jsh 8000            # 指定端口，一直跑
#   jishi 服务.jsh 8000 3          # 处理 3 个请求就**干净退出**（判据用这个）

导入 HTTP服务端
导入 html
导入 json
导入 文件
导入 文本
导入 系统

令 待办文件 = "待办.json"
令 默认待办 = ["买菜", "写周报", "给猫铲屎"]


函数 读待办():
    如果 非 文件.文件存在(待办文件):
        返回 默认待办
    尝试:
        返回 json.读文件(待办文件)
    捕获 异常:
        返回 默认待办


函数 写待办(们):
    文件.写文本(待办文件, json.转文本(们))


函数 查一位(查询, 名字, 缺省):
    # 字典里没这个键就返回缺省（`查询["x"]` 直接取会报「键错误」）
    如果 名字 在 查询:
        返回 查询[名字]
    返回 缺省


函数 页面(待办们):
    令 项们 = []
    遍历 i 在 范围(长度(待办们)):
        令 删 = html.标签("a", "删", {"href": 文本.格式化("/删?id={}", i)})
        项们.追加(html.标签("li", 待办们[i] + " " + 删))
    令 表单 = html.标签("form",
        html.空元素("input", {"name": "名字"})
        +html.标签("button", "加上", {"type": "submit"}),
        {"action": "/加", "method": "get"})
    返回 ("<!doctype html>\n<html>\n"
        +html.空元素("meta", {"charset": "utf-8"})
        +"\n<title>待办</title>\n"
        +html.标签("h1", "待办清单")
        +html.无序列表(待办们)
        +表单
        +"\n</html>\n")


函数 加一条(名字):
    如果 名字 == "":
        返回 假
    令 待办们 = 读待办()
    # 去重：这条走 GET、浏览器刷新会重发，重复加就不是「刷新」是「加两遍」
    如果 名字 在 待办们:
        返回 假
    待办们.追加(名字)
    写待办(待办们)
    返回 真


函数 删一条(编号):
    令 旧 = 读待办()
    如果 编号 < 0 或 编号 >= 长度(旧):
        返回 假
    令 新 = []
    遍历 j 在 范围(长度(旧)):
        如果 j != 编号:
            新.追加(旧[j])
    写待办(新)
    返回 真


函数 处理(请求):
    令 路径 = 请求["路径"]
    令 查询 = 请求["查询"]
    如果 请求["方法"] == "GET" 与 路径 == "/":
        返回 {"正文": 页面(读待办()), "内容类型": "text/html; charset=utf-8"}
    如果 请求["方法"] == "GET" 与 路径 == "/加":
        加一条(查一位(查询, "名字", ""))
        # 303 = 「去看那个地址」—— 浏览器会跟着跳到首页
        返回 {"状态": 303, "头": {"Location": "/"}}
    如果 请求["方法"] == "GET" 与 路径 == "/删":
        令 编号 = 查一位(查询, "id", "")
        如果 编号 != "":
            删一条(整数(编号))
        返回 {"状态": 303, "头": {"Location": "/"}}
    返回 {"状态": 404, "正文": "没有这一页：" + 路径}


函数 主程序():
    令 参数们 = 系统.参数()
    # ⚠️ **无参只打用法就退出** —— 不能「没参数也硬起服务」：
    #    探针会被 check_engines / conformance / 测试自动跑一遍，
    #    那样会**一直阻塞**把判据挂死（以前这版是「生成静态页」所以没事）。
    如果 长度(参数们) == 0:
        打印("用法：jishi 服务.jsh <端口> [最多请求数]")
        打印("  端口写 0 = 自动挑一个空闲端口；最多请求数省略 = 一直跑")
        返回
    令 给定 = 整数(参数们[0])
    令 端口 = HTTP服务端.空闲端口() 如果 给定 == 0 否则 给定
    令 上限 = 整数(参数们[1]) 如果 长度(参数们) > 1 否则 0
    打印(文本.格式化("待办服务起来了：http://127.0.0.1:{}/", 端口))
    打印("（只在**本机**能访问 —— 局域网里的手机连不上，这是安全默认）")
    令 结果 = HTTP服务端.启动(端口, 处理, 上限)
    打印(文本.格式化("处理了 {} 个请求", 结果["请求数"]))


主程序()
