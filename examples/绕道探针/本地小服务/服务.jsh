# 本地小服务 —— 给「待办清单」加一个网页界面（的**近似品**）
#
# ⚠️ 绕道探针（M105）。这里撞得最狠：**语言完全没有「服务端」能力**
# —— 没有 socket，也没有 HTTP 服务端。所以下面写的不是服务，是**静态页**：
# 生成一次、用户自己打开、看完自己刷新；点不动、改不了、收不到任何请求。
#
# 对照：参考实现.py 用 http.server 起一个真服务，浏览器里点一下就能增删待办。

导入 html
导入 文件
导入 json
导入 文本
导入 系统

令 待办文件 = "待办.json"
令 页面文件 = "待办.html"
令 默认待办 = ["买菜", "写周报", "给猫铲屎"]


函数 读待办():
    如果 非 文件.文件存在(待办文件):
        返回 默认待办
    尝试:
        返回 json.读文件(待办文件)
    捕获 异常:
        返回 默认待办


函数 生成页面(待办们):
    返回 ("<!doctype html>\n<html>\n"
         +html.空元素("meta", {"charset": "utf-8"})
         +"\n<title>待办</title>\n"
         +html.标签("h1", "待办清单")
         +html.无序列表(待办们)
         +"\n</html>\n")


函数 主程序():
    令 待办们 = 读待办()
    文件.写文本(页面文件, 生成页面(待办们))
    打印(文本.格式化("已生成 {}，共 {} 条", 页面文件, 长度(待办们)))
    打印("页面里改不了内容，改完还得重新跑一遍（见绕道 R006）")
    # 生成完自动打开 —— M108 起一行 `系统.打开`（原绕道 R007 已消）。
    # 无图形界面（CI / 测试）里别弹窗，留个开关。
    如果 系统.环境变量("服务_自动打开", "") == "1":
        系统.打开(页面文件)
    否则:
        打印("（设 服务_自动打开=1 会自动打开页面）")


主程序()
