{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "jishi",
	"scopeName": "source.jishi",
	"fileTypes": ["jsh"],
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#numbers" },
		{ "include": "#classdef" },
		{ "include": "#funcdef" },
		{ "include": "#builtins" },
		{ "include": "#methods" },
		{ "include": "#keywords" },
		{ "include": "#operators" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.block.jishi",
					"begin": "#-",
					"end": "-#"
				},
				{
					"name": "comment.line.number-sign.jishi",
					"match": "#.*$"
				}
			]
		},
		"strings": {
			"patterns": [
				{ "include": "#string-double" },
				{ "include": "#string-single" },
				{ "include": "#string-cjk-double" },
				{ "include": "#string-cjk-corner" },
				{ "include": "#string-cjk-corner-heavy" }
			]
		},
		"string-double": {
			"name": "string.quoted.double.jishi",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{ "name": "constant.character.escape.jishi", "match": "\\\\." }
			]
		},
		"string-single": {
			"name": "string.quoted.single.jishi",
			"begin": "'",
			"end": "'",
			"patterns": [
				{ "name": "constant.character.escape.jishi", "match": "\\\\." }
			]
		},
		"string-cjk-double": {
			"name": "string.quoted.double.jishi",
			"begin": "“",
			"end": "”"
		},
		"string-cjk-corner": {
			"name": "string.quoted.jishi",
			"begin": "「",
			"end": "」"
		},
		"string-cjk-corner-heavy": {
			"name": "string.quoted.jishi",
			"begin": "『",
			"end": "』"
		},
		"numbers": {
			"name": "constant.numeric.jishi",
			"match": "\\b(?:0[xX][0-9a-fA-F]+|\\d+\\.\\d+[eE][+-]?\\d+|\\d+\\.\\d+|\\d+)\\b"
		},
		"classdef": {
			"comment": "类 名字[ 继承 基类]: 定义行（begin 到行尾）",
			"name": "meta.class.jishi",
			"begin": "^\\s*(?=类\\s)",
			"end": "$",
			"patterns": [
				{
					"name": "keyword.control.jishi",
					"match": "类|继承"
				},
				{
					"name": "entity.name.class.jishi",
					"match": "(?<![\\u4e00-\\u9fffA-Za-z0-9_])[\\u4e00-\\u9fffA-Za-z0-9_]+(?=[：:]|\\s*继承)"
				}
			]
		},
		"funcdef": {
			"comment": "函数 名字(参数): 定义行（begin 到行尾）",
			"name": "meta.function.jishi",
			"begin": "^\\s*(?=函数\\s)",
			"end": "$",
			"patterns": [
				{
					"name": "keyword.control.jishi",
					"match": "函数"
				},
				{
					"name": "entity.name.function.jishi",
					"match": "(?<=函数\\s)[\\u4e00-\\u9fffA-Za-z0-9_]+(?=\\s*\\()"
				}
			]
		},
		"methods": {
			"comment": "方法调用：实例.方法(...)",
			"name": "support.function.method.jishi",
			"match": "(?<=\\.)[\\u4e00-\\u9fffA-Za-z_][\\u4e00-\\u9fffA-Za-z0-9_]*(?=\\s*\\()"
		},
		"builtins": {
			"comment": "内建函数名（须在 generic 调用前，否则被抢）",
			"name": "support.function.builtin.jishi",
			"match": "(?<![\u4e00-\u9fffA-Za-z0-9_.])(?:打印|输入|整数|小数|文本|长度|范围|最大|最小|总和|类型|反转|非|类型名|转换)(?=\\s*\\()"
		},
		"keywords": {
			"patterns": [
				{
					"comment": "控制流与结构关键字",
					"name": "keyword.control.jishi",
					"match": "(?<![\u4e00-\u9fffA-Za-z0-9_])(?:令|如果|否则如果|否则|遍历|循环|当|中断|继续|函数|返回|导入|尝试|捕获|最终|抛出|类|继承|新建|次)(?![\u4e00-\u9fffA-Za-z0-9_])"
				},
				{
					"comment": "助词：在/从/为",
					"name": "keyword.operator.assist.jishi",
					"match": "(?<![\u4e00-\u9fffA-Za-z0-9_])(?:在|从|为)(?![\u4e00-\u9fffA-Za-z0-9_])"
				},
				{
					"comment": "布尔字面量",
					"name": "constant.language.jishi",
					"match": "(?<![\u4e00-\u9fffA-Za-z0-9_])(?:真|假|空)(?![\u4e00-\u9fffA-Za-z0-9_])"
				},
				{
					"comment": "逻辑运算符",
					"name": "keyword.operator.logical.jishi",
					"match": "(?<![\u4e00-\u9fffA-Za-z0-9_])(?:与|或|非)(?![\u4e00-\u9fffA-Za-z0-9_])"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"comment": "算术/比较/赋值运算符",
					"name": "keyword.operator.jishi",
					"match": "\\*\\*=|//=|\\*\\*|//|==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|=|\\+|\\-|\\*|/|%|<|>|!"
				}
			]
		}
	}
}
