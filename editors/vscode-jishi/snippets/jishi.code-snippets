{
	"如果语句": {
		"prefix": "如果",
		"body": [
			"如果 ${1:条件}：",
			"\t${2:打印(\"${3}\")}",
			"$0"
		],
		"description": "如果（if）语句"
	},
	"否则": {
		"prefix": "否则",
		"body": [
			"否则：",
			"\t$0"
		],
		"description": "否则（else）分支"
	},
	"遍历循环": {
		"prefix": "遍历",
		"body": [
			"遍历 ${1:元素} 在 ${2:列表}：",
			"\t$0"
		],
		"description": "遍历（for-in）循环"
	},
	"固定次数循环": {
		"prefix": "循环",
		"body": [
			"循环 ${1:10} 次：",
			"\t$0"
		],
		"description": "循环 N 次"
	},
	"当循环": {
		"prefix": "当",
		"body": [
			"当 ${1:条件}：",
			"\t$0"
		],
		"description": "当（while）循环"
	},
	"定义函数": {
		"prefix": "函数",
		"body": [
			"函数 ${1:名称}(${2:参数})：",
			"\t$0"
		],
		"description": "定义函数"
	},
	"定义类": {
		"prefix": "类",
		"body": [
			"类 ${1:名称}：",
			"\t函数 初始化(自身${2:, 参数})：",
			"\t\t$0"
		],
		"description": "定义类（含构造方法）"
	},
	"继承类": {
		"prefix": "继承",
		"body": [
			"类 ${1:子类} 继承 ${2:基类}：",
			"\t$0"
		],
		"description": "继承基类"
	},
	"新建对象": {
		"prefix": "新建",
		"body": "新建 ${1:类名}(${2:参数})",
		"description": "新建对象（调用构造方法）"
	},
	"异常处理": {
		"prefix": "尝试",
		"body": [
			"尝试：",
			"\t$1",
			"捕获 ${2:值错误} 为 ${3:e}：",
			"\t打印(${3:e}.消息)",
			"$0"
		],
		"description": "尝试/捕获（异常处理）"
	},
	"抛出异常": {
		"prefix": "抛出",
		"body": "抛出 ${1:值错误}(\"${2:错误说明}\")",
		"description": "抛出异常"
	},
	"你好世界": {
		"prefix": "你好",
		"body": "打印(\"你好，世界！\")",
		"description": "你好世界"
	},
	"打印": {
		"prefix": "打印",
		"body": "打印(${1:值})",
		"description": "打印输出"
