{
  "如果语句": {
    "prefix": "如果",
    "body": [
      "如果 ${1:条件}：",
      "\t${2:打印(\"${3}\")}",
      "$0"
    ],
    "description": "如果（if）语句"
  },
  "否则": {
    "prefix": "否则",
    "body": [
      "否则：",
      "\t$0"
    ],
    "description": "否则（else）分支"
  },
  "遍历循环": {
    "prefix": "遍历",
    "body": [
      "遍历 ${1:元素} 在 ${2:列表}：",
      "\t$0"
    ],
    "description": "遍历（for-in）循环"
  },
  "固定次数循环": {
    "prefix": "循环",
    "body": [
      "循环 ${1:10} 次：",
      "\t$0"
    ],
    "description": "循环 N 次"
  },
  "当循环": {
    "prefix": "当",
    "body": [
      "当 ${1:条件}：",
      "\t$0"
    ],
    "description": "当（while）循环"
  },
  "定义函数": {
    "prefix": "函数",
    "body": [
      "函数 ${1:名称}(${2:参数})：",
      "\t$0"
    ],
    "description": "定义函数"
  },
  "定义类": {
    "prefix": "类",
    "body": [
      "类 ${1:名称}：",
      "\t函数 初始化(自身${2:, 参数})：",
      "\t\t$0"
    ],
    "description": "定义类（含构造方法）"
  },
  "继承类": {
    "prefix": "继承",
    "body": [
      "类 ${1:子类} 继承 ${2:基类}：",
      "\t$0"
    ],
    "description": "继承基类"
  },
  "新建对象": {
    "prefix": "新建",
    "body": "令 ${1:对象} = 新建 ${2:类名}(${3:参数})",
    "description": "新建对象（调用构造方法）"
  },
  "异常处理": {
    "prefix": "尝试",
    "body": [
      "尝试：",
      "\t$1",
      "捕获 ${2:值错误} 为 ${3:e}：",
      "\t打印(${3:e}.消息)",
      "$0"
    ],
    "description": "尝试/捕获（异常处理）"
  },
  "抛出异常": {
    "prefix": "抛出",
    "body": "抛出 ${1:值错误}(\"${2:错误说明}\")",
    "description": "抛出异常"
  },
  "你好世界": {
    "prefix": "你好",
    "body": "打印(\"你好，世界！\")",
    "description": "你好世界"
  },
  "打印": {
    "prefix": "打印",
    "body": "打印(${1:值})",
    "description": "打印输出"
  },
  "导入模块": {
    "prefix": "导入",
    "body": "导入 ${1:容器}",
    "description": "导入标准库模块（容器 / 迭代 / 参数 / 日志 / 测试 …）"
  },
  "遍历解包": {
    "prefix": "遍历解包",
    "body": [
      "遍历 ${1:名字}, ${2:年龄} 在 ${3:对们}：",
      "\t$0"
    ],
    "description": "遍历并解包（M41 起支持一次取多个）"
  },
  "带下标遍历": {
    "prefix": "带下标",
    "body": [
      "遍历 ${1:序}, ${2:项} 在 带下标(${3:列表}, 1)：",
      "\t$0"
    ],
    "description": "带序号遍历（序号从 1 开始；不写第二个参数就从 0 开始）"
  },
  "模式匹配": {
    "prefix": "匹配",
    "body": [
      "匹配 ${1:值}：",
      "\t情形 ${2:一}：",
      "\t\t$0",
      "\t情形 ${3:二}：",
      "\t\t"
    ],
    "description": "模式匹配（M34）"
  },
  "用上下文": {
    "prefix": "用",
    "body": [
      "用 打开(\"${1:数据.txt}\") 为 文件：",
      "\t遍历 ${2:行} 在 文件：",
      "\t\t$0"
    ],
    "description": "用 … 为 …（离开块时自动关闭；文件本身可按行遍历）"
  },
  "插值文本": {
    "prefix": "插值",
    "body": "打印(`${1:你好}，{${2:名字}}！`)",
    "description": "插值文本（反引号里的 {表达式} 会被求值）"
  },
  "列表推导式": {
    "prefix": "推导",
    "body": "[${1:x} 遍历 ${1:x} 在 ${2:列表}]",
    "description": "列表推导式"
  },
  "用计时器": {
    "prefix": "计时",
    "body": [
      "用 时间.计时(\"${1:这段}\") 为 ${2:t}：",
      "\t${3:令 和 = 0}",
      "$0"
    ],
    "description": "用时间计时器（离开块时打印耗时）"
  },
  "读配置": {
    "prefix": "读配置",
    "body": [
      "导入 配置",
      "令 ${1:配置项} = 配置.读JSON(\"${2:配置.json}\", {})",
      "令 ${3:值} = 配置.取(${1:配置项}, \"${4:数据库.端口}\", ${5:0})",
      "$0"
    ],
    "description": "读JSON配置并按点号路径取值（M50）"
  },
  "统计摘要": {
    "prefix": "统计",
    "body": [
      "导入 统计",
      "打印(`平均 {统计.平均(${1:数据})}，中位数 {统计.中位数(${1:数据})}，标准差 {统计.标准差(${1:数据})}`)",
      "$0"
    ],
    "description": "一组数据的平均/中位数/标准差（M50）"
  }
}
